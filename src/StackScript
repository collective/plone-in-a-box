#!/usr/bin/python3
"""The Plone in a Box control panel's answers to its page (plone-panel).

nginx asks for the login and passes /api/ here. This runs as the
plone-panel user, which can do nothing on the server itself: it asks
"plone-panel helper" (root, through a socket only plone-panel can open) for
the status, to press one of the buttons, or whether a job is still running.
Started by systemd when the page first asks, and stops after 15 minutes
without questions.
"""
import json
import os
import re
import socket
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

HELPER = "/run/plone-panel/helper.sock"
ORIGIN = os.environ.get("PANEL_ORIGIN", "")
ACTIONS = {"backup", "restore-test", "test-notification", "test-email", "logs-off", "graphs-off", "demo-password"}
JOBS = {"backup", "restore-test"}
IDLE_SECONDS = 15 * 60
last_request = time.monotonic()


def helper(line, timeout=240):
    """Asks the root helper; it answers with its exit code, a newline, and text."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(timeout)
        s.connect(HELPER)
        s.sendall(line.encode() + b"\n")
        s.shutdown(socket.SHUT_WR)
        out = b""
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            out += chunk
    code, _, text = out.decode(errors="replace").partition("\n")
    try:
        return int(code), text
    except ValueError:
        return 1, text or "No answer from the server"


class Handler(BaseHTTPRequestHandler):
    server_version = "plone-panel"
    sys_version = ""

    def reply(self, status, body):
        data = body if isinstance(body, bytes) else json.dumps(body).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        global last_request
        last_request = time.monotonic()
        if self.path == "/api/status":
            code, text = helper("status")
            if code:
                return self.reply(502, {"error": text.strip() or "plone-status failed"})
            return self.reply(200, text.encode())
        m = re.fullmatch(r"/api/job/([a-z-]+)", self.path)
        if m and m.group(1) in JOBS:
            code, text = helper("job " + m.group(1), timeout=20)
            state, _, result = text.strip().partition(" ")
            return self.reply(200, {"state": state, "result": result})
        self.reply(404, {"error": "Not found"})

    def do_POST(self):
        global last_request
        last_request = time.monotonic()
        # Only the panel's own page may press the buttons: a browser adds
        # neither this header nor this Origin to a request from another site.
        if self.headers.get("X-Plone-Panel") != "1" or (ORIGIN and self.headers.get("Origin") != ORIGIN):
            return self.reply(403, {"ok": False, "message": "Only the control panel's own page can do that."})
        m = re.fullmatch(r"/api/do/([a-z-]+)", self.path)
        if not m or m.group(1) not in ACTIONS:
            return self.reply(404, {"ok": False, "message": "Not something the control panel can do."})
        code, text = helper("do " + m.group(1))
        status = 200 if code == 0 else 429 if code == 4 else 500  # 4: pressed again too soon
        self.reply(status, {"ok": code == 0, "message": text.strip()})

    def log_message(self, fmt, *args):
        pass  # nginx logs the requests


def main():
    if os.environ.get("LISTEN_FDS") == "1":  # from systemd (plone-panel.socket)
        server = ThreadingHTTPServer(("127.0.0.1", 0), Handler, bind_and_activate=False)
        server.socket.close()
        server.socket = socket.socket(fileno=3)
    else:
        server = ThreadingHTTPServer(("127.0.0.1", 8092), Handler)
    server.daemon_threads = True

    def stop_when_idle():
        while time.monotonic() - last_request < IDLE_SECONDS:
            time.sleep(30)
        server.shutdown()

    threading.Thread(target=stop_when_idle, daemon=True).start()
