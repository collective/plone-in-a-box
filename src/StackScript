# Security notices: sudo plone-security-notices, and every day through
# plone-security-notices.timer. New posts in the Security category of the Plone
# forum (security fixes and their pre-announcements) go to the notification
# URL, the address for reports and the login message, each post once.
cat > /usr/local/bin/plone-security-notices <<'PLONE_NOTICES_EOF'
#!/bin/bash
# Pass on new posts in the Plone forum's Security category, each once. The
# first run only notes the newest. Also run daily by plone-security-notices.timer.
# When a fix is released and automatic updates are on, install it the same day
# with plone-update, and if its images aren't out yet, try again every day for
# a week.
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-security-notices" >&2; exit 1; }
FEED=${PLONE_SECURITY_FEED:-https://community.plone.org/c/announcements/security/37.json}
FORUM=${FEED%%/c/*}
APP_DIR=/opt/plone
STATE_DIR=/var/lib/plone-in-a-box
SEEN="$STATE_DIR/security-seen"
LOG_FILE=/var/log/plone-security-notices.log
mkdir -p "$STATE_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
SITE_URL=$(cat "$STATE_DIR/site-url" 2>/dev/null || hostname)
UNTIL="$STATE_DIR/security-update-until"
auto_updates() { systemctl is-enabled --quiet plone-update.timer 2>/dev/null; }
# Run plone-update once per run (it reports by itself when it installs
# something), and keep the summary it left for the login message in
# UPDATE_RESULT. (Called directly, not in $(...), so the log lines go to the
# log and the result is kept.)
UPDATE_RESULT=""
run_update() {
  [[ -z "$UPDATE_RESULT" ]] || return 0
  say "Running plone-update for the security fix"
  /usr/local/bin/plone-update >/dev/null 2>&1 </dev/null
  UPDATE_RESULT=$(sed -E 's/^[0-9-]+ [0-9:]+  //' "$STATE_DIR/update-status" 2>/dev/null)
  UPDATE_RESULT=${UPDATE_RESULT:-no result}
  say "plone-update: $UPDATE_RESULT"
}

# A fix announced in the last week whose images weren't out yet: try again.
if [[ -s "$UNTIL" ]]; then
  if (( $(date +%s) > $(cat "$UNTIL") )) || ! auto_updates; then
    rm -f "$UNTIL"
  else
    run_update
    if [[ "$UPDATE_RESULT" == Updated:* ]]; then
      say "The security fix is installed"
      rm -f "$UNTIL"
    fi
  fi
fi

if ! json=$(curl -fsS -m 30 --retry 3 -H 'Accept: application/json' "$FEED"); then
  say "Could not read $FEED; the next check is tomorrow"
  exit 0
fi
seen=$(cat "$SEEN" 2>/dev/null || true)
[[ "$seen" =~ ^[0-9]+$ ]] || seen=""
# New posts as "id<TAB>date<TAB>title", oldest first; with nothing seen, the newest id.
if ! posts=$(python3 -c '
import json, re, sys
seen = sys.argv[1]
topics = [t for t in json.load(sys.stdin)["topic_list"]["topics"]
          if not re.fullmatch(r"About the .* category", t["title"])]
topics.sort(key=lambda t: t["id"])
if not seen:
    print(topics[-1]["id"] if topics else 0)
    sys.exit()
for t in topics:
    if t["id"] > int(seen):
        title = re.sub(r"[\x00-\x1f\x7f]", " ", t["title"])[:200]
        print(t["id"], (t.get("created_at") or "")[:10], title, sep="\t")
' "$seen" <<<"$json"); then
  say "Unexpected answer from $FEED; the next check is tomorrow"
  exit 0
fi
if [[ -z "$seen" ]]; then
  printf '%s\n' "$posts" > "$SEEN"
  say "Watching the Plone forum's Security category from post ${posts} on"
  exit 0
fi
if [[ -z "$posts" ]]; then
  say "No new security posts"
  exit 0
fi

count=$(grep -c . <<<"$posts")
(( count > 3 )) && say "$count new security posts; sending the newest 3"
posts=$(tail -n 3 <<<"$posts")
# A released fix (not a pre-announcement) among them: install it now.
fix_outcome=""
if cut -f3 <<<"$posts" | grep -qviE 'pre-?announce'; then
  if ! auto_updates; then
    fix_outcome="Automatic updates are off on this server, so install the fix yourself with: sudo plone-update."
  else
    run_update
    result=$UPDATE_RESULT
    case "$result" in
      Updated:*)
        rm -f "$UNTIL"
        fix_outcome="This server installed it right away. ${result}." ;;
      "Update failed"*)
        fix_outcome="This server tried to install it right away, but the update failed and was undone (${result}). The log is in /var/log/plone-update.log." ;;
      *)
        echo $(( $(date +%s) + 7 * 86400 )) > "$UNTIL"
        fix_outcome="This server found no new Plone images with the fix yet (${result}). It checks again every day for a week and installs them as soon as they appear; the update report tells you when." ;;
    esac
  fi
fi
notice=""
while IFS=$'\t' read -r id date title; do
  link="$FORUM/t/$id"
  if [[ "${title,,}" =~ pre-?announce ]]; then
    if auto_updates; then
      advice="A fix is coming; the post says when. This server installs it within a day of its release."
    else
      advice="A fix is coming; the post says when. Automatic updates are off on this server, so run sudo plone-update on that day."
    fi
  else
    advice="$fix_outcome If the post asks for more than installing the fix (a hotfix package, or a change to make), do that too."
  fi
  subject="Plone security notice: ${title} (${SITE_URL})"
  body=$(printf '%s\n\n%s (%s)\n%s\n\n%s\n\nFrom the Plone forum. Turn these notices off: sudo systemctl disable --now plone-security-notices.timer' \
    "$SITE_URL" "$title" "$date" "$link" "$advice")
  say "New: $title ($link)"
  /usr/local/lib/plone-in-a-box/notify "$subject" "$body" </dev/null
  case $? in
    0) say "Sent it to the notification URL" ;;
    3) ;;
    *) say "Sending it to the notification URL failed" ;;
  esac
  if [[ -f "$APP_DIR/send_mail.py" ]]; then
    out=$(docker compose --project-directory "$APP_DIR" run --rm --no-deps -T -e ADDONS= \
      -e MAIL_SUBJECT="$subject" -e MAIL_BODY="$body" -e MAIL_TO="$(cat "$STATE_DIR/report-email" 2>/dev/null)" \
      -v "$APP_DIR/send_mail.py:/app/scripts/send_mail.py:ro" backend run /app/scripts/send_mail.py 2>&1 </dev/null)
    case "$out" in
      *MAIL_SENT*) say "Emailed it" ;;
      *NO_MAIL_SETTINGS*) ;;
      *) say "Emailing it failed:"; tail -3 <<<"$out" ;;
    esac
  fi
  notice+=$(printf 'Plone security notice, %s: %s\n  %s' "$date" "$title" "$link")$'\n'
done <<<"$posts"
printf '%s' "$notice" > "$STATE_DIR/security-notice"
tail -n 1 <<<"$posts" | cut -f1 > "$SEEN"
