    -e MAIL_SUBJECT="$1" -e MAIL_BODY="$2" -e MAIL_TO="$(cat /var/lib/plone-in-a-box/report-email 2>/dev/null)" \
    -v "$APP_DIR/send_mail.py:/app/scripts/send_mail.py:ro" backend run /app/scripts/send_mail.py 2>&1 </dev/null)
