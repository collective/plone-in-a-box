#!/usr/bin/python3
"""How the server and site are doing, in one place.

Usage: sudo plone-status          (for people)
       sudo plone-status --json   (for programs)

Read only: it changes nothing. Each part says what it found, or "unknown"
when it can't tell, so one missing file doesn't hide the rest.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time
from urllib.parse import urlsplit

STATE = "/var/lib/plone-in-a-box"
APP = "/opt/plone"
BACKUPS = "/var/backups/plone"


def read(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return ""


def run(*cmd, timeout=20):
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return out.returncode, out.stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return 1, ""


def enabled(unit):
    return run("systemctl", "is-enabled", "--quiet", unit)[0] == 0


def when(ts):
    """The server's local time, with its time zone (such as UTC)."""
    return time.strftime("%Y-%m-%d %H:%M %Z", time.localtime(ts))


def iso(ts):
    """The same moment for programs, which show it in their own time zone."""
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(ts))


def stamped(text, fmt, width):
    """Splits "<time>  <summary>" (as the tools write it) into (ISO time, summary)."""
    try:
        ts = time.mktime(time.strptime(text[:width], fmt))
    except (ValueError, OverflowError):
        return "", text
    return iso(ts), text[width:].lstrip(" :")


def env():
    values = {}
    for line in read(f"{APP}/.env").splitlines():
        if "=" in line and not line.lstrip().startswith("#"):
            k, v = line.split("=", 1)
            values[k.strip()] = v.strip().strip("'\"")
    return values


def site():
    url = read(f"{STATE}/site-url")
    code = "unknown"
    if url:
        # The site through nginx, as a visitor sees it (certificate not checked:
        # a test certificate or an IP address one is still the site).
        rc, out = run("curl", "-ks", "-o", "/dev/null", "-m", "15", "-w", "%{http_code}", url + "/")
        code = out if rc == 0 and out else "no answer"
    return {"url": url or "unknown", "http_status": code, "ok": code.startswith(("2", "3"))}


def parts():
    rc, out = run("docker", "compose", "--project-directory", APP, "ps", "--all", "--format", "json")
    found = {}
    if rc == 0:
        rows = []
        for line in out.splitlines():
            try:
                row = json.loads(line)
            except ValueError:
                continue
            rows += row if isinstance(row, list) else [row]
        for row in rows:
            found[row.get("Service", "?")] = {"state": row.get("State", "?"), "health": row.get("Health") or ""}
    return found


def versions(e):
    return {
        "plone": e.get("PLONE_VERSION", "unknown"),
        "volto": e.get("VOLTO_VERSION", "unknown"),
        "postgresql": e.get("POSTGRES_VERSION", "unknown"),
        "backend_image": e.get("BACKEND_IMAGE", "") or "official",
        "frontend_image": e.get("FRONTEND_IMAGE", "") or "official",
    }


def disk():
    try:
        u = shutil.disk_usage("/")
        return {"used_percent": round(100 * u.used / u.total), "free_gb": round(u.free / 1e9, 1)}
    except OSError:
        return {}


def memory():
    info = {}
    for line in read("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        if v.strip().endswith("kB"):
            info[k] = int(v.split()[0])
    if "MemTotal" not in info:
        return {}
    total, avail = info["MemTotal"], info.get("MemAvailable", 0)
    return {"used_mb": (total - avail) // 1024, "total_mb": total // 1024}


def backups():
    files = sorted(glob.glob(f"{BACKUPS}/plone-*.sql.gz"), key=os.path.getmtime)
    newest = files[-1] if files else ""
    out = {"nightly": enabled("plone-backup.timer"), "count": len(files),
           "newest": when(os.path.getmtime(newest)) if newest else "none yet",
           "newest_iso": iso(os.path.getmtime(newest)) if newest else "",
           "newest_mb": round(os.path.getsize(newest) / 1e6, 1) if newest else 0,
           "offsite": bool(read(f"{STATE}/offsite.conf"))}
    if newest:
        out["newest_age_hours"] = round((time.time() - os.path.getmtime(newest)) / 3600)
    check = read(f"{STATE}/backup-check")
    out["restore_test"] = check or "not run yet"
    out["restore_test_date"], out["restore_test_summary"] = (check[:10], check[10:].lstrip(" :")) if check else ("", "")
    out["restore_test_ok"] = bool(check) and "FAILED" not in check
    # The date in the file is the server's (often UTC, so "tomorrow" in the
    # evening in the Americas): when the test ran, and the backup it tested,
    # as moments the page shows in the viewer's own time zone.
    tested = f"{STATE}/backup-check"
    out["restore_test_iso"] = iso(os.path.getmtime(tested)) if check else ""
    name = re.search(r"plone-(\d{4}-\d\d-\d\d-\d{4})\.sql\.gz", check)
    out["restore_test_backup"] = name.group(0) if name else ""
    out["restore_test_backup_iso"] = stamped(name.group(1), "%Y-%m-%d-%H%M", 15)[0] if name else ""
    if check:  # for people reading it on the server: with the time zone
        out["restore_test"] = f"{when(os.path.getmtime(tested))}: {out['restore_test_summary']}"
    return out


def updates():
    last = read(f"{STATE}/update-status")
    last_iso, summary = stamped(last, "%Y-%m-%d %H:%M", 16) if last else ("", "")
    if last_iso:  # the time zone, for people too
        last = f"{last[:16]} {time.strftime('%Z')}  {summary}"
    return {"automatic": enabled("plone-update.timer"),
            "last": last or "none yet", "last_iso": last_iso, "last_summary": summary,
            "notice": read(f"{STATE}/update-notice")}


def host(url):
    return urlsplit(url).hostname or "set" if url else ""


def features():
    notify = read(f"{STATE}/notify-url")
    syslog = read(f"{STATE}/syslog").split()
    otel = read(f"{STATE}/otel")
    return {
        # Only the host: the rest of a notification URL can be a secret.
        "notifications": host(notify),
        "email": read(f"{STATE}/email-domain"),
        "logs": syslog[1] if len(syslog) > 1 else "",
        "graphs": host(otel.split()[0]) if otel else "",
        "cloudflare": os.path.exists("/etc/nginx/conf.d/plone-cloudflare.conf"),
        "https_ip_certificate": enabled("plone-https-ip.timer"),
        "demo_user": demo_user(),
    }


def demo_user():
    """The demo login's name: saved at setup (2.27), or in the credentials file."""
    name = read(f"{STATE}/demo-user")
    if not name:
        m = re.search(r"^Demo login: ([a-z0-9._-]+) / ", read("/root/plone-credentials.txt"), re.M)
        name = m.group(1) if m else ""
    return name


def security():
    path = f"{STATE}/security-notice"
    if os.path.exists(path) and time.time() - os.path.getmtime(path) < 30 * 86400:
        return read(path).splitlines()[0] if read(path) else ""
    return ""


def gather():
    e = env()
    return {"site": site(), "parts": parts(), "versions": versions(e), "disk": disk(), "memory": memory(),
            "backups": backups(), "updates": updates(), "features": features(), "security_notice": security()}


def onoff(value, on=None):
    return (on or "on") if value else "off"


def show(s):
    site, b, u, f, d, m = s["site"], s["backups"], s["updates"], s["features"], s["disk"], s["memory"]
    lines = [("Site", f"{site['url']} ({'working' if site['ok'] else 'not answering: ' + site['http_status']})")]
    if s["parts"]:
        lines.append(("Parts", ", ".join(
            f"{name} {p['state']}{' (' + p['health'] + ')' if p['health'] else ''}" for name, p in sorted(s["parts"].items()))))
    else:
        lines.append(("Parts", "unknown (is Docker running?)"))
    v = s["versions"]
    lines.append(("Versions", f"Plone {v['plone']}, Volto {v['volto']}, PostgreSQL {v['postgresql']}"))
    for kind in ("backend_image", "frontend_image"):
        if v[kind] != "official":
            lines.append((kind.replace("_", " ").capitalize(), v[kind]))
    if d:
        lines.append(("Disk", f"{d['used_percent']}% used, {d['free_gb']} GB free"))
    if m:
        lines.append(("Memory", f"{m['used_mb']} MB of {m['total_mb']} MB used"))
    newest = b["newest"] + (f" ({b['newest_mb']} MB)" if b["count"] else "")
    lines.append(("Last backup", f"{newest}; nightly backups {onoff(b['nightly'])}, offsite copies {onoff(b['offsite'])}"))
    lines.append(("Restore test", b["restore_test"]))
    lines.append(("Last update", f"{u['last']}; automatic updates {onoff(u['automatic'])}"))
    lines.append(("Notifications", f["notifications"] or "off"))
    lines.append(("Email", f"from {f['email']}" if f["email"]
                  else "not set up when the server was created (see Site Setup > Mail)"))
    lines.append(("Logs", f"sent to {f['logs']}" if f["logs"] else "on the server only"))
    lines.append(("Graphs", f"sent to {f['graphs']}" if f["graphs"] else "off"))
    lines.append(("Cloudflare", onoff(f["cloudflare"], "on: only Cloudflare reaches the site")))
    if s["security_notice"]:
        lines.append(("Security", s["security_notice"]))
    width = max(len(k) for k, _ in lines) + 2
    print("\n".join(f"{(k + ':').ljust(width)}{val}" for k, val in lines))
    if u["notice"]:
        print("\n" + u["notice"])


def main(argv):
    if os.geteuid() != 0:
        sys.exit("Please run this with sudo: sudo plone-status")
    status = gather()
    if "--json" in argv[1:]:
        print(json.dumps(status, indent=2))
    else:
        show(status)


if __name__ == "__main__":
    main(sys.argv)
