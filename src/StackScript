#!/bin/bash
#
# Plone in a Box(TM) -- provision a single Ubuntu server running Plone 6
# (backend + Volto frontend + PostgreSQL) behind nginx.
#
# Used as:
#   - a Linode StackScript (the UDF lines below become form fields),
#   - EC2 user data via src/aws/main.tf, and
#   - DigitalOcean Droplet user data via src/digitalocean/main.tf
#     (both export the same variables first).
#
# Tested target: Ubuntu 26.04 or 24.04 LTS (amd64 or arm64). Run as root.
#
# <UDF name="ADMIN_PASSWORD" label="Plone admin password, at least 12 characters. Leave empty to have one generated and saved on the server" default="" />
# <UDF name="DOMAIN" label="Domain name for the site, optional. DNS must already point here to get HTTPS" default="" />
# <UDF name="LETSENCRYPT_EMAIL" label="Email for Lets Encrypt certificate notices, required if a domain is set" default="" />
# <UDF name="SITE_TIMEZONE" label="Site time zone" default="UTC" example="America/Chicago" />
# <UDF name="SITE_LANGUAGE" label="Site language: a language code such as en, de, fr, es or pt-br" default="en" example="de" />
# <UDF name="STARTER_CONTENT" label="Starter content: yes starts the site with Plone's welcome page, or a Plone distribution's own sample content; no starts with an empty site" oneOf="yes,no" default="yes" />
# <UDF name="PLONE_VERSION" label="Plone backend image tag" default="6.2" />
# <UDF name="VOLTO_VERSION" label="Volto frontend image tag" default="19" />
# <UDF name="ADDONS" label="Backend add-ons, optional: Python package names separated by spaces, for example collective.easyform. Activate them afterwards in Site Setup, Add-ons" default="" />
# <UDF name="FRONTEND_IMAGE" label="Frontend image, optional: a ready-made Plone in a Box image such as ghcr.io/collective/plone-in-a-box-frontend:19-vlt (Volto Light Theme), or your own. Empty: the standard Volto image" default="" />
# <UDF name="BACKEND_IMAGE" label="Backend image, optional: replaces the official Plone backend, for example a Plone distribution such as ghcr.io/kitconcept/kitconcept-intranet-backend:3.11 (with its frontend image above), or your own project's. Empty: the official Plone backend" default="" />
# <UDF name="REGISTRY_USER" label="Registry login for private images, optional: the username for the registry of the frontend and backend images above, for example your GitHub username for ghcr.io" default="" />
# <UDF name="REGISTRY_TOKEN" label="Registry token: a read-only access token for that registry, such as a GitHub token with only read:packages" default="" />
# <UDF name="DEMO_USER" label="Demo login, optional: a username such as demo, for people you let try the site. Setup creates it with a generated password, saved next to the admin password" default="" />
# <UDF name="DEMO_PASSWORD" label="Demo login password, optional, at least 12 characters. Leave empty to have one generated and saved next to the admin password" default="" />
# <UDF name="DEMO_ROLES" label="Roles of the demo login, optional, separated by commas, for example Editor or Site Administrator. Empty: what the frontend image suggests, or Site Administrator" default="" />
# <UDF name="AUTO_UPDATE" label="Automatic updates: install Plone, Volto and PostgreSQL patch releases every week, after a database backup, and undo them if the site doesn't come back" oneOf="yes,no" default="yes" />
# <UDF name="NOTIFY_URL" label="Notification URL, optional: update reports go here, for example https://ntfy.sh/your-own-topic, or a Slack, Discord, Google Chat, Mattermost or Microsoft Teams webhook" default="" />
# <UDF name="SMTP_HOST" label="Email: SMTP server of an email relay service, optional, for example mail.smtp2go.com. Empty: the site doesn't send email" default="" />
# <UDF name="SMTP_PORT" label="Email: SMTP port" default="587" />
# <UDF name="SMTP_USER" label="Email: SMTP username" default="" />
# <UDF name="SMTP_PASSWORD" label="Email: SMTP password" default="" />
# <UDF name="EMAIL_FROM" label="Email: the site's From address, at a domain the email service has verified, for example plone@example.org" default="" />
# <UDF name="REPORT_EMAIL" label="Email: your address for a test email and the update reports. Empty: the From address" default="" />
# <UDF name="SPAMHAUS_KEY" label="Spamhaus DQS key, optional: a free key from spamhaus.com, so the blocklist checks can ask Spamhaus from any cloud provider" default="" />
# <UDF name="LOG_SERVER" label="Logs, optional: a syslog server or service that gets the server's logs too, as HOST:PORT over TLS, for example s1234567.us-east-9.betterstackdata.com:6514 (see Sending the logs elsewhere in the setup guide)" default="" />
# <UDF name="LOG_TOKEN" label="Logs: the token element your log service wants in each message, in brackets, as the service gives it. Empty if it needs none" default="" />
# <UDF name="LOG_REQUESTS" label="Logs: one line per web request too (most of the volume)" oneOf="yes,no" default="no" />
# <UDF name="METRICS_ENDPOINT" label="Graphs, optional: an OpenTelemetry service's OTLP endpoint that gets the server's and the site's numbers, for example https://otlp-gateway-prod-us-east-2.grafana.net/otlp (see Graphs of your server and site in the setup guide)" default="" />
# <UDF name="METRICS_USER" label="Graphs: your instance ID or user (Grafana Cloud), or header:NAME for a service that takes the token in a header (header:api-key for New Relic)" default="" />
# <UDF name="METRICS_TOKEN" label="Graphs: the service's token" default="" />
# <UDF name="CONTROL_PANEL" label="Control panel (preview): a page in your browser that shows how your site is doing, with a few buttons, on port 8443 of the site address. Its login is saved next to the admin password" oneOf="yes,no" default="no" />
#
# After provisioning finishes, open the site and log in as "admin" with the
# password you chose. If you left it empty, a password is generated: log in over
# SSH as root and read /root/plone-credentials.txt.

set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

# Keep a copy of all output in one place on every provider.
LOG_FILE=/var/log/plone-in-a-box.log
exec > >(tee -a "$LOG_FILE") 2>&1
LOG_TEE_PID=$!
# On exit, wait for tee to write the last lines: when setup resumes after a
# restart, systemd stops everything in the service as soon as this script ends.
flush_log() { exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true; }
trap flush_log EXIT

ADMIN_PASSWORD="${ADMIN_PASSWORD:-}"
DOMAIN="${DOMAIN:-}"
LETSENCRYPT_EMAIL="${LETSENCRYPT_EMAIL:-}"
# For automated tests only: yes uses Let's Encrypt's test service for the IP
# address certificate (its certificates aren't trusted by browsers).
LETSENCRYPT_STAGING="${LETSENCRYPT_STAGING:-}"
SITE_TIMEZONE="${SITE_TIMEZONE:-UTC}"
# Site language, as a Plone language code (en, de, pt-br); a code setup doesn't
# recognize as one falls back to English, with a note.
SITE_LANGUAGE="$(printf '%s' "${SITE_LANGUAGE:-en}" | tr -d ' \t\r\n' | tr 'A-Z_' 'a-z-')"
LANGUAGE_NOTE=""
if [[ ! "$SITE_LANGUAGE" =~ ^[a-z]{2,3}(-[a-z]{2,4})?$ ]]; then
  LANGUAGE_NOTE="The site language \"$SITE_LANGUAGE\" isn't a language code such as en or pt-br, so the site is in English."
  SITE_LANGUAGE=en
fi
# Starter content: Plone's welcome page (or a Plone distribution's own sample
# content); no for an empty site.
case "${STARTER_CONTENT:-yes}" in
  [Nn]|[Nn][Oo]|[Ff]alse|0|[Oo]ff) STARTER_CONTENT=no ;;
  *) STARTER_CONTENT=yes ;;
esac
PLONE_VERSION="${PLONE_VERSION:-6.2}"
VOLTO_VERSION="${VOLTO_VERSION:-19}"
POSTGRES_VERSION="${POSTGRES_VERSION:-17}"
# Backend add-ons: Python packages that the plone/plone-backend image installs
# with pip each time the backend container starts (its ADDONS variable).
# Split on any whitespace, without expanding wildcards such as "==1.*".
read -ra ADDON_LIST <<< "$(printf '%s' "${ADDONS:-}" | tr '\n\r\t' '   ')"
ADDONS="${ADDON_LIST[*]}"
# Frontend image: replaces plone/plone-frontend:${VOLTO_VERSION}. Ready-made
# Plone in a Box images say in their labels which backend add-ons and site
# behaviors they need; setup installs and activates those too.
FRONTEND_IMAGE="$(printf '%s' "${FRONTEND_IMAGE:-}" | tr -d ' \t\r\n')"
# Backend image: replaces plone/plone-backend:${PLONE_VERSION}, for example a
# Plone distribution or a project made with cookieplone. It has to start like
# the official image (create-site, run, pack); setup checks that it does.
BACKEND_IMAGE="$(printf '%s' "${BACKEND_IMAGE:-}" | tr -d ' \t\r\n')"
# Registry login for private frontend or backend images: one username and
# token for the registries those images are on. The token is never logged;
# Docker keeps the login in /root/.docker/config.json, so updates can pull the
# images too.
REGISTRY_USER="$(printf '%s' "${REGISTRY_USER:-}" | tr -d ' \t\r\n')"
REGISTRY_TOKEN="$(printf '%s' "${REGISTRY_TOKEN:-}" | tr -d ' \t\r\n')"
# Demo login: an extra Plone user, created once at setup, for letting other
# people try the site (DEMO_USER, with the roles DEMO_ROLES, separated by
# commas). Empty: the roles the frontend image's label suggests, or Site
# Administrator. DEMO_ROLE is the one-role setting of 2.13; its old default,
# Site Administrator, counts as no choice.
DEMO_USER="$(printf '%s' "${DEMO_USER:-}" | tr -d ' \t\r\n')"
DEMO_PASSWORD="${DEMO_PASSWORD:-}"
DEMO_ROLES="$(printf '%s' "${DEMO_ROLES:-}" | tr '\t\r\n' '   ')"
if [[ -z "${DEMO_ROLES// /}" && -n "${DEMO_ROLE:-}" && "$DEMO_ROLE" != "Site Administrator" ]]; then
  DEMO_ROLES="$DEMO_ROLE"
fi
# Notification URL: reports from setup and plone-update are posted here.
NOTIFY_URL="$(printf '%s' "${NOTIFY_URL:-}" | tr -d ' \t\r\n')"
# Email through a relay service (Site Setup > Mail). The password is never
# logged; Plone keeps it in its settings, like Site Setup > Mail does.
SMTP_HOST="$(printf '%s' "${SMTP_HOST:-}" | tr -d ' \t\r\n')"
SMTP_PORT="$(printf '%s' "${SMTP_PORT:-587}" | tr -d ' \t\r\n')"
SMTP_PORT="${SMTP_PORT:-587}"
SMTP_USER="$(printf '%s' "${SMTP_USER:-}" | tr -d '\r\n')"
SMTP_PASSWORD="$(printf '%s' "${SMTP_PASSWORD:-}" | tr -d '\r\n')"
EMAIL_FROM="$(printf '%s' "${EMAIL_FROM:-}" | tr -d ' \t\r\n')"
REPORT_EMAIL="$(printf '%s' "${REPORT_EMAIL:-}" | tr -d ' \t\r\n')"
# A Spamhaus Data Query Service key: Spamhaus answers the blocklist checks
# through it from any network, where its public servers refuse big cloud
# providers' DNS resolvers. It's kept where only root can read it.
SPAMHAUS_KEY="$(printf '%s' "${SPAMHAUS_KEY:-}" | tr -d ' \t\r\n')"
SPAMHAUS_KEY="${SPAMHAUS_KEY,,}"
# Logs to a syslog server or service (plone-syslog), and numbers to an
# OpenTelemetry service (plone-otel), from the start. The tokens are never
# logged; the tools keep them where only root can read them.
LOG_SERVER="$(printf '%s' "${LOG_SERVER:-}" | tr -d ' \t\r\n')"
LOG_TOKEN="$(printf '%s' "${LOG_TOKEN:-}" | tr -d '\r\n')"
case "${LOG_REQUESTS:-no}" in
  [Yy]|[Yy][Ee][Ss]|[Tt]rue|1|[Oo]n) LOG_REQUESTS=yes ;;
  *) LOG_REQUESTS=no ;;
esac
METRICS_ENDPOINT="$(printf '%s' "${METRICS_ENDPOINT:-}" | tr -d ' \t\r\n')"
METRICS_USER="$(printf '%s' "${METRICS_USER:-}" | tr -d ' \t\r\n')"
METRICS_TOKEN="$(printf '%s' "${METRICS_TOKEN:-}" | tr -d ' \t\r\n')"
# The control panel (plone-panel): off unless set to yes.
case "${CONTROL_PANEL:-no}" in
  [Yy]|[Yy][Ee][Ss]|[Tt]rue|1|[Oo]n) CONTROL_PANEL=yes ;;
  *) CONTROL_PANEL=no ;;
esac
# Automatic updates (plone-update.timer): on unless set to no.
case "${AUTO_UPDATE:-yes}" in
  [Nn]|[Nn][Oo]|[Ff]alse|0|[Oo]ff) AUTO_UPDATE=no ;;
  *) AUTO_UPDATE=yes ;;
esac

APP_DIR=/opt/plone
CREDENTIALS_FILE=/root/plone-credentials.txt

# Used when setup restarts the server once to finish installing updates and
# then continues after the restart (see "Restart once" below).
RESUME_DIR=/root/.plone-in-a-box-resume
RESUME_UNIT=/etc/systemd/system/plone-in-a-box-resume.service

log() { echo "[plone-in-a-box] $*"; }

# A Python package name with optional extras and version specifiers, such as
# collective.easyform or collective.easyform==4.2.0: nothing pip would read as
# an option, a URL or a file.
valid_addon() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(\[[A-Za-z0-9._,-]+\])?([~=!<>]=?=?[A-Za-z0-9.*+!_-]+)?(,[~=!<>]=?=?[A-Za-z0-9.*+!_-]+)*$ ]]
}
valid_email() { [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$ ]]; }
# A container image reference: [registry[:port]/]path[:tag][@sha256:digest].
valid_image() {
  [[ "$1" =~ ^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-]+[a-z0-9]+)*)*(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?(@sha256:[a-f0-9]{64})?$ ]]
}

# If this run is the continuation after that restart, make sure it only
# happens once, and remove the saved settings (they include the password).
# The unit file itself stays until the end of setup: removing it and
# reloading systemd while this run is going would make systemd forget the
# service's settings.
if [[ -e "$RESUME_UNIT" ]]; then
  log "Continuing setup after the restart"
  systemctl disable plone-in-a-box-resume.service || true
  rm -f "$RESUME_DIR/settings"
fi

# --- Setup progress page -----------------------------------------------------
# While provisioning runs, nginx serves a page at the server's address that
# shows the current step and refreshes itself; when Plone is ready, the next
# refresh shows the site. If provisioning fails, the page says so.

PROGRESS_DIR=/var/www/plone-in-a-box-setup
PROGRESS_STEPS=(
  "Preparing the server"
  "Installing Docker"
  "Securing the server"
  "Downloading Plone (the longest step)"
  "Creating your Plone site"
  "Starting Plone"
  "Finishing up"
)
CURRENT_STEP=0
STARTED_AT="${STARTED_AT:-$(date -u +"%H:%M UTC")}"

write_progress_page() {
  # write_progress_page <title> <message html> <body html> <refresh seconds, 0 for none>
  [[ -d "$PROGRESS_DIR" ]] || return 0
  local refresh=""
  if (( $4 > 0 )); then
    refresh="<meta http-equiv=\"refresh\" content=\"$4\">"
  fi
  cat > "$PROGRESS_DIR/index.html.tmp" <<EOF
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">${refresh}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$1 - Plone in a Box</title>
<style>
body{font-family:system-ui,-apple-system,sans-serif;max-width:36rem;margin:3rem auto;padding:0 1rem;color:#1a1a1a;line-height:1.5}
h1{font-size:1.5rem;margin-bottom:.5rem}
ol{list-style:none;padding:0;margin:1.5rem 0}
li{margin:.5rem 0;padding-left:1.75rem;position:relative}
li span{position:absolute;left:0;width:1.25rem;text-align:center}
.done{color:#2e7d32}.now{font-weight:600}.todo{color:#888}.failed{color:#c62828;font-weight:600}
.small{color:#666;font-size:.875rem;margin-top:2rem}
code{background:#f2f2f2;padding:.1rem .3rem;border-radius:3px}
</style></head><body>
<h1>$1</h1>
<p>$2</p>
$3
<p class="small">Plone in a Box&trade; &middot; started ${STARTED_AT}</p>
</body></html>
EOF
  mv "$PROGRESS_DIR/index.html.tmp" "$PROGRESS_DIR/index.html"
}

step_list() {
  # step_list <state of the current step: now|failed>
  local i html="" cls mark
  for i in "${!PROGRESS_STEPS[@]}"; do
    if (( i + 1 < CURRENT_STEP )); then
      cls="done"; mark="&#10003;"
    elif (( i + 1 == CURRENT_STEP )); then
      cls=$1
      if [[ "$1" == failed ]]; then mark="&#10007;"; else mark="&rarr;"; fi
    else
      cls="todo"; mark=""
    fi
    html+="<li class=\"${cls}\"><span>${mark}</span>${PROGRESS_STEPS[i]}</li>"
  done
  echo "<ol>${html}</ol>"
}

progress() {
  # progress <step number, starting at 1>
  CURRENT_STEP=$1
  log "Step ${CURRENT_STEP}/${#PROGRESS_STEPS[@]}: ${PROGRESS_STEPS[CURRENT_STEP-1]}"
  write_progress_page "Your Plone site is being set up" \
    "This usually takes about 10 minutes. This page refreshes every 15 seconds and turns into your site when it's ready." \
    "$(step_list now)" 15
}

on_error() {
  log "Setup failed at line $1 (step ${CURRENT_STEP})"
  write_progress_page "Setup didn't finish" \
    "Something went wrong while setting up Plone. It's often a temporary download problem: deploying a new server usually fixes it. To see what happened, log in to the server as root and read <code>${LOG_FILE}</code>." \
    "$(step_list failed)" 0
}
trap 'on_error $LINENO' ERR

wait_for() {
  # wait_for <description> <timeout-seconds> <command...>
  local what=$1 timeout=$2 waited=0
  shift 2
  until "$@" >/dev/null 2>&1; do
    if (( waited >= timeout )); then
      log "Timed out after ${timeout}s waiting for ${what}"
      return 1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
  log "${what} is ready"
}

# --- System packages ---------------------------------------------------------

# Install nginx first, so the progress page is up within a minute or two.
apt-get update -y
apt-get install -y nginx
mkdir -p "$PROGRESS_DIR"
cat > /etc/nginx/sites-available/plone-in-a-box-setup <<EOF
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  root ${PROGRESS_DIR};
  add_header Cache-Control "no-store" always;
  location / {
    try_files /index.html =404;
  }
}
EOF
rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/plone-in-a-box-setup /etc/nginx/sites-enabled/plone-in-a-box-setup
progress 1
nginx -t
systemctl reload nginx || systemctl restart nginx

log "Updating system packages"
# full-upgrade, unlike upgrade, also installs updates that need new packages
# (such as a new kernel).
apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
apt-get install -y ca-certificates curl gnupg ufw openssl

# --- Swap (Plone + Volto + PostgreSQL do not fit comfortably in 1 GB) -------
# Add a 2 GB swap file when memory plus existing swap is under about 3 GB.
# Some providers include a small swap disk (Linode: 512 MB), which isn't
# enough on its own for a 1 GB server.

mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
swap_kb=$(awk '/SwapTotal/ {print $2}' /proc/meminfo)
if (( mem_kb + swap_kb < 3000000 )) && [[ ! -e /swapfile ]]; then
  log "Adding a 2 GB swap file"
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- Restart once if the updates need it -------------------------------------
# A new kernel (and some other updates) only takes effect after a restart.
# Restart now, before Plone is installed, and continue this script
# automatically afterwards, so the finished site never goes down for it.
# nginx keeps showing the progress page across the restart.

if [[ -f /var/run/reboot-required && ! -e "$RESUME_DIR/restarted" ]]; then
  if [[ -f "$0" ]]; then
    log "Restarting the server to finish installing updates; setup continues automatically afterwards"
    install -d -m 700 "$RESUME_DIR"
    cp "$0" "$RESUME_DIR/setup.sh"
    (
      umask 077
      for var in ADMIN_PASSWORD DOMAIN LETSENCRYPT_EMAIL SITE_TIMEZONE SITE_LANGUAGE STARTER_CONTENT PLONE_VERSION VOLTO_VERSION POSTGRES_VERSION ADDONS FRONTEND_IMAGE BACKEND_IMAGE REGISTRY_USER REGISTRY_TOKEN DEMO_USER DEMO_PASSWORD DEMO_ROLES AUTO_UPDATE NOTIFY_URL SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD EMAIL_FROM REPORT_EMAIL SPAMHAUS_KEY LOG_SERVER LOG_TOKEN LOG_REQUESTS METRICS_ENDPOINT METRICS_USER METRICS_TOKEN CONTROL_PANEL LETSENCRYPT_STAGING STARTED_AT; do
        printf 'export %s=%q\n' "$var" "${!var}"
      done > "$RESUME_DIR/settings"
    )
    touch "$RESUME_DIR/restarted"
    cat > "$RESUME_UNIT" <<EOF
[Unit]
Description=Continue Plone in a Box setup after the restart
Wants=network-online.target
After=network-online.target

[Service]
# simple, not oneshot: setup takes several minutes, and systemd puts a time
# limit on starting a oneshot service.
Type=simple
ExecStart=/bin/bash -c '. ${RESUME_DIR}/settings && exec /bin/bash ${RESUME_DIR}/setup.sh'

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable plone-in-a-box-resume.service
    write_progress_page "Restarting the server" \
      "The server is restarting to finish installing updates, and setup then continues by itself. This page refreshes every 15 seconds; if your browser shows an error while the server restarts, reload the page in a minute." \
      "$(step_list now)" 15
    trap - ERR
    systemctl reboot
    exit 0
  else
    log "Updates need a restart, but this script can't be saved to continue afterwards; restart the server after setup"
  fi
fi

# --- Docker Engine + Compose plugin (official repository) -------------------

progress 2
log "Installing Docker"
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
# shellcheck disable=SC1091
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# --- Firewall ----------------------------------------------------------------
# Only SSH and HTTP(S) are reachable from outside. The containers publish
# their ports on 127.0.0.1 only, so Docker's iptables rules don't bypass this.

progress 3
log "Configuring firewall"
ufw allow OpenSSH
ufw allow 'Nginx Full'
ufw --force enable

# --- SSH -----------------------------------------------------------------------
# fail2ban blocks an address for an hour after 5 failed SSH logins in 10
# minutes, longer each time it comes back. Password logins are turned off
# when an SSH key is installed (for root, or the provider's default user such
# as ubuntu on AWS), so nobody is locked out of a server created with only a
# password.

log "Securing SSH"
apt-get install -y fail2ban python3-systemd
cat > /etc/fail2ban/jail.d/plone-in-a-box.local <<'EOF'
# Plone in a Box: block addresses that keep failing to log in over SSH.
[DEFAULT]
backend = systemd
banaction = nftables
banaction_allports = nftables[type=allports]
findtime = 10m
maxretry = 5
bantime = 1h
bantime.increment = true
bantime.maxtime = 1w

[sshd]
enabled = true
EOF
if fail2ban-client -t >/dev/null 2>&1; then
  systemctl enable fail2ban
  systemctl restart fail2ban
  SSH_FAIL2BAN="; addresses that keep failing to log in are blocked for a while (fail2ban)"
else
  log "fail2ban's settings didn't check out; leaving it off"
  rm -f /etc/fail2ban/jail.d/plone-in-a-box.local
  systemctl disable --now fail2ban 2>/dev/null || true
  SSH_FAIL2BAN=""
fi
SSH_KEYS=0
for keys in /root/.ssh/authorized_keys /home/*/.ssh/authorized_keys; do
  # AWS puts a "please log in as ubuntu" line in root's file, which doesn't
  # start with the key type; the default user's file has the key itself.
  [[ -f "$keys" ]] && grep -qE '^(ssh-(ed25519|rsa|dss)|ecdsa-sha2-|sk-)' "$keys" && SSH_KEYS=1
done
SSHD_CONF=/etc/ssh/sshd_config.d/00-plone-in-a-box.conf
if [[ "$SSH_KEYS" == 1 ]]; then
  # sshd uses the first value it reads for a setting, and reads this
  # directory in name order, so 00- comes before the provider's
  # 50-cloud-init.conf, which turns passwords on for servers created with one.
  cat > "$SSHD_CONF" <<'EOF'
# Plone in a Box: SSH keys only; root can log in with a key, never a password.
# To allow passwords again: delete this file, then: sudo systemctl reload ssh
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitRootLogin prohibit-password
EOF
  if sshd -t 2>/dev/null; then
    systemctl reload ssh 2>/dev/null || true
    SSH_LINE="SSH:       keys only, no passwords${SSH_FAIL2BAN}"
  else
    rm -f "$SSHD_CONF"
    SSH_LINE="SSH:       unchanged: turning off passwords failed the SSH settings check${SSH_FAIL2BAN}"
  fi
else
  SSH_LINE="SSH:       passwords still work, because no SSH key is installed${SSH_FAIL2BAN}. Add your key and turn passwords off: see \"SSH\" in the setup guide"
fi
log "${SSH_LINE#SSH:       }"

# --- Secrets -----------------------------------------------------------------

mkdir -p "$APP_DIR"
chmod 700 "$APP_DIR"

if [[ ! -f "$APP_DIR/.env" ]]; then
  log "Generating passwords"
  POSTGRES_PASSWORD=$(openssl rand -hex 24)
  ADMIN_PASSWORD_CHOSEN=0
  PASSWORD_NOTE=""
  if [[ -n "$ADMIN_PASSWORD" ]]; then
    if (( ${#ADMIN_PASSWORD} >= 12 )); then
      ADMIN_PASSWORD_CHOSEN=1
    else
      log "The admin password given is shorter than 12 characters; generating one instead"
      PASSWORD_NOTE="The password entered at deploy time was shorter than 12 characters, so this one was generated instead."
      ADMIN_PASSWORD=""
    fi
  fi
  if [[ -z "$ADMIN_PASSWORD" ]]; then
    ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=')
  fi
  ADDONS_NOTE=""
  for addon in "${ADDON_LIST[@]}"; do
    if ! valid_addon "$addon"; then
      log "Not installing the backend add-ons: \"$addon\" isn't a Python package name"
      ADDONS_NOTE="The add-ons ($ADDONS) were not installed: \"$addon\" isn't a Python package name."
      ADDONS=""
      break
    fi
  done
  FRONTEND_NOTE=""
  if [[ -n "$FRONTEND_IMAGE" ]] && ! valid_image "$FRONTEND_IMAGE"; then
    log "Not using the frontend image \"$FRONTEND_IMAGE\": it isn't an image name; using the standard Volto image"
    FRONTEND_NOTE="The frontend image \"$FRONTEND_IMAGE\" isn't an image name, so the site uses the standard Volto image."
    FRONTEND_IMAGE=""
  fi
  BACKEND_NOTE=""
  if [[ -n "$BACKEND_IMAGE" ]] && ! valid_image "$BACKEND_IMAGE"; then
    log "Not using the backend image \"$BACKEND_IMAGE\": it isn't an image name; using the official Plone backend"
    BACKEND_NOTE="The backend image \"$BACKEND_IMAGE\" isn't an image name, so the site uses the official Plone backend."
    BACKEND_IMAGE=""
  fi
  umask 077
  cat > "$APP_DIR/.env" <<EOF
PLONE_VERSION=${PLONE_VERSION}
VOLTO_VERSION=${VOLTO_VERSION}
POSTGRES_VERSION=${POSTGRES_VERSION}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
ADDONS='${ADDONS}'
FRONTEND_IMAGE='${FRONTEND_IMAGE}'
BACKEND_IMAGE='${BACKEND_IMAGE}'
EOF
  umask 022
  NEW_ADMIN_PASSWORD_SET=0
else
  log "Re-using existing $APP_DIR/.env"
  ADMIN_PASSWORD=""
  ADMIN_PASSWORD_CHOSEN=0
  PASSWORD_NOTE=""
  NEW_ADMIN_PASSWORD_SET=1
  ADDONS_NOTE=""
  ADDONS=$(sed -n "s/^ADDONS='\(.*\)'\$/\1/p" "$APP_DIR/.env")
  FRONTEND_NOTE=""
  FRONTEND_IMAGE=$(sed -n "s/^FRONTEND_IMAGE='\(.*\)'\$/\1/p" "$APP_DIR/.env")
  BACKEND_NOTE=""
  BACKEND_IMAGE=$(sed -n "s/^BACKEND_IMAGE='\(.*\)'\$/\1/p" "$APP_DIR/.env")
fi
# Docker Compose prefers an exported variable over the .env file; .env is what
# the site keeps using after setup, so let Compose read it from there.
export -n ADDONS FRONTEND_IMAGE BACKEND_IMAGE

# --- Docker Compose stack ----------------------------------------------------

cat > "$APP_DIR/docker-compose.yml" <<'EOF'
name: plone

# Each container keeps at most 30 MB of logs (Docker's default keeps them all,
# which can fill a small server's disk).
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  frontend:
    # FRONTEND_IMAGE in .env replaces the standard Volto image.
    image: ${FRONTEND_IMAGE:-plone/plone-frontend:${VOLTO_VERSION}}
    environment:
      RAZZLE_INTERNAL_API_PATH: http://backend:8080/Plone
      # The same, for a Plone Aurora frontend image.
      PLONE_API_PATH: http://backend:8080/Plone
    logging: *logging
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    depends_on:
      backend:
        condition: service_healthy

  backend:
    # BACKEND_IMAGE in .env replaces the official Plone backend.
    image: ${BACKEND_IMAGE:-plone/plone-backend:${PLONE_VERSION}}
    environment:
      RELSTORAGE_DSN: "dbname='plone' user='plone' host='db' password='${POSTGRES_PASSWORD}'"
      # Add-ons are installed with pip each time the container starts, held to
      # the versions this Plone release was tested with.
      ADDONS: ${ADDONS:-}
      PIP_PARAMS: "-c /app/constraints.txt --no-cache-dir"
    # The image's own health check, but with time for installing add-ons
    # before Plone starts: failed checks only count after five minutes.
    healthcheck:
      start_period: 5m
    logging: *logging
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      # The image ships an "inituser" file containing admin:admin, and Zope
      # re-applies it on every start while there is only one Zope user, which
      # would silently reset the admin password whenever the container is
      # recreated. An empty file disables that.
      - ./inituser:/app/inituser:ro
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:${POSTGRES_VERSION}
    environment:
      POSTGRES_USER: plone
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: plone
    logging: *logging
    restart: unless-stopped
    volumes:
      - data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U plone -d plone"]
      interval: 5s
      timeout: 5s
      retries: 20
    # No published ports: PostgreSQL is only reachable from the other containers.

volumes:
  data: {}
EOF

: > "$APP_DIR/inituser"

# Creates the Zope "admin" user or resets its password. Before the Plone site
# exists, the root user folder is a plain Zope User Folder; creating the site
# replaces it with a PluggableAuthService (PAS), whose generic user-folder API
# doesn't list or update users reliably, so PAS is handled through its user
# manager plugin. The new password is verified before committing.
cat > "$APP_DIR/set_admin_password.py" <<'EOF'
import os
import sys
import transaction

app = globals()["app"]
uf = app.acl_users
password = os.environ["NEW_ADMIN_PASSWORD"]

if hasattr(uf, "plugins"):
    # PluggableAuthService
    managers = [
        p for p in uf.objectValues()
        if hasattr(p, "updateUserPassword") and hasattr(p, "listUserIds")
    ]
    if not managers:
        sys.exit("No user manager plugin found in the root acl_users")
    manager = managers[0]
    if "admin" in manager.listUserIds():
        manager.updateUserPassword("admin", password)
    else:
        manager.addUser("admin", "admin", password)
        for roles in uf.objectValues():
            if hasattr(roles, "assignRoleToPrincipal"):
                roles.assignRoleToPrincipal("Manager", "admin")
    ok = manager.authenticateCredentials({"login": "admin", "password": password})
else:
    # Plain Zope User Folder
    if "admin" in uf.getUserNames():
        uf._doChangeUser("admin", password, ["Manager"], [])
    else:
        uf._doAddUser("admin", password, ["Manager"], [])
    ok = uf.authenticate("admin", password, None) is not None

if not ok:
    transaction.abort()
    sys.exit("The new admin password could not be verified; nothing was changed")
transaction.commit()
print("Zope admin user is set up")
EOF

# Activates the add-ons a frontend image needs and enables its behaviors on the
# Plone Site type, so its settings (logo, colours, footer) appear on the site.
cat > "$APP_DIR/activate_frontend_addons.py" <<'EOF'
import os
import sys
import transaction
from AccessControl.SecurityManagement import newSecurityManager
from plone.base.utils import get_installer
from zope.component.hooks import setSite

app = globals()["app"]
site = app["Plone"]
setSite(site)
admin = app.acl_users.getUser("admin") or site.acl_users.getUser("admin")
newSecurityManager(None, admin.__of__(app.acl_users))

installer = get_installer(site)
for name in os.environ.get("SITE_ADDONS", "").split():
    if not installer.is_product_installed(name):
        if not installer.install_product(name):
            transaction.abort()
            sys.exit(f"Couldn't activate {name}")
    print(f"Activated {name}")

fti = site.portal_types["Plone Site"]
behaviors = list(fti.behaviors)
for name in os.environ.get("SITE_BEHAVIORS", "").split():
    if name not in behaviors:
        behaviors.append(name)
fti.behaviors = tuple(behaviors)
transaction.commit()
print("Frontend add-ons are set up")
EOF

# Writes the email settings into Site Setup > Mail. Run once by setup.
cat > "$APP_DIR/configure_mail.py" <<'EOF'
import os
import transaction
from plone.registry.interfaces import IRegistry
from zope.component import getUtility
from zope.component.hooks import setSite

app = globals()["app"]
setSite(app["Plone"])
registry = getUtility(IRegistry)
registry["plone.smtp_host"] = os.environ["SMTP_HOST"]
registry["plone.smtp_port"] = int(os.environ["SMTP_PORT"])
registry["plone.smtp_userid"] = os.environ.get("SMTP_USER") or None
registry["plone.smtp_pass"] = os.environ.get("SMTP_PASSWORD") or None
registry["plone.email_from_address"] = os.environ["EMAIL_FROM"]
# A new site's title is its default front page heading, so not that.
if not registry.get("plone.email_from_name"):
    registry["plone.email_from_name"] = "Plone"
transaction.commit()
print("MAIL_CONFIGURED")
EOF

# Creates the demo login (DEMO_USER) with the roles DEMO_ROLES (separated by
# commas), or resets its password and adds the roles if it exists. Roles the
# site doesn't have, such as an add-on's that wasn't installed, are skipped,
# and Manager is never given. The new password is verified before
# committing. The last line says which roles it got.
cat > "$APP_DIR/create_demo_user.py" <<'EOF'
import os
import sys
import transaction
from AccessControl.SecurityManagement import newSecurityManager
from plone import api
from zope.component.hooks import setSite

app = globals()["app"]
site = app["Plone"]
setSite(site)
admin = app.acl_users.getUser("admin") or site.acl_users.getUser("admin")
newSecurityManager(None, admin.__of__(app.acl_users))

name = os.environ["DEMO_USER"]
password = os.environ["DEMO_PASSWORD"]
roles = []
for role in (r.strip() for r in os.environ["DEMO_ROLES"].split(",")):
    if not role or role in roles or role == "Member":
        continue
    if role in ("Manager", "Owner", "Authenticated", "Anonymous"):
        print(f"The demo login can't have the role {role}; skipped")
    elif role not in site.validRoles():
        print(f"This site has no role {role}; skipped")
    else:
        roles.append(role)
if api.user.get(username=name) is None:
    api.user.create(
        username=name,
        email=f"{name}@example.invalid",
        password=password,
        roles=["Member"] + roles,
        properties={"fullname": "Demo"},
    )
else:
    site.acl_users.userSetPassword(name, password)
    api.user.grant_roles(username=name, roles=["Member"] + roles)
if site.acl_users.authenticate(name, password, None) is None:
    transaction.abort()
    sys.exit(f"The demo login {name} could not be verified; nothing was changed")
transaction.commit()
print(f"Demo login {name} is set up")
print("DEMO_ROLES_GIVEN=" + ", ".join(roles or ["Member"]))
EOF

# Command for resetting the admin password later: sudo plone-reset-admin-password
cat > /usr/local/bin/plone-reset-admin-password <<'EOF'
#!/bin/bash
# Reset the password of the Plone (Zope) "admin" user.
# Usage: sudo plone-reset-admin-password
#        (asks for the new password; press Enter to have one generated)
set -euo pipefail
if [[ $EUID -ne 0 ]]; then
  echo "Please run this with sudo: sudo plone-reset-admin-password" >&2
  exit 1
fi
if [[ ! -t 0 ]]; then
  echo "This command asks for the new password, so it needs a terminal." >&2
  echo "Over SSH, add -t:  ssh -t root@<server> plone-reset-admin-password" >&2
  exit 1
fi
read -rsp "New admin password (at least 12 characters, or press Enter to generate one): " NEW_PASSWORD
echo
if [[ -z "$NEW_PASSWORD" ]]; then
  NEW_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=')
  GENERATED=1
else
  if (( ${#NEW_PASSWORD} < 12 )); then
    echo "That password is shorter than 12 characters; nothing was changed." >&2
    exit 1
  fi
  read -rsp "Type it again: " AGAIN
  echo
  if [[ "$NEW_PASSWORD" != "$AGAIN" ]]; then
    echo "The passwords don't match; nothing was changed." >&2
    exit 1
  fi
  GENERATED=0
fi
if ! OUTPUT=$(NEW_ADMIN_PASSWORD="$NEW_PASSWORD" docker compose --project-directory /opt/plone \
    run --rm --no-deps -e NEW_ADMIN_PASSWORD \
    -v /opt/plone/set_admin_password.py:/app/scripts/set_admin_password.py:ro \
    backend run /app/scripts/set_admin_password.py 2>&1) \
  || ! grep -q "Zope admin user is set up" <<<"$OUTPUT"; then
  echo "Changing the password failed; nothing was changed. Last lines of output:" >&2
  tail -5 <<<"$OUTPUT" >&2
  exit 1
fi
if [[ "$GENERATED" == 1 ]]; then
  echo "The admin password is now: $NEW_PASSWORD"
  echo "Store it in a password manager."
else
  echo "The admin password has been changed."
fi
EOF
chmod 755 /usr/local/bin/plone-reset-admin-password

# >>> update tools
# From here to "<<< update tools", src/add-updates.sh installs the same files on
# servers set up before 2.12. Only APP_DIR may be used here.
# Posts a notice to the notification URL, if one was set: JSON for Slack,
# Google Chat, Mattermost and Discord webhooks, an Adaptive Card for Microsoft
# Teams workflows, plain text with a title for anything else (such as ntfy).
# Exit 0: sent; 1: failed; 3: no URL set.
install -d -m 755 /usr/local/lib/plone-in-a-box
cat > /usr/local/lib/plone-in-a-box/notify <<'EOF'
#!/bin/bash
# Usage: notify <title> <message>
set -uo pipefail
url=$(cat /var/lib/plone-in-a-box/notify-url 2>/dev/null) || exit 3
[[ -n "$url" ]] || exit 3
title=$1 message=$2
# json <key> <value> [flags]: a JSON object; Discord's flags 4 turns off link previews.
json() { python3 -c 'import json, sys; d = {sys.argv[1]: sys.argv[2]}; d.update({"flags": int(sys.argv[3])} if len(sys.argv) > 3 else {}); print(json.dumps(d))' "$@"; }
# Teams workflows ("Send webhook alerts to a channel") take
# an Adaptive Card: the title in bold, then a text block per line.
card() {
  python3 - "$1" "$2" <<'PY'
import json, sys
title, message = sys.argv[1:3]
body = [{"type": "TextBlock", "text": title, "weight": "Bolder", "size": "Medium", "wrap": True}]
gap = True
for line in message.split("\n"):
    if not line.strip():
        gap = True
        continue
    body.append({"type": "TextBlock", "text": line, "wrap": True, "spacing": "Medium" if gap else "None"})
    gap = False
print(json.dumps({"type": "message", "attachments": [{
    "contentType": "application/vnd.microsoft.card.adaptive", "contentUrl": None,
    "content": {"$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard", "version": "1.4", "msteams": {"width": "Full"}, "body": body}}]}))
PY
}
case "$url" in
  https://*.logic.azure.com[:/]*|https://*.powerplatform.com[:/]*|https://*.webhook.office.com[:/]*)
    body=$(card "$title" "$message") type=application/json ;;
  https://discord.com/api/webhooks/*|https://discordapp.com/api/webhooks/*)
    body=$(json content "**${title}**"$'\n'"${message:0:1800}" 4) type=application/json ;;
  https://hooks.slack.com/*|https://chat.googleapis.com/*)
    body=$(json text "*${title}*"$'\n'"${message}") type=application/json ;;
  https://*/hooks/*)  # Mattermost
    body=$(json text "**${title}**"$'\n'"${message}") type=application/json ;;
  *)
    body=$message type="text/plain; charset=utf-8" ;;
esac
curl -fsS -m 30 --retry 3 -o /dev/null -X POST -H "Content-Type: ${type}" -H "Title: ${title}" \
  --data-binary "$body" "$url"
EOF
chmod 755 /usr/local/lib/plone-in-a-box/notify

# Problems a person should hear about: posted to the notification URL and
# emailed (to the address for reports, else the site's From address) with the
# site's mail settings, whichever are set up. Exit 0: at least one got it.
cat > /usr/local/lib/plone-in-a-box/alert <<'EOF'
#!/bin/bash
# Usage: alert <title> <message>
set -uo pipefail
APP_DIR=/opt/plone
sent=1
/usr/local/lib/plone-in-a-box/notify "$1" "$2" </dev/null >/dev/null 2>&1 && sent=0
if [[ -f "$APP_DIR/send_mail.py" ]]; then
  out=$(docker compose --project-directory "$APP_DIR" run --rm --no-deps -T -e ADDONS= \
    -e MAIL_SUBJECT="$1" -e MAIL_BODY="$2" -e MAIL_TO="$(cat /var/lib/plone-in-a-box/report-email 2>/dev/null)" \
    -v "$APP_DIR/send_mail.py:/app/scripts/send_mail.py:ro" backend run /app/scripts/send_mail.py 2>&1 </dev/null)
  [[ "$out" == *MAIL_SENT* ]] && sent=0
fi
exit "$sent"
EOF
chmod 755 /usr/local/lib/plone-in-a-box/alert

# Looks up the server's IP address and the site's domain names in public
# blocklists that mail receivers use. Each list is only asked after its test
# entry answers: some refuse queries through big shared DNS resolvers, and
# then the answer means nothing. With a Spamhaus DQS key in
# /var/lib/plone-in-a-box/spamhaus-key, Spamhaus is asked through it, which
# works from any network.
cat > /usr/local/lib/plone-in-a-box/blocklists <<'EOF'
#!/bin/bash
# Usage: blocklists [--ip ADDRESS] [DOMAIN ...]
# Prints "LISTED <name> <list> <url>" for each listing and "UNCHECKED <list>"
# for each list that couldn't be asked. Exit 0: not listed; 1: listed.
lookup() { getent ahostsv4 "$1" 2>/dev/null | awk 'NR == 1 { print $1 }'; }
# check <list> <its test entry> <what a listing answers, as a regular
# expression> <where to read more> <the name to report> <the name to ask>
check() {
  local list=$1 test=$2 hit=$3 url=$4 name=$5 query=$6 shown=${1#"$key".}
  [[ "$(lookup "$test.$list")" =~ $hit ]] || { echo "UNCHECKED $shown"; return; }
  [[ "$(lookup "$query.$list")" =~ $hit ]] && echo "LISTED $name $shown $url"
}
key=$(tr -cd 'a-z0-9' 2>/dev/null < /var/lib/plone-in-a-box/spamhaus-key)
if [[ -n "$key" ]]; then
  zen="$key.zen.dq.spamhaus.net" dbl="$key.dbl.dq.spamhaus.net"
else
  zen=zen.spamhaus.org dbl=dbl.spamhaus.org
fi
all() {
  local ip="" d rev
  if [[ "${1:-}" == --ip ]]; then ip=$2; shift 2; fi
  if [[ "$ip" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    rev="${BASH_REMATCH[4]}.${BASH_REMATCH[3]}.${BASH_REMATCH[2]}.${BASH_REMATCH[1]}"
    # Spamhaus ZEN without its Policy Block List (127.0.0.10 and .11), which
    # only says an address isn't a mail server's.
    check "$zen" 2.0.0.127 '^127\.0\.0\.[2-9]$' https://check.spamhaus.org/ "$ip" "$rev"
    check bl.spamcop.net 2.0.0.127 '^127\.0\.0\.2$' "https://www.spamcop.net/bl.shtml?$ip" "$ip" "$rev"
  fi
  for d in "$@"; do
    d=${d,,}; d=${d%.}
    [[ "$d" =~ ^[a-z0-9-]+(\.[a-z0-9-]+)+$ ]] || continue
    # The registered domain too (example.org for www.example.org): the lists
    # name domains more often than single hosts.
    for name in "$d" $([[ "$d" =~ \.([a-z0-9-]+\.[a-z0-9-]+)$ ]] && echo "${BASH_REMATCH[1]}"); do
      check "$dbl" dbltest.com '^127\.0\.1\.([2-9]|[1-9][0-9]|1[0-9][0-9])$' https://check.spamhaus.org/ "$name" "$name"
      check multi.surbl.org test.surbl.org '^127\.0\.0\.([2-9]|[1-9][0-9]|1[0-9][0-9]|2[0-5][0-9])$' https://surbl.org/surbl-analysis "$name" "$name"
    done
  done
}
out=$(all "$@" | awk '!seen[$0]++')
[[ -n "$out" ]] && printf '%s\n' "$out"
! grep -q '^LISTED' <<<"$out"
EOF
chmod 755 /usr/local/lib/plone-in-a-box/blocklists

# Updates: sudo plone-update, and weekly through plone-update.timer when
# automatic updates are on. It installs newer images of the same Plone, Volto
# and PostgreSQL versions (the tags in .env stay as they are), after a
# database dump, and goes back to the previous images if the site doesn't
# come back. The result goes to the login message, and by email to the site's
# address when Site Setup > Mail has one.
cat > /usr/local/bin/plone-update <<'PLONE_UPDATE_EOF'
#!/bin/bash
# Install newer images of the same Plone, Volto and PostgreSQL versions: patch
# releases and security fixes. Takes a database dump first, and goes back to the
# previous images if the site doesn't come back.
# Usage: sudo plone-update   (also run every week by plone-update.timer, if on)
set -uo pipefail
if [[ $EUID -ne 0 ]]; then
  echo "Please run this with sudo: sudo plone-update" >&2
  exit 1
fi
APP_DIR=/opt/plone
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
LOG_FILE=/var/log/plone-update.log
# Seconds to wait for the site after updating; add-ons are installed first.
HEALTH_TIMEOUT=${PLONE_UPDATE_HEALTH_TIMEOUT:-600}
# And after going back to the previous images.
ROLLBACK_TIMEOUT=600
SERVICES=(db backend frontend)
GUIDE=https://github.com/collective/plone-in-a-box/blob/main/docs/setup-guide.md#updates

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
# Shared with plone-backup: wait for a backup or pack to finish.
if ! flock -n 9; then
  echo "Waiting for plone-update or plone-backup, which is running" >&2
  if ! flock -w 7200 9; then
    echo "plone-update or plone-backup is still running; try again later" >&2
    exit 1
  fi
fi
exec > >(tee -a "$LOG_FILE") 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT

say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
compose() { docker compose --project-directory "$APP_DIR" "$@"; }
SITE_URL=$(cat "$STATE_DIR/site-url" 2>/dev/null || hostname)
cd "$APP_DIR" || exit 1

versions() {
  local plone volto pg
  plone=$(compose exec -T backend /app/bin/python -c \
    'from importlib.metadata import version; print(version("Products.CMFPlone"))' 2>/dev/null) || plone="?"
  volto=$(compose exec -T frontend node -p 'require("@plone/volto/package.json").version' 2>/dev/null) && volto="Volto ${volto:-?}" \
    || { volto=$(compose exec -T frontend node -p 'require("@plone/aurora/package.json").version' 2>/dev/null) && volto="Aurora ${volto:-?}"; } \
    || volto="Volto ?"
  pg=$(compose exec -T db postgres --version 2>/dev/null | awk '{print $3}') || pg="?"
  echo "Plone ${plone:-?}, ${volto}, PostgreSQL ${pg:-?}"
}

site_ok() {
  curl -fsS -m 10 -o /dev/null http://127.0.0.1:8080/ok && curl -fsS -m 30 -o /dev/null http://127.0.0.1:3000/
}

# A newer Plone release than the one in .env: a manual upgrade, so only say so.
NOTICE=""
check_releases() {
  local current next
  # A custom backend image moves to a new Plone version when its maker
  # publishes one; PLONE_VERSION doesn't apply to it.
  grep -q "^BACKEND_IMAGE='[^']" "$APP_DIR/.env" && return 0
  current=$(sed -n 's/^PLONE_VERSION=//p' "$APP_DIR/.env")
  [[ "$current" =~ ^([0-9]+)\.([0-9]+)$ ]] || return 0
  for next in "${BASH_REMATCH[1]}.$((BASH_REMATCH[2] + 1))" "$((BASH_REMATCH[1] + 1)).0"; do
    if curl -fs -m 20 -o /dev/null "https://hub.docker.com/v2/repositories/plone/plone-backend/tags/${next}"; then
      NOTICE="Plone ${next} is available. This server stays on Plone ${current}: moving to ${next} is a manual upgrade, see ${GUIDE}"
      return 0
    fi
  done
}

send_report() {  # send_report <subject> <body>
  local out to
  # The address for reports chosen at setup, or else the site's From address.
  to=$(cat "$STATE_DIR/report-email" 2>/dev/null || true)
  out=$(compose run --rm --no-deps -T -e MAIL_SUBJECT="$1" -e MAIL_BODY="$2" -e MAIL_TO="$to" \
    -v "$APP_DIR/send_mail.py:/app/scripts/send_mail.py:ro" \
    backend run /app/scripts/send_mail.py 2>&1)
  case "$out" in
    *MAIL_SENT*) say "Emailed this report to ${to:-the site address in Site Setup > Mail}" ;;
    *NO_MAIL_SETTINGS*) say "Not emailed: the site has no email address in Site Setup > Mail" ;;
    *) say "Emailing this report failed:"; tail -3 <<<"$out" ;;
  esac
}

# finish <exit code> <summary> [details]: record the result for the login
# message, and email it unless nothing happened or it was already reported.
finish() {
  local code=$1 summary=$2 details=${3:-} report
  say "$summary"
  [[ -n "$details" ]] && printf '%s\n' "$details"
  printf '%s  %s\n' "$(date '+%F %H:%M')" "$summary" > "$STATE_DIR/update-status"
  printf '%s\n' "$NOTICE" > "$STATE_DIR/update-notice"
  report=$(printf '%s\n\n%s\n\n%s' "$summary" "$details" "$NOTICE")
  if [[ "$summary" != "Up to date"* || -n "$NOTICE" ]] \
     && [[ "$report" != "$(cat "$STATE_DIR/last-report" 2>/dev/null)" ]]; then
    local subject body
    subject="Plone in a Box: ${summary%%:*} (${SITE_URL})"
    body=$(printf '%s\n\n%s\n\nThe log is in %s on the server. Turn automatic updates off: sudo systemctl disable --now plone-update.timer\nUpdates and backups: %s' \
      "$SITE_URL" "$report" "$LOG_FILE" "$GUIDE")
    send_report "$subject" "$body"
    /usr/local/lib/plone-in-a-box/notify "$subject" "$body"
    case $? in
      0) say "Sent this report to the notification URL" ;;
      3) ;;
      *) say "Sending this report to the notification URL failed" ;;
    esac
    printf '%s' "$report" > "$STATE_DIR/last-report"
  fi
  exit "$code"
}

declare -A REF OLD NEW
CHANGED=() NOTES=()
for s in "${SERVICES[@]}"; do
  cid=$(compose ps -q "$s")
  if [[ -z "$cid" ]]; then
    finish 1 "Not updated: the $s container isn't running" "Start the site first: sudo docker compose --project-directory $APP_DIR up -d"
  fi
  REF[$s]=$(docker inspect -f '{{.Config.Image}}' "$cid")
  OLD[$s]=$(docker inspect -f '{{.Image}}' "$cid")
done
BEFORE=$(versions)
say "Checking for newer images (now ${BEFORE})"
check_releases
# Nightly backups that stopped (a stopped timer, a full disk) without a failure
# notice: say so in the report.
if systemctl is-enabled --quiet plone-backup.timer 2>/dev/null; then
  # shellcheck disable=SC2012
  newest=$(ls -1t "$BACKUP_DIR"/plone-*.sql.gz 2>/dev/null | head -n 1)
  if [[ -z "$newest" ]]; then
    NOTICE+="${NOTICE:+ }There's no database backup on this server: check sudo systemctl status plone-backup.timer and /var/log/plone-backup.log."
  elif (( $(date +%s) - $(stat -c %Y "$newest") > 2 * 86400 )); then
    NOTICE+="${NOTICE:+ }The newest database backup is from $(date -r "$newest" '+%F'), more than two days ago: check sudo systemctl status plone-backup.timer and /var/log/plone-backup.log."
  fi
fi
# Ubuntu's security updates waiting for a restart (plone-reboot.timer off,
# or a backup or update that kept it from running), and a nearly full disk.
if [[ -f /var/run/reboot-required ]] && (( $(date +%s) - $(stat -c %Y /var/run/reboot-required) > 2 * 86400 )); then
  NOTICE+="${NOTICE:+ }Security updates have been waiting for a restart since $(date -r /var/run/reboot-required '+%F'): run sudo reboot (Plone starts again by itself), or turn the nightly restarts back on with sudo systemctl enable --now plone-reboot.timer."
fi
used=$(df --output=pcent / | tail -n 1 | tr -dc '0-9')
if (( used > 85 )); then
  NOTICE+="${NOTICE:+ }The server's disk is ${used}% full: free some space (sudo docker image prune -a removes images the site doesn't use) before backups and updates stop working."
fi
# The site's domain and the From address's domain on a mail blocklist: email
# from them, or with links to them, may land in spam.
site_host=${SITE_URL#*://}; site_host=${site_host%%[:/]*}
[[ "$site_host" =~ ^[0-9.]+$ ]] && site_host=""
# shellcheck disable=SC2046,SC2086 # no domain is no argument
while read -r kind name list url; do
  [[ "$kind" == LISTED ]] && NOTICE+="${NOTICE:+ }${name} is on the blocklist ${list} (${url}): email from it, or with links to it, may land in spam. That page explains how to have it removed."
  [[ "$kind" == UNCHECKED && "$name" == dbl.dq.spamhaus.net ]] && NOTICE+="${NOTICE:+ }Spamhaus didn't answer through the DQS key in /var/lib/plone-in-a-box/spamhaus-key: check the key."
done < <(/usr/local/lib/plone-in-a-box/blocklists $site_host $(cat "$STATE_DIR/email-domain" 2>/dev/null) || true)
# The server's own mail, with the site's mail settings as they are now.
/usr/local/bin/plone-server-mail >/dev/null 2>&1 </dev/null
# rclone for copies off the server (plone-offsite), if they're set up, and
# Certbot for the IP address certificate (plone-https-ip), if it's in use.
[[ -s "$STATE_DIR/offsite.conf" ]] && docker pull -q rclone/rclone:1 >/dev/null 2>&1
systemctl is-enabled --quiet plone-https-ip.timer 2>/dev/null && docker pull -q certbot/certbot:latest >/dev/null 2>&1
if ! compose pull --quiet; then
  finish 1 "Not updated: downloading the images failed" "Nothing was changed. The reason is in $LOG_FILE."
fi

label() { docker image inspect -f '{{index .Config.Labels "org.plone-in-a-box.backend-addons"}}' "$1" 2>/dev/null; }
for s in "${SERVICES[@]}"; do
  NEW[$s]=$(docker image inspect -f '{{.Id}}' "${REF[$s]}")
  [[ "${NEW[$s]}" == "${OLD[$s]}" ]] && continue
  if grep -qxF "${NEW[$s]}" "$STATE_DIR/failed-images" 2>/dev/null; then
    docker tag "${OLD[$s]}" "${REF[$s]}"
    NOTES+=("Skipped the new ${s} image (${REF[$s]}): the site didn't come back with it last time.")
    continue
  fi
  if [[ "$s" == frontend && "$(label "${OLD[$s]}")" != "$(label "${NEW[$s]}")" ]]; then
    docker tag "${OLD[$s]}" "${REF[$s]}"
    NOTES+=("Skipped the new frontend image: it needs other backend add-ons ($(label "${NEW[$s]}")), so update it by hand; see ${GUIDE}")
    continue
  fi
  CHANGED+=("$s")
done
put_back() { for s in "${CHANGED[@]}"; do docker tag "${OLD[$s]}" "${REF[$s]}"; done; }

if (( ${#CHANGED[@]} == 0 )); then
  if (( ${#NOTES[@]} )); then
    finish 0 "Not updated: ${BEFORE}" "$(printf '%s\n' "${NOTES[@]}")"
  fi
  finish 0 "Up to date: ${BEFORE}"
fi

install -d -m 700 "$BACKUP_DIR"
DUMP="$BACKUP_DIR/plone-$(date +%F-%H%M).sql.gz"
say "Backing up the database to ${DUMP}"
compose exec -T db pg_dump -U plone plone | gzip > "${DUMP}.part"
status=("${PIPESTATUS[@]}")
if [[ "${status[0]}" != 0 || "${status[1]}" != 0 ]]; then
  rm -f "${DUMP}.part"
  put_back
  finish 1 "Not updated: backing up the database failed" "Nothing was changed. The reason is in $LOG_FILE."
fi
mv "${DUMP}.part" "$DUMP"
# Keep the three newest dumps (named by this script, so ls is safe).
# shellcheck disable=SC2012
ls -1t "$BACKUP_DIR"/plone-*.sql.gz | tail -n +4 | xargs -r rm -f

say "Updating ${CHANGED[*]}"
if compose up -d --wait --wait-timeout "$HEALTH_TIMEOUT" && site_ok; then
  docker image prune -f >/dev/null
  AFTER=$(versions)
  if [[ "$AFTER" == "$BEFORE" ]]; then
    summary="Updated: new builds of ${AFTER} (${CHANGED[*]})"
  else
    summary="Updated: ${BEFORE} -> ${AFTER}"
  fi
  finish 0 "$summary" "$(printf '%s\n' "Database backup from before the update: ${DUMP}" "${NOTES[@]}")"
fi

say "The site didn't come back; going back to the previous images"
for s in "${CHANGED[@]}"; do echo "${NEW[$s]}" >> "$STATE_DIR/failed-images"; done
put_back
if (( ${#CHANGED[@]} == 1 )); then
  undone="the new ${CHANGED[0]} image, so it runs the previous one again; that build is skipped"
else
  undone="the new ${CHANGED[*]} images, so it runs the previous ones again; those builds are skipped"
fi
if compose up -d --wait --wait-timeout "$ROLLBACK_TIMEOUT" && site_ok; then
  finish 1 "Update failed and was undone: back on ${BEFORE}" \
    "$(printf '%s\n' "The site didn't come back with ${undone} from now on. The reason is in ${LOG_FILE}." "Database backup from before the update: ${DUMP}")"
fi
finish 2 "Update failed, and going back failed too: the site may be down" \
  "$(printf '%s\n' "Check: sudo docker compose --project-directory ${APP_DIR} ps" "Database backup from before the update: ${DUMP}" "The log is in ${LOG_FILE}.")"
PLONE_UPDATE_EOF
chmod 755 /usr/local/bin/plone-update

# Run inside the backend by plone-update and setup: emails a message to MAIL_TO
# (or else the site's own address) with the site's mail settings (Site Setup >
# Mail), if it has them.
cat > "$APP_DIR/send_mail.py" <<'EOF'
import os
import smtplib
from email.message import EmailMessage
from plone.registry.interfaces import IRegistry
from zope.component import getUtility
from zope.component.hooks import setSite

app = globals()["app"]
setSite(app["Plone"])
registry = getUtility(IRegistry)
address = registry.get("plone.email_from_address")
host = registry.get("plone.smtp_host")
if not address or not host:
    print("NO_MAIL_SETTINGS")
else:
    msg = EmailMessage()
    msg["Subject"] = os.environ["MAIL_SUBJECT"]
    msg["From"] = f'{registry.get("plone.email_from_name") or "Plone"} <{address}>'
    msg["To"] = os.environ.get("MAIL_TO") or address
    msg.set_content(os.environ["MAIL_BODY"])
    port = registry.get("plone.smtp_port") or 25
    user = registry.get("plone.smtp_userid")
    try:
        smtp_class = smtplib.SMTP_SSL if port == 465 else smtplib.SMTP
        with smtp_class(host, port, timeout=60) as smtp:
            smtp.ehlo()
            if port != 465 and smtp.has_extn("starttls"):
                smtp.starttls()
                smtp.ehlo()
            if user:
                smtp.login(user, registry.get("plone.smtp_pass") or "")
            smtp.send_message(msg)
        print("MAIL_SENT")
    except Exception as e:
        print(f"MAIL_FAILED {e!r}")
EOF

# Run inside the backend by plone-server-mail: the site's mail settings (Site
# Setup > Mail), as one line of JSON.
cat > "$APP_DIR/mail_settings.py" <<'EOF'
import json
from plone.registry.interfaces import IRegistry
from zope.component import getUtility
from zope.component.hooks import setSite

app = globals()["app"]
setSite(app["Plone"])
registry = getUtility(IRegistry)
print("MAIL_SETTINGS " + json.dumps({
    "host": registry.get("plone.smtp_host") or "",
    "port": registry.get("plone.smtp_port") or 25,
    "user": registry.get("plone.smtp_userid") or "",
    "password": registry.get("plone.smtp_pass") or "",
    "from": registry.get("plone.email_from_address") or "",
}))
EOF

# The server's own mail (cron, Ubuntu's automatic updates, anything that
# mails root) through the site's mail settings: sudo plone-server-mail. Setup
# and add-updates.sh run it, and plone-update every week, so a change in Site
# Setup > Mail reaches it.
cat > /usr/local/bin/plone-server-mail <<'PLONE_SERVER_MAIL_EOF'
#!/bin/bash
# Mail the server itself sends to root goes to the address for reports, through
# the site's email service (msmtp, with the settings from Site Setup > Mail).
# Ubuntu's automatic security updates then email you if they fail.
# Usage: sudo plone-server-mail        (take the settings from the site again)
#        sudo plone-server-mail test   (and send a test email)
# Exit 0: set up; 1: failed; 3: the site has no mail settings.
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-server-mail" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
APP_DIR=/opt/plone
MARK="# Written by plone-server-mail"
site=$(cat "$STATE_DIR/site-url" 2>/dev/null || hostname)

out=$(docker compose --project-directory "$APP_DIR" run --rm --no-deps -T -e ADDONS= \
  -v "$APP_DIR/mail_settings.py:/app/scripts/mail_settings.py:ro" backend run /app/scripts/mail_settings.py 2>/dev/null </dev/null)
settings=$(grep -o '^MAIL_SETTINGS .*' <<<"$out" | tail -n 1)
settings=${settings#MAIL_SETTINGS }
[[ -n "$settings" ]] || { echo "Couldn't read the site's mail settings (is the site running?)" >&2; exit 1; }
if ! python3 -c 'import json, sys; d = json.loads(sys.argv[1]); sys.exit(0 if d["host"] and d["from"] else 1)' "$settings"; then
  echo "The site has no mail settings (Site Setup > Mail), so the server's own mail isn't set up"
  exit 3
fi
# Another mail program already in charge (postfix, say): leave it be.
if [[ -e /usr/sbin/sendmail ]] && ! dpkg -S /usr/sbin/sendmail 2>/dev/null | grep -q '^msmtp-mta:'; then
  echo "This server already has another mail program ($(dpkg -S /usr/sbin/sendmail 2>/dev/null | cut -d: -f1 || echo unknown)); leaving it as it is" >&2
  exit 1
fi
if ! dpkg -s msmtp-mta >/dev/null 2>&1; then
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq -o DPkg::Lock::Timeout=600 msmtp msmtp-mta >/dev/null \
    || { echo "Installing msmtp failed" >&2; exit 1; }
fi
report=$(cat "$STATE_DIR/report-email" 2>/dev/null)
# The way to log in: msmtp picks the strongest method the server offers, and
# some services (SMTP2GO, for one) offer SCRAM but don't accept it. Plone
# itself logs in with CRAM-MD5, PLAIN or LOGIN, so use one of those too:
# PLAIN or LOGIN, sent only over TLS, else CRAM-MD5.
read -r host port < <(python3 -c 'import json, sys; d = json.loads(sys.argv[1]); print(d["host"], int(d["port"]))' "$settings")
starttls=on; [[ "$port" == 465 ]] && starttls=off
methods=$(msmtp --serverinfo --host="$host" --port="$port" --tls=on --tls-starttls="$starttls"   --tls-trust-file=/etc/ssl/certs/ca-certificates.crt 2>/dev/null | sed -n '/Supported authentication methods:/{n;p;}')
auth=on
for m in PLAIN LOGIN CRAM-MD5; do
  [[ " $methods " == *" $m "* ]] && { auth=${m,,}; break; }
done
override=0
dpkg --compare-versions "$(dpkg-query -W -f='${Version}' msmtp)" ge 1.8.20 && override=1

# The configuration, written by Python so the password needs no shell quoting.
new=$(python3 - "$settings" "$report" "$override" "$MARK" "$auth" <<'PY'
import json, sys
d = json.loads(sys.argv[1])
report, override, mark, auth = sys.argv[2] or d["from"], sys.argv[3] == "1", sys.argv[4], sys.argv[5]
def q(value):
    return '"' + str(value).replace("\\", "\\\\").replace('"', '\\"') + '"'
port = int(d["port"])
lines = [mark + " from Site Setup > Mail; it's run again every week.",
         "defaults", "tls on", "tls_trust_file /etc/ssl/certs/ca-certificates.crt",
         "syslog LOG_MAIL", "aliases /etc/aliases", "",
         "account site", f"host {q(d['host'])}", f"port {port}",
         "tls_starttls " + ("off" if port == 465 else "on")]
if d["user"]:
    lines += [f"auth {auth}", f"user {q(d['user'])}", f"password {q(d['password'])}"]
else:
    lines += ["auth off"]
# Every message is sent from the site's address, which the service accepts,
# whatever From the program sending it gave.
lines += [f"from {q(d['from'])}", "set_from_header on"]
if override:
    lines += ["allow_from_override off"]
lines += ["", "account default : site"]
print("\n".join(lines))
print("#ALIASES " + report)
PY
) || { echo "Writing the mail settings failed" >&2; exit 1; }
aliases_to=$(sed -n 's/^#ALIASES //p' <<<"$new")
new=$(sed '/^#ALIASES /d' <<<"$new")
changed=0
if [[ "$new" != "$(cat /etc/msmtprc 2>/dev/null)" ]]; then
  (umask 077; printf '%s\n' "$new" > /etc/msmtprc.new) && mv /etc/msmtprc.new /etc/msmtprc
  changed=1
fi
# root, and anyone else on the server, to the address for reports.
aliases=$(printf '%s: mail for root and the other users on this server goes to the address for reports.\nroot: %s\ndefault: %s' "$MARK" "$aliases_to" "$aliases_to")
if [[ "$aliases" != "$(cat /etc/aliases 2>/dev/null)" ]]; then
  [[ -s /etc/aliases ]] && ! grep -qF "$MARK" /etc/aliases && cp -n /etc/aliases /etc/aliases.before-plone-in-a-box
  printf '%s\n' "$aliases" > /etc/aliases
  changed=1
fi
# Ubuntu's automatic security updates: an email when one fails.
printf '%s\nUnattended-Upgrade::Mail "root";\nUnattended-Upgrade::MailReport "only-on-error";\n' "// ${MARK#\# }" \
  > /etc/apt/apt.conf.d/51plone-in-a-box-mail
(( changed )) && echo "The server's own mail now goes to $aliases_to, through $(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["host"])' "$settings")"

if [[ "${1:-}" == test ]]; then
  if printf 'To: root\nSubject: Plone in a Box: a test of the server'"'"'s own mail (%s)\nDate: %s\nMIME-Version: 1.0\nContent-Type: text/plain; charset=UTF-8\n\n%s\n' \
       "$site" "$(date -R)" "This test email shows that $site can email you about the server itself: failed security updates, and anything else that mails root." \
       | /usr/sbin/sendmail -t -oi; then
    echo "Sent a test email to $aliases_to"
  else
    echo "Sending the test email failed: see sudo journalctl -t msmtp" >&2
    exit 1
  fi
fi
exit 0
PLONE_SERVER_MAIL_EOF
chmod 755 /usr/local/bin/plone-server-mail

# Nightly database backup, and a weekly pack: sudo plone-backup, and every
# night through plone-backup.timer.
cat > /usr/local/bin/plone-backup <<'PLONE_BACKUP_EOF'
#!/bin/bash
# A database backup in /var/backups/plone (the three newest are kept, counting
# those plone-update takes), and once a week a pack: it removes the history of
# changes older than 7 days, which otherwise makes the database grow forever.
# PostgreSQL then reuses the space. It waits while plone-update runs.
# Usage: sudo plone-backup        (also run every night by plone-backup.timer)
#        sudo plone-backup pack   (pack now, after the backup)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-backup" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
flock -w 10800 9 || { echo "plone-update is still running; no backup this time" >&2; exit 1; }
exec >>/var/log/plone-backup.log 2>&1
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
compose() { docker compose --project-directory /opt/plone "$@"; }
problem() {
  say "$1"
  /usr/local/lib/plone-in-a-box/alert "Plone in a Box: backup problem ($(cat "$STATE_DIR/site-url" 2>/dev/null || hostname))" \
    "$1. The log is in /var/log/plone-backup.log on the server." >/dev/null 2>&1
}
fail() {
  problem "$1"
  exit 1
}

install -d -m 700 "$BACKUP_DIR"
# A full disk stops backups, updates and the site, so say so once it's over
# 85% full, and again at every 5 points more.
used=$(df --output=pcent / | tail -n 1 | tr -dc '0-9')
warned=$(cat "$STATE_DIR/disk-warned" 2>/dev/null || echo 0)
if (( used > 85 && used >= warned + 5 )); then
  problem "The server's disk is ${used}% full: $(df -h --output=used,size,avail / | tail -n 1 | awk '{print $1 " of " $2 " used, " $3 " free"}'). Free some space (sudo docker image prune -a removes images the site doesn't use), or move to a bigger server"
  echo "$used" > "$STATE_DIR/disk-warned"
elif (( used <= 80 )); then
  rm -f "$STATE_DIR/disk-warned"
fi
# Room for twice the last backup, at least 200 MB, so the disk doesn't fill up.
# shellcheck disable=SC2012
last=$(ls -1t "$BACKUP_DIR"/plone-*.sql.gz 2>/dev/null | head -n 1)
need=$(( ${last:+$(stat -c %s "$last") * 2 +} 0 ))
(( need > 200000000 )) || need=200000000
(( $(df --output=avail -B1 "$BACKUP_DIR" | tail -n 1) > need )) || fail "No backup: the disk is nearly full"
DUMP="$BACKUP_DIR/plone-$(date +%F-%H%M).sql.gz"
compose exec -T db pg_dump -U plone plone | gzip > "$DUMP.part"
[[ "${PIPESTATUS[*]}" == "0 0" ]] || { rm -f "$DUMP.part"; fail "The database backup failed"; }
mv "$DUMP.part" "$DUMP"
say "Backed up the database to $DUMP"
# The server's own settings next to it: setup's .env (versions, images,
# add-ons) and compose file, and the nginx site. The content is all in the
# database; these save redoing settings by hand on a new server.
CONFIG="${DUMP%.sql.gz}.config.tar.gz"
tar -czf "$CONFIG" -C / --ignore-failed-read opt/plone/.env opt/plone/docker-compose.yml \
  etc/nginx/sites-available/plone 2>/dev/null && chmod 600 "$CONFIG" && say "Saved the server's settings to $CONFIG"
# shellcheck disable=SC2012
ls -1t "$BACKUP_DIR"/plone-*.sql.gz | tail -n +4 | xargs -r rm -f
# shellcheck disable=SC2012
ls -1t "$BACKUP_DIR"/plone-*.config.tar.gz 2>/dev/null | tail -n +4 | xargs -r rm -f
# A copy off the server, encrypted, if sudo plone-offsite setup was run.
if [[ -s "$STATE_DIR/offsite.conf" ]]; then
  /usr/local/bin/plone-offsite upload "$DUMP" || problem "Copying the backup off the server failed"
  if [[ -s "$CONFIG" ]]; then
    /usr/local/bin/plone-offsite upload "$CONFIG" || problem "Copying the server's settings off the server failed"
  fi
fi

if [[ "${1:-}" == pack ]] || (( $(date +%s) - $(cat "$STATE_DIR/last-pack" 2>/dev/null || echo 0) > 597600 )); then
  say "Packing the database"
  compose run --rm --no-deps -T -e ADDONS= backend pack -d 7 || fail "Packing the database failed"
  date +%s > "$STATE_DIR/last-pack"
  say "Packed"
fi
PLONE_BACKUP_EOF
chmod 755 /usr/local/bin/plone-backup

# Restore a database backup: sudo plone-restore [FILE]. Also for moving a site
# to a new server: copy a backup there and restore it.
cat > /usr/local/bin/plone-restore <<'PLONE_RESTORE_EOF'
#!/bin/bash
# Put a database backup back: the site's pages, files, users and settings
# become what they were when the backup was taken. Takes a backup of the site
# as it is now first, and goes back to it if the restore fails.
# Usage: sudo plone-restore               (list the backups)
#        sudo plone-restore FILE [--yes]  (restore FILE, a plone-*.sql.gz backup)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-restore" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
compose() { docker compose --project-directory /opt/plone "$@"; }
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
if [[ $# -eq 0 ]]; then
  echo "Backups on this server, newest first:"
  # shellcheck disable=SC2012
  ls -1t "$BACKUP_DIR"/*.sql.gz 2>/dev/null | while read -r f; do
    printf '  %s  (%s, %s)\n' "$f" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%F %H:%M')"
  done
  echo "Restore one with: sudo plone-restore FILE"
  exit 0
fi
FILE=$1
[[ -s "$FILE" ]] || { echo "No backup at $FILE" >&2; exit 1; }
gzip -t "$FILE" 2>/dev/null || { echo "$FILE isn't a complete .sql.gz backup" >&2; exit 1; }
# (Reading through <(...): with pipefail, zcat stopped early by head would
# count as a failure.)
grep -q 'PostgreSQL database dump' <(zcat "$FILE" 2>/dev/null | head -c 4000) \
  || { echo "$FILE isn't a database backup made by plone-backup or pg_dump" >&2; exit 1; }
if [[ "${2:-}" != --yes ]]; then
  echo "This replaces everything on the site (pages, files, users, settings) with the backup"
  echo "$FILE, from $(date -r "$FILE" '+%F %H:%M'). A backup of the site as it is now is taken first."
  read -r -p "Type yes to continue: " answer
  [[ "$answer" == yes ]] || { echo "Nothing was changed."; exit 1; }
fi
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
flock -w 3600 9 || { echo "plone-update or plone-backup is still running; try again later" >&2; exit 1; }
exec > >(tee -a /var/log/plone-restore.log) 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT

load() {  # load FILE: replace the database with FILE, with the site stopped
  compose stop backend frontend >/dev/null 2>&1
  compose exec -T db psql -q -U plone -d postgres -v ON_ERROR_STOP=1 \
    -c 'DROP DATABASE IF EXISTS plone WITH (FORCE)' -c 'CREATE DATABASE plone OWNER plone' || return 1
  zcat "$1" | compose exec -T db psql -q -U plone -d plone -v ON_ERROR_STOP=1 >/dev/null || return 1
}
start() {  # start the site and wait for it
  compose up -d >/dev/null 2>&1
  for _ in $(seq 1 60); do
    curl -fs -m 10 -o /dev/null http://127.0.0.1:8080/ok && curl -fs -m 30 -o /dev/null http://127.0.0.1:3000/ && return 0
    sleep 10
  done
  return 1
}

# The site as it is now, named so plone-backup's rotation keeps it.
BEFORE="$BACKUP_DIR/before-restore-$(date +%F-%H%M%S).sql.gz"
install -d -m 700 "$BACKUP_DIR"
say "Backing up the site as it is now to $BEFORE"
compose exec -T db pg_dump -U plone plone | gzip > "$BEFORE.part"
[[ "${PIPESTATUS[*]}" == "0 0" ]] || { rm -f "$BEFORE.part"; say "That backup failed, so nothing was changed"; exit 1; }
mv "$BEFORE.part" "$BEFORE"
say "Restoring $FILE"
if load "$FILE" && start; then
  say "Restored $FILE. Log in with the passwords from the time of that backup."
  exit 0
fi
say "Restoring $FILE failed; putting back the site as it was"
if load "$BEFORE" && start; then
  say "The site is back as it was before. Nothing was restored."
else
  say "Putting the site back failed too. The backup of the site as it was is $BEFORE"
fi
exit 1
PLONE_RESTORE_EOF
chmod 755 /usr/local/bin/plone-restore

# Run inside the backend by plone-backup-check, against the test copy of the
# database: opens the Plone site, counts its catalog entries, and reads the
# newest pages and one file or image, so the content itself is known to be
# there, not just the tables. Add-ons aren't installed for this, so their own
# kinds of content may not load; those are counted, not failed.
cat > "$APP_DIR/check_backup.py" <<'EOF'
from zope.component.hooks import setSite

app = globals()["app"]
site = app.get("Plone")
if site is None:
    print("CHECK_NO_SITE")
else:
    setSite(site)
    catalog = site.portal_catalog
    # (A catalog search with no query finds nothing, so: everything under the site.)
    path = "/".join(site.getPhysicalPath())
    entries = len(catalog.unrestrictedSearchResults(path=path))
    loaded = failed = 0
    for brain in catalog.unrestrictedSearchResults(path=path, sort_on="modified", sort_order="descending")[:20]:
        try:
            brain._unrestrictedGetObject().Title()
            loaded += 1
        except Exception:
            failed += 1
    blob = "none"
    for brain in catalog.unrestrictedSearchResults(path=path, portal_type=["File", "Image"], sort_on="modified", sort_order="descending")[:1]:
        try:
            obj = brain._unrestrictedGetObject()
            field = getattr(obj, "file", None) or getattr(obj, "image", None)
            with field.open() as f:
                f.read(1024)
            blob = "ok"
        except Exception as e:
            blob = f"failed:{type(e).__name__}"
    print(f"CHECK_SITE entries={entries} loaded={loaded} failed={failed} blob={blob}")
EOF

# Restore test: sudo plone-backup-check, and once a month through
# plone-backup-check.timer.
cat > /usr/local/bin/plone-backup-check <<'PLONE_BACKUP_CHECK_EOF'
#!/bin/bash
# Checks that a backup can really be restored, without touching the site: loads
# it into a separate test database next to the site's, opens the Plone site in
# it and reads some of its pages and files, then deletes the test database.
# With copies off the server (plone-offsite), it tests the newest copy there,
# downloaded and decrypted, as you would after losing the server; otherwise
# the newest backup on the server. A problem is reported like a failed backup.
# Usage: sudo plone-backup-check          (also run once a month by plone-backup-check.timer)
#        sudo plone-backup-check FILE     (test FILE, a plone-*.sql.gz backup)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-backup-check" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
APP_DIR=/opt/plone
CHECK_DB=plone_check
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
flock -w 10800 9 || { echo "A backup or update is still running; no check this time" >&2; exit 1; }
exec > >(tee -a /var/log/plone-backup-check.log) 2>&1
LOG_TEE_PID=$!
FETCHED=""
cleanup() {
  compose exec -T db psql -q -U plone -d postgres -c "DROP DATABASE IF EXISTS $CHECK_DB WITH (FORCE)" >/dev/null 2>&1
  [[ -n "$FETCHED" ]] && rm -f "$FETCHED"
  exec >/dev/null 2>&1
  wait "$LOG_TEE_PID" 2>/dev/null || true
}
trap cleanup EXIT
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
compose() { docker compose --project-directory "$APP_DIR" "$@"; }
sql() { compose exec -T -e PGOPTIONS='-c client_min_messages=warning' db psql -q -At -U plone -v ON_ERROR_STOP=1 "$@"; }
site=$(cat "$STATE_DIR/site-url" 2>/dev/null || hostname)
fail() {
  say "$1"
  printf '%s: FAILED: %s\n' "$(date '+%F')" "$1" > "$STATE_DIR/backup-check"
  /usr/local/lib/plone-in-a-box/alert "Plone in a Box: backup check failed ($site)" \
    "$1. The log is in /var/log/plone-backup-check.log on the server; run the check again with: sudo plone-backup-check" >/dev/null 2>&1
  exit 1
}

# Which backup: the one given, the newest copy off the server, or the newest here.
FILE=${1:-}
WHERE="on the server"
if [[ -z "$FILE" && -s "$STATE_DIR/offsite.conf" ]]; then
  # shellcheck disable=SC1091
  FOLDER=$(source "$STATE_DIR/offsite.conf"; printf '%s' "$FOLDER")
  name=$(/usr/local/bin/plone-offsite list 2>/dev/null | awk -v f="$FOLDER/" 'index($3, f) == 1 && $3 ~ /\/plone-[^\/]*\.sql\.gz\.gpg$/ { print $3 }' | sort -r | head -n 1)
  [[ -n "$name" ]] || fail "No copy of a backup was found off the server, in $FOLDER (sudo plone-offsite list)"
  say "Downloading the newest copy off the server, $name"
  /usr/local/bin/plone-offsite fetch "$name" >/dev/null || fail "Downloading or decrypting the copy $name failed"
  FILE="$BACKUP_DIR/offsite-$(basename "$name" .gpg)"
  FETCHED=$FILE
  WHERE="off the server, $name"
  # The name has the date it was taken; an old newest copy means the copies stopped.
  taken=$(sed -nE 's/^plone-([0-9]{4}-[0-9]{2}-[0-9]{2})-.*/\1/p' <<<"$(basename "$name")")
  if [[ -n "$taken" ]] && (( $(date +%s) - $(date -d "$taken" +%s) > 3 * 86400 )); then
    fail "The newest copy off the server, $name, is from $taken: the nightly copies have stopped"
  fi
elif [[ -z "$FILE" ]]; then
  # shellcheck disable=SC2012
  FILE=$(ls -1t "$BACKUP_DIR"/plone-*.sql.gz 2>/dev/null | head -n 1)
  [[ -n "$FILE" ]] || fail "There's no backup on the server to check"
fi
[[ -s "$FILE" ]] || fail "No backup at $FILE"
gzip -t "$FILE" 2>/dev/null || fail "The backup $FILE is damaged: it isn't a complete .sql.gz file"

# Room for a second copy of the database, and some to spare.
size=$(sql -d plone -c "SELECT pg_database_size('plone')") || fail "The site's database didn't answer"
avail=$(df --output=avail -B1 /var/lib/docker | tail -n 1)
(( avail > size * 12 / 10 + 200000000 )) \
  || fail "Not enough free disk for the check: the database takes $((size / 1048576)) MB, and $((avail / 1048576)) MB are free"

say "Loading $FILE into the test database $CHECK_DB"
sql -d postgres -c "DROP DATABASE IF EXISTS $CHECK_DB WITH (FORCE)" -c "CREATE DATABASE $CHECK_DB OWNER plone" >/dev/null \
  || fail "Creating the test database failed"
zcat "$FILE" | sql -d "$CHECK_DB" >/dev/null || fail "Loading the backup $FILE into a database failed"

# The objects in it, against the site's own (the site may have grown since).
count() {  # count DB: objects in the database (history-preserving or not)
  sql -d "$1" -c "SELECT count(*) FROM current_object" 2>/dev/null || sql -d "$1" -c "SELECT count(*) FROM object_state" 2>/dev/null
}
restored=$(count "$CHECK_DB") || fail "The backup loaded, but it has no Plone data in it"
live=$(count plone || echo 0)
(( restored > 0 )) || fail "The backup loaded, but it's empty"
(( restored * 2 >= live )) || fail "The backup has $restored objects, under half the site's $live"

# The site itself, opened from the test database by a second Plone process.
pw=$(sed -nE "s/^POSTGRES_PASSWORD=['\"]?([^'\"]*)['\"]?$/\1/p" "$APP_DIR/.env")
out=$(compose run --rm --no-deps -T -e ADDONS= \
  -e RELSTORAGE_DSN="dbname='$CHECK_DB' user='plone' host='db' password='$pw'" \
  -v "$APP_DIR/check_backup.py:/app/scripts/check_backup.py:ro" \
  backend run /app/scripts/check_backup.py 2>&1 </dev/null)
result=$(grep -oE 'CHECK_(SITE|NO_SITE).*' <<<"$out" | tail -n 1)
case "$result" in
  CHECK_NO_SITE) fail "The backup loaded, but there's no Plone site in it" ;;
  CHECK_SITE*) ;;
  *) printf '%s\n' "$out" | tail -n 20; fail "Plone couldn't open the site in the backup (its messages are in the log)" ;;
esac
entries=$(sed -nE 's/.*entries=([0-9]+).*/\1/p' <<<"$result")
loaded=$(sed -nE 's/.*loaded=([0-9]+).*/\1/p' <<<"$result")
failed=$(sed -nE 's/.*failed=([0-9]+).*/\1/p' <<<"$result")
blob=$(sed -nE 's/.*blob=([^ ]+).*/\1/p' <<<"$result")
(( entries == 0 || loaded > 0 )) || fail "Plone opened the site in the backup, but none of its newest $failed pages could be read"
[[ "$blob" == failed* ]] && fail "Plone opened the site in the backup, but the newest file or image couldn't be read (${blob#failed:})"

summary="OK: the backup $(basename "$FILE") ($WHERE) restores: $restored database objects, $entries pages and files, the newest $loaded opened"
[[ "$blob" == ok ]] && summary+=", and a file or image read"
(( failed > 0 )) && summary+=" ($failed more are add-on content, not checked)"
say "$summary"
printf '%s: %s\n' "$(date '+%F')" "$summary" > "$STATE_DIR/backup-check"
PLONE_BACKUP_CHECK_EOF
chmod 755 /usr/local/bin/plone-backup-check

# Encrypted copies of the nightly backups in S3-compatible storage (Cloudflare
# R2, AWS S3, Backblaze B2, DigitalOcean Spaces, Hetzner and others), once
# the owner runs sudo plone-offsite setup.
cat > /usr/local/bin/plone-offsite <<'PLONE_OFFSITE_EOF'
#!/bin/bash
# Copies of the nightly backups off the server, encrypted with a passphrase,
# in S3-compatible storage.
# Usage: sudo plone-offsite setup        (storage settings and passphrase; a test upload)
#        sudo plone-offsite list         (the copies in the bucket, from every server using it)
#        sudo plone-offsite fetch NAME   (download and decrypt one into /var/backups/plone)
#        sudo plone-offsite upload FILE  (done by plone-backup every night)
#        sudo plone-offsite off          (stop making copies; the bucket is left as it is)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-offsite ${1:-}" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
CONF=$STATE_DIR/offsite.conf
RCLONE_CONF=$STATE_DIR/offsite-rclone.conf
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
die() { echo "$*" >&2; exit 1; }
# rclone from its official image (Ubuntu's is from 2022); plone-update pulls
# newer builds of the same major version every week.
RCLONE_IMAGE=rclone/rclone:1
# (-i only where rclone reads standard input: elsewhere, inside a while-read
# loop, docker would swallow the rest of the loop's input.)
rc() { docker run --rm ${RC_STDIN:+-i} --network host -v "$RCLONE_CONF:/config/rclone/rclone.conf:ro" \
  -v "$BACKUP_DIR:$BACKUP_DIR" "$RCLONE_IMAGE" --retries 3 --low-level-retries 5 "$@"; }
# gpg with a throwaway home, so root's keyring isn't touched.
crypt() { local home; home=$(mktemp -d); gpg --homedir "$home" --batch --yes --quiet --pinentry-mode loopback \
  --passphrase-file "$STATE_DIR/offsite-passphrase" "$@"; local status=$?; rm -rf "$home"; return $status; }
load() {
  [[ -s "$CONF" ]] || die "Copies off the server aren't set up. Run: sudo plone-offsite setup"
  # shellcheck disable=SC1090
  source "$CONF"
}

case "${1:-}" in
setup)
  echo "Downloading rclone ($RCLONE_IMAGE)"
  docker pull -q "$RCLONE_IMAGE" >/dev/null || die "Downloading $RCLONE_IMAGE failed"
  install -d -m 700 "$BACKUP_DIR"
  command -v gpg >/dev/null || { apt-get install -y -qq gnupg >/dev/null || die "Installing gnupg failed"; }
  ask() {  # ask VAR "question" [default] [secret]: from the environment (OFFSITE_VAR) or the keyboard
    local var=$1 q=$2 def=${3:-} env="OFFSITE_$1" v
    v=${!env:-}
    if [[ -z "$v" ]]; then
      if [[ -n "${4:-}" ]]; then read -r -s -p "$q: " v; echo; else read -r -p "$q${def:+ [$def]}: " v; fi
    fi
    printf -v "$var" '%s' "${v:-$def}"
  }
  echo "Copies of the nightly backups go to S3-compatible storage, encrypted. Make a private bucket and an"
  echo "access key that can read and write it at your storage service first. Endpoints, for example:"
  echo "  Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com (region: auto)"
  echo "  AWS S3: https://s3.us-east-1.amazonaws.com (region: us-east-1)"
  echo "  Backblaze B2: https://s3.us-west-004.backblazeb2.com   DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com"
  echo "  Hetzner: https://fsn1.your-objectstorage.com"
  ask ENDPOINT "Endpoint"
  default_region=""
  [[ "$ENDPOINT" == *.r2.cloudflarestorage.com* ]] && default_region=auto
  [[ "$ENDPOINT" =~ s3[.-]([a-z0-9-]+)\.amazonaws\.com ]] && default_region=${BASH_REMATCH[1]}
  ask REGION "Region (Enter if the service doesn't use one)" "$default_region"
  ask BUCKET "Bucket"
  ask ACCESS_KEY "Access key ID"
  ask SECRET_KEY "Secret access key" "" secret
  ask KEEP "How many copies to keep" 14
  site=$(sed -E 's#^https?://##; s#/.*##' "$STATE_DIR/site-url" 2>/dev/null || hostname)
  ask FOLDER "Folder in the bucket for this server's copies" "plone-in-a-box/$site"
  # (http only for storage on the server itself, such as a test.)
  [[ "$ENDPOINT" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$ || "$ENDPOINT" =~ ^http://(localhost|127\.0\.0\.1)(:[0-9]+)?/?$ ]] \
    || die "The endpoint has to look like https://host"
  [[ "$BUCKET" =~ ^[A-Za-z0-9._-]+$ ]] || die "That bucket name isn't valid"
  [[ "$KEEP" =~ ^[1-9][0-9]*$ ]] || die "How many to keep has to be a number"
  [[ "$FOLDER" =~ ^[A-Za-z0-9._/-]+$ ]] || die "Use letters, digits, dots, dashes and slashes for the folder"
  [[ -n "$ACCESS_KEY" && -n "$SECRET_KEY" ]] || die "The access key and secret are both needed"
  echo "Passphrase: press Enter to make a new one, or paste the one another server uses, so this server can"
  echo "read that server's copies (for moving a site)."
  ask PASSPHRASE "Passphrase" "" secret
  new_passphrase=0
  [[ -n "$PASSPHRASE" ]] || { PASSPHRASE=$(openssl rand -base64 30 | tr -d '/+=' | cut -c1-32); new_passphrase=1; }
  # rclone's provider: AWS and R2 have their own, the rest are "Other".
  provider=Other
  [[ "$ENDPOINT" == *.amazonaws.com* ]] && provider=AWS
  [[ "$ENDPOINT" == *.r2.cloudflarestorage.com* ]] && provider=Cloudflare
  umask 077
  cat > "$RCLONE_CONF" <<CONF
[offsite]
type = s3
provider = $provider
access_key_id = $ACCESS_KEY
secret_access_key = $SECRET_KEY
endpoint = ${ENDPOINT%/}
region = ${REGION:-us-east-1}
no_check_bucket = true
CONF
  printf '%s' "$PASSPHRASE" > "$STATE_DIR/offsite-passphrase"
  printf 'BUCKET=%q\nFOLDER=%q\nKEEP=%q\n' "$BUCKET" "${FOLDER%/}" "$KEEP" > "$CONF.new"
  test_name="setup-test-$(date +%s).txt"
  if ! echo "Plone in a Box test file" | RC_STDIN=1 rc rcat "offsite:$BUCKET/${FOLDER%/}/$test_name" \
     || ! rc lsf "offsite:$BUCKET/${FOLDER%/}/" | grep -qx "$test_name" \
     || ! rc deletefile "offsite:$BUCKET/${FOLDER%/}/$test_name"; then
    rm -f "$CONF.new" "$RCLONE_CONF" "$STATE_DIR/offsite-passphrase"
    die "Uploading, listing or deleting a test file failed (see the message above). Check the endpoint, bucket and key, and that the key can read, write and delete in the bucket."
  fi
  mv "$CONF.new" "$CONF"
  echo
  echo "Copies off the server are set up: every night's backup goes to $BUCKET/${FOLDER%/}/, encrypted, and the"
  echo "$KEEP newest are kept."
  if (( new_passphrase )); then
    echo
    echo "The passphrase for the copies is:  $PASSPHRASE"
    echo "Keep it in your password manager. Without it, the copies can't be read, also if this server is lost."
  fi
  echo "Make the first copy now with: sudo plone-backup"
  ;;
upload)
  load; FILE=${2:-}
  [[ -s "$FILE" ]] || die "No backup at $FILE"
  name="$(basename "$FILE").gpg"
  tmp=$(mktemp "$BACKUP_DIR/.offsite-XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  crypt --symmetric --cipher-algo AES256 -o "$tmp" "$FILE" || die "Encrypting $FILE failed"
  rc copyto "$tmp" "offsite:$BUCKET/$FOLDER/$name" || die "Uploading to $BUCKET/$FOLDER failed"
  say "Copied $name to $BUCKET/$FOLDER"
  # Keep the newest KEEP copies of this kind (database or settings; the names
  # sort by date).
  kind='\.sql\.gz\.gpg$'
  [[ "$name" == *.config.tar.gz.gpg ]] && kind='\.config\.tar\.gz\.gpg$'
  rc lsf --files-only "offsite:$BUCKET/$FOLDER/" | grep -E "^plone-.*$kind" | sort -r | tail -n +"$((KEEP + 1))" \
    | while read -r old; do rc deletefile "offsite:$BUCKET/$FOLDER/$old" && say "Removed the old copy $old"; done
  ;;
list)
  load
  echo "Copies in $BUCKET, by folder (this server uses $FOLDER):"
  rc lsf -R --files-only --format "tsp" "offsite:$BUCKET/" | grep -E '\.(sql|config\.tar)\.gz\.gpg' | sort -t ';' -k1,1r \
    | awk -F';' '{printf "  %s  %s  %.1f MB\n", substr($1, 1, 16), $3, $2 / 1048576}'
  echo "Download one with: sudo plone-offsite fetch FOLDER/NAME, then restore it with sudo plone-restore."
  ;;
fetch)
  load; NAME=${2:-}
  [[ "$NAME" =~ ^[A-Za-z0-9._/-]+\.(sql|config\.tar)\.gz\.gpg$ ]] || die "Give the name as plone-offsite list shows it"
  [[ "$NAME" == */* ]] || NAME="$FOLDER/$NAME"
  install -d -m 700 "$BACKUP_DIR"
  out="$BACKUP_DIR/offsite-$(basename "$NAME" .gpg)"
  tmp=$(mktemp "$BACKUP_DIR/.offsite-XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  rc copyto "offsite:$BUCKET/$NAME" "$tmp" || die "Downloading $NAME failed"
  crypt -d -o "$out" "$tmp" || { rm -f "$out"; die "Decrypting $NAME failed: is this the passphrase it was made with?"; }
  echo "Downloaded and decrypted to $out"
  if [[ "$out" == *.sql.gz ]]; then
    echo "Restore it with: sudo plone-restore $out"
  else
    echo "It holds the server's settings: see them with: tar -tzvf $out"
  fi
  ;;
off)
  rm -f "$CONF" "$RCLONE_CONF" "$STATE_DIR/offsite-passphrase"
  echo "Copies off the server are off. The copies already in the bucket are left as they are."
  ;;
*)
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
PLONE_OFFSITE_EOF
chmod 755 /usr/local/bin/plone-offsite

# A site behind Cloudflare's proxy: sudo plone-cloudflare on. Only Cloudflare
# can then reach the web ports, and the site sees visitors' own addresses.
# plone-cloudflare.timer keeps Cloudflare's address list up to date.
cat > /usr/local/bin/plone-cloudflare <<'PLONE_CLOUDFLARE_EOF'
#!/bin/bash
# For a site whose domain is proxied by Cloudflare (the orange cloud): the
# firewall lets only Cloudflare's addresses reach ports 80 and 443, so nobody
# can go around Cloudflare to the server, and nginx takes each visitor's own
# address from Cloudflare's CF-Connecting-IP header. SSH isn't affected.
# Usage: sudo plone-cloudflare on [--force]  (--force: even if the domain doesn't point at Cloudflare yet)
#        sudo plone-cloudflare off           (open ports 80 and 443 to everyone again)
#        sudo plone-cloudflare status
#        sudo plone-cloudflare refresh       (update Cloudflare's addresses; done once a month)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-cloudflare ${1:-}" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
RANGES=$STATE_DIR/cloudflare-ranges
CONF=/etc/nginx/conf.d/plone-cloudflare.conf
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*" | tee -a /var/log/plone-cloudflare.log; }
die() { say "$*" >&2; exit 1; }
site=$(cat "$STATE_DIR/site-url" 2>/dev/null || hostname)

# Cloudflare's published address ranges, one per line, or nothing.
fetch() {
  local v4 v6
  v4=$(curl -fsS -m 30 --retry 3 https://www.cloudflare.com/ips-v4) || return 1
  v6=$(curl -fsS -m 30 --retry 3 https://www.cloudflare.com/ips-v6) || return 1
  python3 - "$v4" "$v6" <<'PY'
import ipaddress, sys
v4 = [ipaddress.ip_network(x.strip()) for x in sys.argv[1].split() if x.strip()]
v6 = [ipaddress.ip_network(x.strip()) for x in sys.argv[2].split() if x.strip()]
if len(v4) < 5 or len(v6) < 3 or any(n.version != 4 for n in v4) or any(n.version != 6 for n in v6):
    sys.exit(1)
print("\n".join(str(n) for n in sorted(v4) + sorted(v6, key=str)))
PY
}

rule() {  # rule allow|delete RANGE
  if [[ "$1" == allow ]]; then
    ufw allow proto tcp from "$2" to any port 80,443 comment Cloudflare >/dev/null
  else
    ufw delete allow proto tcp from "$2" to any port 80,443 >/dev/null
  fi
}

# apply LIST: nginx's real-address settings and the firewall rules for LIST,
# replacing the ones for the previous list.
apply() {
  local list=$1 old="" r
  [[ -s "$RANGES" ]] && old=$(cat "$RANGES")
  { echo "# Written by plone-cloudflare: visitors' own addresses, from Cloudflare's header."
    while read -r r; do echo "set_real_ip_from $r;"; done <<<"$list"
    echo "real_ip_header CF-Connecting-IP;"; } > "$CONF.new"
  mv "$CONF.new" "$CONF"
  if ! nginx -t -q 2>/dev/null; then
    rm -f "$CONF"
    die "nginx didn't accept the Cloudflare settings; nothing was changed"
  fi
  # New ranges first, so the site is never closed to Cloudflare.
  while read -r r; do grep -qxF "$r" <<<"$old" || rule allow "$r" || die "Adding the firewall rule for $r failed"; done <<<"$list"
  while read -r r; do [[ -z "$r" ]] || grep -qxF "$r" <<<"$list" || rule delete "$r"; done <<<"$old"
  printf '%s\n' "$list" > "$RANGES"
  systemctl reload nginx
}

case "${1:-}" in
on)
  domain=$(awk '$1 == "server_name" { sub(/;$/, "", $2); print $2; exit }' /etc/nginx/sites-available/plone)
  [[ -n "$domain" && "$domain" != _ ]] \
    || die "This site has no domain name. Cloudflare needs one: see \"Adding a domain later\" in the setup guide"
  list=$(fetch) || die "Couldn't get Cloudflare's address list from www.cloudflare.com; nothing was changed"
  # The domain has to point at Cloudflare already, or visitors are shut out.
  addresses=$(getent ahosts "$domain" | awk '{print $1}' | sort -u)
  if ! python3 - "$list" "$addresses" <<'PY'
import ipaddress, sys
nets = [ipaddress.ip_network(x) for x in sys.argv[1].split()]
addrs = [ipaddress.ip_address(x) for x in sys.argv[2].split()]
sys.exit(0 if addrs and all(any(a in n for n in nets) for a in addrs) else 1)
PY
  then
    if [[ "${2:-}" != --force ]]; then
      die "$domain doesn't point at Cloudflare (it's ${addresses//$'\n'/ }): turn on the proxy (the orange cloud) for it in Cloudflare's DNS settings first, wait a few minutes, and try again. Otherwise only Cloudflare could reach the site, and nobody could visit it."
    fi
    say "$domain doesn't point at Cloudflare yet; going ahead, as --force asks"
  fi
  apply "$list"
  ufw delete allow 'Nginx Full' >/dev/null 2>&1
  systemctl enable --now plone-cloudflare.timer 2>/dev/null
  say "On: only Cloudflare's $(wc -l <<<"$list") address ranges can reach ports 80 and 443, and the site sees visitors' own addresses. Back to open with: sudo plone-cloudflare off"
  ;;
refresh)
  [[ -s "$RANGES" ]] || exit 0
  if ! list=$(fetch); then
    say "Couldn't get Cloudflare's address list; the current one stays"
    /usr/local/lib/plone-in-a-box/alert "Plone in a Box: Cloudflare's addresses not updated ($site)" \
      "Getting Cloudflare's current address list from www.cloudflare.com failed, so the firewall keeps the list from $(date -r "$RANGES" '+%F'). If Cloudflare has added addresses since, some visitors may not reach the site. It's tried again next month, or now with: sudo plone-cloudflare refresh" >/dev/null 2>&1
    exit 1
  fi
  if [[ "$list" == "$(cat "$RANGES")" ]]; then
    touch "$RANGES"
    say "Cloudflare's addresses haven't changed"
  else
    apply "$list"
    say "Updated Cloudflare's addresses: $(wc -l <<<"$list") ranges"
  fi
  ;;
off)
  ufw allow 'Nginx Full' >/dev/null
  if [[ -s "$RANGES" ]]; then
    while read -r r; do [[ -z "$r" ]] || rule delete "$r"; done < "$RANGES"
  fi
  rm -f "$RANGES" "$CONF"
  nginx -t -q && systemctl reload nginx
  systemctl disable --now plone-cloudflare.timer 2>/dev/null
  say "Off: ports 80 and 443 are open to everyone again"
  ;;
status)
  if [[ -s "$RANGES" ]]; then
    echo "On: only Cloudflare's $(wc -l < "$RANGES") address ranges can reach ports 80 and 443 (list from $(date -r "$RANGES" '+%F'))."
  else
    echo "Off: ports 80 and 443 are open to everyone. Turn it on with: sudo plone-cloudflare on"
  fi
  ;;
*)
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
PLONE_CLOUDFLARE_EOF
chmod 755 /usr/local/bin/plone-cloudflare
cat > /etc/systemd/system/plone-cloudflare.service <<'EOF'
[Unit]
Description=Plone in a Box: update Cloudflare's addresses in the firewall
After=network-online.target nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/plone-cloudflare refresh
EOF
cat > /etc/systemd/system/plone-cloudflare.timer <<'EOF'
[Unit]
Description=Update Cloudflare's addresses once a month

[Timer]
OnCalendar=*-*-03 05:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF

# plone-otel: starts the backend as the official image does, with
# plone.observability's request metrics added to the image's own zope.ini
# first (the image has no setting for it). Mounted into the backend by the
# compose-override helper.
cat > /usr/local/lib/plone-in-a-box/backend-start <<'BACKEND_START_EOF'
#!/bin/sh
# Adds plone.observability's "healthserver" and "observability" filters to
# /app/etc/zope.ini when Plone starts with it among its add-ons, then starts
# as the image does. A zope.ini that isn't shaped as expected is left as it
# is: Plone starts normally, only without its request metrics (and the health
# check falls back to /ok).
ini=/app/etc/zope.ini
case " ${ADDONS:-} " in *" plone.observability"*) wanted=yes ;; *) wanted=no ;; esac
if [ "${1:-}" = start ] && [ "$wanted" = yes ] && [ -f "$ini" ] && ! grep -q '^\[filter:observability\]' "$ini"; then
  if awk '
    /^\[pipeline:main\]/ { pipeline = 1 }
    pipeline && /^[ \t]+zope[ \t]*$/ && !done { print "    healthserver"; print "    observability"; done = 1 }
    { print }
    END {
      if (!done) exit 1
      print ""
      print "[filter:healthserver]"
      print "use = egg:plone.observability#healthserver"
      print ""
      print "[filter:observability]"
      print "use = egg:plone.observability#observability"
    }' "$ini" > "$ini.new"; then
    mv "$ini.new" "$ini"
  else
    rm -f "$ini.new"
    echo "plone-in-a-box: $ini isn't as expected, so Plone's request metrics are off" >&2
  fi
fi
exec /app/docker-entrypoint.sh "$@"
BACKEND_START_EOF
chmod 755 /usr/local/lib/plone-in-a-box/backend-start

# The site's docker-compose.override.yml, made from what's turned on:
# plone-syslog (the containers log to journald) and plone-otel (metrics: the
# backend gets plone.observability, PostgreSQL a port on 127.0.0.1, and an
# OpenTelemetry Collector runs next to them). Both tools call it.
cat > /usr/local/lib/plone-in-a-box/compose-override <<'COMPOSE_OVERRIDE_EOF'
#!/bin/bash
# Writes /opt/plone/docker-compose.override.yml for what's on, and recreates
# the containers when it changed (not while a backup or update runs).
set -uo pipefail
STATE_DIR=/var/lib/plone-in-a-box
APP_DIR=/opt/plone
OVERRIDE=$APP_DIR/docker-compose.override.yml
# The OpenTelemetry Collector's image (plone-otel).
OTELCOL_IMAGE=otel/opentelemetry-collector-contrib:0.166.0
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
if [[ -e "$OVERRIDE" ]] && ! grep -qE '^# Written by (Plone in a Box|plone-syslog)' "$OVERRIDE"; then
  echo "$OVERRIDE wasn't written by Plone in a Box; leaving the containers as they are" >&2
  exit 1
fi
syslog=no otel=no
[[ -s "$STATE_DIR/syslog" ]] && syslog=yes
[[ -s "$STATE_DIR/otel" ]] && otel=yes
# plone-otel's request metrics need the backend-start script, which knows
# how the official backend image starts; another image starts as it is.
official_start=no
if [[ "$otel" == yes ]]; then
  image=$(docker compose --project-directory "$APP_DIR" -f "$APP_DIR/docker-compose.yml" config --format json 2>/dev/null |
          python3 -c 'import json, sys; print(json.load(sys.stdin)["services"]["backend"]["image"])' 2>/dev/null)
  [[ -n "$image" ]] && { docker image inspect "$image" >/dev/null 2>&1 || docker pull -q "$image" >/dev/null 2>&1; }
  [[ "$(docker image inspect -f '{{json .Config.Entrypoint}}' "$image" 2>/dev/null)" == '["/app/docker-entrypoint.sh"]' ]] && official_start=yes
fi
new=""
if [[ "$syslog" == yes || "$otel" == yes ]]; then
  new=$(
    echo "# Written by Plone in a Box for plone-syslog and plone-otel; they rewrite it"
    echo "# when turned on or off, so changes here don't last."
    if [[ "$syslog" == yes ]]; then
      echo "# plone-syslog: the containers log to journald, so their logs can be sent on"
      echo "# to the log server (docker compose logs still works)."
      printf 'x-logging-site: &site-logging\n  driver: journald\n  options:\n    tag: "{{.Name}}"\n'
    else
      printf 'x-logging-site: &site-logging\n  driver: json-file\n  options:\n    max-size: "10m"\n    max-file: "3"\n'
    fi
    echo "services:"
    [[ "$syslog" == yes ]] && printf '  frontend:\n    logging: *site-logging\n'
    echo "  backend:"
    [[ "$syslog" == yes ]] && echo "    logging: *site-logging"
    if [[ "$otel" == yes ]]; then
      cat <<'EOF'
    environment:
      # plone-otel: Plone's own numbers at /@@metrics, which only the server
      # itself can reach (nginx sends visitors to the site, not Zope's root).
      ADDONS: "${ADDONS:-} plone.observability<2"
      # Its health checks, inside the container only.
      PLONE_OBSERVABILITY_HEALTH_HOST: 127.0.0.1
EOF
      if [[ "$official_start" == yes ]]; then
        cat <<'EOF'
    # plone-otel: Plone's request times too, from a filter added to the
    # image's own zope.ini at each start (backend-start).
    entrypoint: ["/plone-in-a-box-start"]
    command: ["start"]
    volumes:
      - /usr/local/lib/plone-in-a-box/backend-start:/plone-in-a-box-start:ro
    # Docker's health check through plone.observability's health server,
    # whose answers aren't counted as requests (it would be most of them on
    # a quiet site); /ok if it isn't there.
    healthcheck:
      test: ["CMD-SHELL", "wget -q -O /dev/null http://127.0.0.1:8081/ready || wget -q -O - http://127.0.0.1:8080/ok | grep -q OK"]
EOF
      fi
    fi
    echo "  db:"
    [[ "$syslog" == yes ]] && echo "    logging: *site-logging"
    if [[ "$otel" == yes ]]; then
      cat <<EOF
    # plone-otel: for the Collector's PostgreSQL numbers; on the server only.
    ports:
      - "127.0.0.1:5432:5432"
  otel-collector:
    image: $OTELCOL_IMAGE
    # (The feature gate: PostgreSQL's numbers in the layout that becomes the
    # default, and without a warning at each start.)
    command: ["--config=/etc/otelcol/config.yaml", "--feature-gates=receiver.postgresql.separateSchemaAttr"]
    # The server's own network and processes, and its disks read-only, for
    # the server's numbers; it only sends, and listens on 127.0.0.1 only.
    network_mode: host
    pid: host
    env_file: $STATE_DIR/otel.env
    volumes:
      - $STATE_DIR/otelcol.yaml:/etc/otelcol/config.yaml:ro
      - /:/hostfs:ro
    mem_limit: 200m
    logging: *site-logging
    restart: unless-stopped
EOF
    fi
  )
fi
old=$(cat "$OVERRIDE" 2>/dev/null)
[[ "$new" == "$old" ]] && exit 0
if [[ -n "$new" ]]; then
  printf '%s\n' "$new" > "$OVERRIDE.new" && mv "$OVERRIDE.new" "$OVERRIDE"
else
  rm -f "$OVERRIDE"
fi
[[ "${1:-}" == --no-restart ]] && exit 0
exec 9>"$STATE_DIR/update.lock"
flock -w 3600 9 || { echo "A backup or update is still running; the containers change at its end or with: sudo docker compose --project-directory $APP_DIR up -d" >&2; exit 1; }
say "Restarting the site's containers with the new settings; the site is back in a minute or two"
docker compose --project-directory "$APP_DIR" up -d --remove-orphans --wait --wait-timeout 600 >/dev/null 2>&1 ||
  say "The site is taking long to come back: check sudo docker compose --project-directory $APP_DIR ps"
COMPOSE_OVERRIDE_EOF
chmod 755 /usr/local/lib/plone-in-a-box/compose-override

# The server's logs to a syslog server or service of your own: sudo
# plone-syslog on HOST:PORT. rsyslog collects them here and forwards them,
# keeping up to 100 MB while the log server can't be reached.
cat > /usr/local/bin/plone-syslog <<'PLONE_SYSLOG_EOF'
#!/bin/bash
# Sends the server's logs to a syslog server or service (Papertrail, Better
# Stack, your own rsyslog, ...): Plone, Volto and PostgreSQL, nginx's requests
# and errors, the Plone in a Box tools (backups, updates, ...), and the
# system's own (SSH logins, security updates). They also stay on the server.
# Usage: sudo plone-syslog on HOST:PORT [--tcp|--udp] [--ca FILE] [--sd ELEMENT|-] [--no-access-log]
#          TLS unless --tcp or --udp (unencrypted); --ca: the certificate
#          authority of a log server with a certificate of its own making;
#          --sd: a structured-data element some services want in every
#          message, with your token (- reads it, unshown, from the terminal);
#          --no-access-log: not one line per web request, which is most of
#          the volume (errors and everything else still go)
#        sudo plone-syslog off
#        sudo plone-syslog status
#        sudo plone-syslog test     (send a test message)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-syslog ${1:-}" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
CONF=/etc/rsyslog.d/60-plone-in-a-box-remote.conf
FILES_CONF=/etc/rsyslog.d/59-plone-in-a-box-files.conf
APPARMOR=/etc/apparmor.d/rsyslog.d/plone-in-a-box
NGINX_CONF=/etc/nginx/conf.d/plone-syslog.conf
# (Where rsyslog may read it: it runs as the syslog user, and Ubuntu's AppArmor
# profile for it allows /etc/rsyslog.d; only *.conf files there are settings.)
CA_COPY=/etc/rsyslog.d/plone-in-a-box-ca.pem
MARK="# Written by plone-syslog"
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
die() { echo "$*" >&2; exit 1; }

# The site's containers log to journald (rsyslog reads it from there), or
# back to their own files, as $STATE_DIR/syslog says. docker compose logs
# works either way. Recreating them restarts the site for a moment, so not
# while a backup or update runs.
containers() {
  /usr/local/lib/plone-in-a-box/compose-override || die "The containers weren't changed; see above"
}

case "${1:-}" in
on)
  target=${2:-}
  [[ "$target" =~ ^([A-Za-z0-9.-]+|\[[0-9A-Fa-f:]+\]):([0-9]{1,5})$ ]] || die "Give the log server as HOST:PORT, for example logs.example.org:6514"
  host=${BASH_REMATCH[1]} port=${BASH_REMATCH[2]}
  host=${host#[}; host=${host%]}
  protocol=tls ca="" sd="" requests=yes
  shift 2
  while (( $# )); do
    case "$1" in
      --tcp) protocol=tcp ;;
      --udp) protocol=udp ;;
      --ca) ca=${2:-}; shift ;;
      --sd) sd=${2:-}; shift ;;
      --no-access-log) requests=no ;;
      *) die "Unknown option $1" ;;
    esac
    shift
  done
  if [[ "$sd" == - ]]; then
    if [[ -t 0 ]]; then
      read -r -s -p "Structured-data element (not shown): " sd; echo
    else
      read -r sd
    fi
  fi
  # An RFC 5424 structured-data element, such as [TOKEN@41058] or
  # [logtail@11993 source_token="TOKEN"]: one line, in brackets.
  if [[ -n "$sd" && ! "$sd" =~ ^\[[^][:cntrl:]]+(\]\[[^][:cntrl:]]+)*\]$ ]]; then
    die "--sd takes a structured-data element in brackets, such as [TOKEN@41058], as your log service gives it"
  fi
  if [[ -n "$ca" ]]; then
    [[ "$protocol" == tls ]] || die "--ca is for TLS only"
    openssl x509 -in "$ca" -noout 2>/dev/null || die "$ca isn't a PEM certificate"
    install -m 644 "$ca" "$CA_COPY.new" && mv "$CA_COPY.new" "$CA_COPY"
  else
    rm -f "$CA_COPY"
  fi
  packages=(rsyslog)
  [[ "$protocol" == tls ]] && packages+=(rsyslog-gnutls)
  for p in "${packages[@]}"; do
    dpkg -s "$p" >/dev/null 2>&1 && continue
    DEBIAN_FRONTEND=noninteractive NEEDRESTART_SUSPEND=1 apt-get install -y -qq -o DPkg::Lock::Timeout=600 \
      "${packages[@]}" >/dev/null 2>&1 || die "Installing ${packages[*]} failed"
    break
  done
  # Reachable at all? (UDP can't tell.) With TLS: a certificate for that name,
  # from a known authority, or rsyslog would refuse it later without a word here.
  if [[ "$protocol" != udp ]] && ! timeout 10 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
    die "Can't connect to $host on port $port: check the address, and that a firewall in front of this server allows it out"
  fi
  if [[ "$protocol" == tls ]]; then
    cafile=/etc/ssl/certs/ca-certificates.crt
    [[ -s "$CA_COPY" ]] && cafile=$CA_COPY
    if ! timeout 20 openssl s_client -connect "$host:$port" -servername "$host" -verify_hostname "$host" \
         -CAfile "$cafile" -verify_return_error </dev/null >/dev/null 2>&1; then
      die "$host:$port doesn't have a valid TLS certificate for the name $host (for a log server with a certificate of its own making, give its authority with --ca FILE; to send unencrypted, --tcp)"
    fi
  fi

  # The Plone in a Box tools' own log files, and nginx's requests and errors,
  # through rsyslog too. Finding the tools' files means listing /var/log,
  # which Ubuntu's AppArmor profile for rsyslog doesn't allow by itself.
  if [[ -d /etc/apparmor.d/rsyslog.d ]]; then
    printf '%s\n/var/log/ r,\n' "$MARK: imfile finds /var/log/plone-*.log." > "$APPARMOR"
    apparmor_parser -r /etc/apparmor.d/usr.sbin.rsyslogd 2>/dev/null || true
  fi
  cat > "$FILES_CONF" <<'EOF'
# Written by plone-syslog: the Plone in a Box tools' log files.
module(load="imfile")
# (freshStartTail: from now on, not the files' whole history.)
input(type="imfile" File="/var/log/plone-*.log" Tag="plone-in-a-box:" Facility="local0" freshStartTail="on")
EOF
  { what="errors"; [[ "$requests" == yes ]] && what="requests and errors"
    echo "# Written by plone-syslog: $what to rsyslog too, which sends them on."
    [[ "$requests" == yes ]] && echo "access_log syslog:server=unix:/dev/log,tag=nginx,severity=info,nohostname combined;"
    echo "error_log syslog:server=unix:/dev/log,tag=nginx,nohostname warn;"; } > "$NGINX_CONF"
  nginx -t -q 2>/dev/null || { rm -f "$NGINX_CONF" "$FILES_CONF"; die "nginx didn't accept the syslog settings; nothing was changed"; }

  # Forwarding, with a queue on disk for when the log server is away.
  case "$protocol" in
    tls)
      # The name checked in the certificate: the host's, or the wildcard a
      # service's certificate may have instead (*.example.com for
      # logs.example.com).
      peers=$host
      [[ "$host" == *.*.* ]] && peers+=",*.${host#*.}"
      tls="StreamDriver=\"gtls\" StreamDriverMode=\"1\" StreamDriverAuthMode=\"x509/name\" StreamDriverPermittedPeers=\"$peers\""
      global="DefaultNetstreamDriverCAFile=\"$cafile\""
      proto=tcp ;;
    tcp) tls="" global="" proto=tcp ;;
    udp) tls="" global="" proto=udp ;;
  esac
  # The name the messages carry: the site's, rather than the server's own
  # (often just "localhost" on a cloud server).
  name=$(sed -E 's#^https?://##; s#[:/].*##' "$STATE_DIR/site-url" 2>/dev/null)
  [[ "$name" =~ ^[A-Za-z0-9.-]+$ ]] || name=$(hostname)
  # --no-access-log: the containers' own line per request too (Plone logs
  # one for each, as nginx does).
  request_filter=""
  # (rsyslog's own variables, not the shell's.)
  # shellcheck disable=SC2016
  [[ "$requests" == no ]] && request_filter='if $programname startswith "plone-" and re_match($msg, "\"(GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS) [^ ]* HTTP/[0-9.]+\" [0-9]{3}") then {
  stop
}'
  # RFC 5424, with the structured-data element if one was given (escaped for
  # an rsyslog string: backslashes, quotes and percent signs).
  template=RSYSLOG_SyslogProtocol23Format template_def=""
  if [[ -n "$sd" ]]; then
    esc=${sd//\\/\\\\}; esc=${esc//\"/\\\"}; esc=${esc//%/\\%}
    template=PloneInABoxRemote
    template_def="template(name=\"PloneInABoxRemote\" type=\"string\" string=\"<%PRI%>1 %TIMESTAMP:::date-rfc3339% %HOSTNAME% %APP-NAME% %PROCID% %MSGID% $esc%msg:::sp-if-no-1st-sp%%msg%\")"
  fi
  # Only root can read it: the structured data can hold a token.
  (umask 077; cat > "$CONF.new" <<EOF
$MARK: everything to $host:$port ($protocol${sd:+, with structured data}).
global(localHostname="$name" $global)
$template_def
# Not sent, to keep the volume down (both stay in the server's own logs): the
# backend's health check every 10 seconds, and the firewall's lines about the
# connections it blocks, which internet scanners cause all day.
if (\$programname startswith "plone-backend" and \$msg contains "GET /ok HTTP/1.1") or \$msg contains "[UFW BLOCK]" then {
  stop
}
$request_filter
*.* action(type="omfwd" target="$host" port="$port" protocol="$proto" $tls
           template="$template"
           queue.type="LinkedList" queue.filename="plone-in-a-box-remote" queue.maxDiskSpace="100m"
           queue.saveOnShutdown="on" action.resumeRetryCount="-1" action.resumeInterval="30")
EOF
  )
  mv "$CONF.new" "$CONF"
  if ! rsyslogd -N1 >/dev/null 2>&1; then
    rsyslogd -N1 2>&1 | tail -n 5
    rm -f "$CONF" "$FILES_CONF" "$NGINX_CONF"
    die "rsyslog didn't accept the settings (above); nothing was changed"
  fi
  printf '%s %s %s\n' "$protocol" "$host:$port" "$requests" > "$STATE_DIR/syslog"
  systemctl restart rsyslog
  systemctl reload nginx
  containers
  logger -t plone-in-a-box "plone-syslog: $(cat "$STATE_DIR/site-url" 2>/dev/null || hostname) now sends its logs here"
  say "On: the server's logs go to $host:$port ($protocol). A first message was sent; check that it arrived. Off again with: sudo plone-syslog off"
  ;;
off)
  rm -f "$CONF" "$FILES_CONF" "$NGINX_CONF" "$CA_COPY" "$STATE_DIR/syslog"
  if [[ -e "$APPARMOR" ]]; then
    rm -f "$APPARMOR"
    apparmor_parser -r /etc/apparmor.d/usr.sbin.rsyslogd 2>/dev/null || true
  fi
  nginx -t -q && systemctl reload nginx
  systemctl restart rsyslog 2>/dev/null
  containers
  say "Off: the logs stay on the server only"
  ;;
status)
  if [[ -s "$STATE_DIR/syslog" ]]; then
    read -r protocol target requests < "$STATE_DIR/syslog"
    echo "On: the server's logs go to $target ($protocol)$( [[ "$requests" == no ]] && echo ", without a line per web request")."
    queued=$(find /var/spool/rsyslog -name 'plone-in-a-box-remote.0*' -printf '%s\n' 2>/dev/null | awk '{ n += $1 } END { if (n) printf "%.1f MB", n / 1048576 }')
    [[ -n "$queued" ]] && echo "Waiting to be sent, because the log server didn't answer: $queued (see sudo journalctl -u rsyslog)"
  else
    echo "Off: the logs stay on the server. Turn it on with: sudo plone-syslog on HOST:PORT"
  fi
  ;;
test)
  [[ -s "$STATE_DIR/syslog" ]] || die "Sending logs isn't on. Turn it on with: sudo plone-syslog on HOST:PORT"
  logger -t plone-in-a-box "plone-syslog test message from $(cat "$STATE_DIR/site-url" 2>/dev/null || hostname) at $(date '+%F %T %Z')"
  echo "Sent a test message (tag plone-in-a-box); check that it arrived at $(cut -d' ' -f2 "$STATE_DIR/syslog")"
  ;;
*)
  sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
PLONE_SYSLOG_EOF
chmod 755 /usr/local/bin/plone-syslog

# The server's and Plone's numbers to an OpenTelemetry service: sudo plone-otel
# on ENDPOINT. An OpenTelemetry Collector container gathers them each minute.
cat > /usr/local/bin/plone-otel <<'PLONE_OTEL_EOF'
#!/bin/bash
# Sends the server's and the site's numbers (metrics) to an OpenTelemetry
# service (Grafana Cloud, New Relic, Honeycomb, your own Collector, ...),
# once a minute: the server's CPU, memory, disks and network; memory and CPU
# of Plone, Volto, PostgreSQL and nginx; Plone's own (plone.observability);
# PostgreSQL's; and nginx's connections.
# Usage: sudo plone-otel on ENDPOINT [--user ID | --header NAME]
#          ENDPOINT: the service's OTLP/HTTP address, such as
#          https://otlp-gateway-prod-eu-west-2.grafana.net/otlp;
#          --user: basic authentication with this user or instance ID
#          (Grafana Cloud), --header: the token goes in this header
#          (api-key for New Relic, x-honeycomb-team for Honeycomb); either
#          asks for the token, unshown
#        sudo plone-otel off
#        sudo plone-otel status   (where they go, and whether sending works)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-otel ${1:-}" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
APP_DIR=/opt/plone
CONF=$STATE_DIR/otelcol.yaml
ENV_FILE=$STATE_DIR/otel.env
NGINX_CONF=/etc/nginx/conf.d/plone-otel.conf
MARK="# Written by plone-otel"
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
die() { echo "$*" >&2; exit 1; }
compose() { docker compose --project-directory "$APP_DIR" "$@"; }
# PostgreSQL's numbers come from a login of their own, with only the
# pg_monitor role: it can read statistics, not the site's data.
pg() { compose exec -T -e PGOPTIONS='-c client_min_messages=warning' db psql -q -U plone -d plone -v ON_ERROR_STOP=1 >/dev/null; }

case "${1:-}" in
on)
  endpoint=${2:-}
  [[ "$endpoint" =~ ^https?://[][A-Za-z0-9.:-]+(/[A-Za-z0-9._~/-]*)?$ ]] || die "Give the service's OTLP endpoint, for example https://otlp-gateway-prod-eu-west-2.grafana.net/otlp"
  endpoint=${endpoint%/}
  auth=none user="" header=""
  shift 2
  while (( $# )); do
    case "$1" in
      --user) auth=basic user=${2:-}; shift ;;
      --header) auth=header header=${2:-}; shift ;;
      *) die "Unknown option $1" ;;
    esac
    shift
  done
  [[ "$auth" != basic || "$user" =~ ^[A-Za-z0-9._@-]+$ ]] || die "--user takes the user or instance ID your service gives"
  [[ "$auth" != header || "$header" =~ ^[A-Za-z0-9-]+$ ]] || die "--header takes a header name, such as api-key"
  token=""
  if [[ "$auth" != none ]]; then
    if [[ -t 0 ]]; then
      read -r -s -p "Token (not shown): " token; echo
    else
      read -r token
    fi
    [[ -n "$token" && "$token" != *[[:space:][:cntrl:]]* ]] || die "No token given"
  fi
  case "$auth" in
    basic) header=Authorization value="Basic $(printf '%s:%s' "$user" "$token" | base64 -w0)" ;;
    header) value=$token ;;
    none) value="" ;;
  esac

  # Does the service take them? An empty batch of metrics is a valid one.
  args=(-s -o /dev/null -w '%{http_code}' -m 20 -X POST -H 'Content-Type: application/x-protobuf' --data-binary '')
  code=$(if [[ -n "$header" ]]; then printf 'header = "%s: %s"\n' "$header" "$value"; fi |
         curl "${args[@]}" -K - "$endpoint/v1/metrics")
  case "$code" in
    2??) ;;
    401|403) die "$endpoint didn't accept the token (HTTP $code): check it, and the user or header" ;;
    000) die "Can't reach $endpoint: check the address, and that a firewall in front of this server allows it out" ;;
    *) die "$endpoint answered HTTP $code instead of accepting metrics: check the address (often ending in /otlp)" ;;
  esac

  # nginx's connection counts, on the server only.
  printf '%s: nginx connections for the Collector, on this server only.\nserver {\n  listen 127.0.0.1:8091;\n  access_log off;\n  location = /nginx_status { stub_status; }\n  location / { return 404; }\n}\n' "$MARK" > "$NGINX_CONF"
  nginx -t -q 2>/dev/null || { rm -f "$NGINX_CONF"; die "nginx didn't accept the status page; nothing was changed"; }
  systemctl reload nginx

  pg_password=$(openssl rand -hex 24)
  pg <<EOF || die "Couldn't create PostgreSQL's monitoring login; nothing else was changed"
DO \$\$ BEGIN
  IF EXISTS (SELECT FROM pg_roles WHERE rolname = 'otel') THEN
    ALTER ROLE otel LOGIN PASSWORD '$pg_password';
  ELSE
    CREATE ROLE otel LOGIN PASSWORD '$pg_password';
  END IF;
END \$\$;
GRANT pg_monitor TO otel;
EOF

  # The name the numbers carry: the site's.
  name=$(sed -E 's#^https?://##; s#[:/].*##' "$STATE_DIR/site-url" 2>/dev/null)
  [[ "$name" =~ ^[A-Za-z0-9.-]+$ ]] || name=$(hostname)
  # Secrets only in the environment file, which only root can read.
  (umask 077; printf 'OTLP_ENDPOINT=%s\nOTLP_AUTH=%s\nPG_PASSWORD=%s\n' "$endpoint" "$value" "$pg_password" > "$ENV_FILE")
  headers=""
  [[ -n "$header" ]] && headers="    headers:
      $header: \${env:OTLP_AUTH}"
  cat > "$CONF" <<EOF
$MARK: the server's and the site's numbers to $endpoint.
receivers:
  host_metrics:
    root_path: /hostfs
    collection_interval: 60s
    scrapers:
      cpu: {}
      load: {}
      memory:
        metrics:
          system.memory.limit:
            enabled: true
      paging: {}
      disk: {}
      network: {}
      filesystem:
        include_mount_points:
          mount_points: ["/"]
          match_type: strict
      # Plone (runwsgi), Volto (node, which names itself MainThread),
      # PostgreSQL and nginx.
      process:
        include:
          names: ["^(runwsgi|node|MainThread|postgres|nginx)$"]
          match_type: regexp
        mute_process_name_error: true
        mute_process_exe_error: true
        mute_process_io_error: true
        mute_process_user_error: true
        mute_process_cgroup_error: true
  postgresql:
    endpoint: 127.0.0.1:5432
    transport: tcp
    username: otel
    password: \${env:PG_PASSWORD}
    databases: [plone]
    collection_interval: 60s
    tls:
      insecure: true
  nginx:
    endpoint: http://127.0.0.1:8091/nginx_status
    collection_interval: 60s
  prometheus:
    config:
      scrape_configs:
        - job_name: plone
          scrape_interval: 60s
          metrics_path: /@@metrics
          static_configs:
            - targets: ["127.0.0.1:8080"]
processors:
  memory_limiter:
    check_interval: 5s
    limit_mib: 150
    spike_limit_mib: 30
  # Each process's numbers by what it is (plone, volto, postgres, nginx),
  # added up over its processes (PostgreSQL and nginx run several), rather
  # than one set per process ID.
  transform/processes:
    error_mode: ignore
    metric_statements:
      - context: datapoint
        conditions:
          - resource.attributes["process.executable.name"] != nil
        statements:
          - set(attributes["process"], resource.attributes["process.executable.name"])
          - replace_pattern(attributes["process"], "^runwsgi\$", "plone")
          - replace_pattern(attributes["process"], "^(node|MainThread)\$", "volto")
      - context: resource
        statements:
          - delete_matching_keys(attributes, "^process[.]")
  groupbyattrs/processes: {}
  metrics_transform/processes:
    transforms:
      - include: ^process[.]
        match_type: regexp
        action: update
        operations:
          - action: aggregate_labels
            label_set: [process, state, direction]
            aggregation_type: sum
  # Every number labeled with the site (job plone-in-a-box, instance the
  # site's name), so a dashboard can tell sites apart.
  resource:
    attributes:
      - { key: host.name, value: "$name", action: upsert }
      - { key: service.name, value: plone-in-a-box, action: upsert }
      - { key: service.instance.id, value: "$name", action: upsert }
  batch: {}
exporters:
  otlp_http:
    endpoint: \${env:OTLP_ENDPOINT}
$headers
service:
  telemetry:
    logs:
      level: warn
    # Its own counts of what was sent, for plone-otel status.
    metrics:
      level: basic
      readers:
        - pull:
            exporter:
              prometheus:
                host: 127.0.0.1
                port: 18888
  pipelines:
    metrics:
      receivers: [host_metrics, postgresql, nginx, prometheus]
      processors: [memory_limiter, transform/processes, groupbyattrs/processes, metrics_transform/processes, resource, batch]
      exporters: [otlp_http]
EOF
  chmod 644 "$CONF"
  # The Collector checks its settings before anything changes.
  image=$(sed -n 's/^OTELCOL_IMAGE=//p' /usr/local/lib/plone-in-a-box/compose-override)
  if ! out=$(docker run --rm --env-file "$ENV_FILE" -v "$CONF:/etc/otelcol/config.yaml:ro" -v /:/hostfs:ro "$image" \
       validate --config=/etc/otelcol/config.yaml --feature-gates=receiver.postgresql.separateSchemaAttr 2>&1); then
    tail -n 3 <<<"$out" >&2
    die "The Collector didn't accept its settings (above); the site wasn't changed"
  fi
  printf '%s\n' "$endpoint" > "$STATE_DIR/otel"
  /usr/local/lib/plone-in-a-box/compose-override || die "The containers weren't changed; see above"
  # When it was on already: the Collector with the new settings.
  compose up -d --force-recreate otel-collector >/dev/null 2>&1 || die "The Collector didn't start: see sudo docker compose --project-directory $APP_DIR logs otel-collector"
  say "On: the server's and the site's numbers go to $endpoint once a minute. Check in a few minutes with: sudo plone-otel status. Off again with: sudo plone-otel off"
  ;;
off)
  rm -f "$STATE_DIR/otel"
  /usr/local/lib/plone-in-a-box/compose-override || exit 1
  rm -f "$CONF" "$ENV_FILE" "$NGINX_CONF"
  nginx -t -q 2>/dev/null && systemctl reload nginx
  pg <<<"DROP ROLE IF EXISTS otel;" || true
  say "Off: the numbers aren't sent any more"
  ;;
status)
  if [[ ! -s "$STATE_DIR/otel" ]]; then
    echo "Off. Turn it on with: sudo plone-otel on ENDPOINT"
    exit 0
  fi
  echo "On: the server's and the site's numbers go to $(cat "$STATE_DIR/otel")."
  counts=$(curl -fsS -m 5 http://127.0.0.1:18888/metrics 2>/dev/null)
  if [[ -z "$counts" ]]; then
    echo "The Collector isn't running: see sudo docker compose --project-directory $APP_DIR logs otel-collector"
    exit 1
  fi
  # (With or without _total, which newer Collectors leave off.)
  sum() { awk -v m="$1" '$1 ~ "^"m"(_total)?(\\{|$)" { n += $2 } END { printf "%d", n }' <<<"$counts"; }
  sent=$(sum otelcol_exporter_sent_metric_points)
  failed=$(sum otelcol_exporter_send_failed_metric_points)
  echo "Since the Collector started: $sent values sent, $failed failed."
  if (( failed > 0 )); then
    echo "Its latest errors:"
    compose logs --no-log-prefix --since 1h otel-collector 2>/dev/null | grep -iE 'error|fail' | tail -n 3
  fi
  ;;
*)
  sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
PLONE_OTEL_EOF
chmod 755 /usr/local/bin/plone-otel

# HTTPS for a site without a domain name: a Let's Encrypt certificate for the
# server's IP address. Setup runs it; plone-https-ip.timer renews it.
cat > /usr/local/bin/plone-https-ip <<'PLONE_HTTPS_IP_EOF'
#!/bin/bash
# HTTPS for a site without a domain name: a Let's Encrypt certificate for the
# server's IPv4 address. These last about 6 days, so plone-https-ip.timer runs
# this twice a day and renews when 3 days are left; a notice goes out if
# renewing keeps failing. A site with a domain name has its own certificate.
# Usage: sudo plone-https-ip        (get or renew the certificate, and turn HTTPS on)
#        sudo plone-https-ip off    (back to HTTP only)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-https-ip" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
WEBROOT=/var/www/letsencrypt
# Certbot from its official image: Ubuntu 26.04's (4.0) is too old for IP
# addresses. plone-update pulls newer builds every week.
IMAGE=certbot/certbot:latest
NAME=plone-ip
LIVE=/etc/letsencrypt/live/$NAME
HTTP_SNIPPET=/etc/nginx/snippets/plone-http.conf
HTTPS_SITE=/etc/nginx/sites-available/plone-https
mkdir -p "$STATE_DIR"
exec > >(tee -a /var/log/plone-https-ip.log) 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
reload() { nginx -t -q && systemctl reload nginx; }

if [[ "$(awk '$1 == "server_name" { print $2; exit }' /etc/nginx/sites-available/plone)" != "_;" ]]; then
  say "This server has a domain name, so it doesn't need an IP address certificate"
  exit 0
fi
IP=$(curl -fsS -4 -m 20 https://ifconfig.me 2>/dev/null || true)
[[ "$IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { say "Couldn't find this server's public IPv4 address; trying again later"; exit 1; }

if [[ "${1:-}" == off ]]; then
  systemctl disable --now plone-https-ip.timer 2>/dev/null
  printf 'include snippets/plone-site.conf;\n' > "$HTTP_SNIPPET"
  rm -f /etc/nginx/sites-enabled/plone-https
  reload
  # The certificate too, so a domain's certificate (Ubuntu's certbot, which
  # renews every certificate it finds and can't do IP addresses) starts clean.
  if [[ -d "$LIVE" ]]; then
    docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt \
      "$IMAGE" delete --cert-name "$NAME" --non-interactive </dev/null >/dev/null 2>&1 \
      && say "Deleted the certificate for the IP address"
  fi
  echo "http://$IP" > "$STATE_DIR/site-url"
  say "HTTPS is off; the site is at http://$IP. Turn it back on with: sudo plone-https-ip"
  exit 0
fi

# Hours the current certificate has left, if it's for this address.
left=0
if [[ -s "$LIVE/fullchain.pem" ]] && openssl x509 -in "$LIVE/fullchain.pem" -noout -ext subjectAltName 2>/dev/null | grep -q "IP Address:$IP\b"; then
  end=$(openssl x509 -in "$LIVE/fullchain.pem" -noout -enddate | cut -d= -f2)
  left=$(( ($(date -d "$end" +%s) - $(date +%s)) / 3600 ))
fi
# (PLONE_HTTPS_RENEW_HOURS: for tests, to renew sooner.)
if (( left < ${PLONE_HTTPS_RENEW_HOURS:-72} )); then
  say "Requesting a certificate for $IP (the current one has ${left}h left)"
  install -d -m 755 "$WEBROOT"
  staging=()
  [[ -e "$STATE_DIR/https-ip-staging" ]] && staging=(--staging)
  if docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt \
       -v "$WEBROOT:$WEBROOT" "$IMAGE" certonly --webroot -w "$WEBROOT" --ip-address "$IP" \
       --preferred-profile shortlived --cert-name "$NAME" --non-interactive --agree-tos \
       --register-unsafely-without-email --force-renewal "${staging[@]}" </dev/null; then
    say "Got a certificate for $IP"
    left=999
  else
    say "Getting a certificate for $IP failed (the reason is above)"
    if (( left > 0 && left < 24 )); then
      /usr/local/lib/plone-in-a-box/notify "Plone in a Box: HTTPS certificate expiring (https://$IP)" \
        "The HTTPS certificate for https://$IP expires within a day, and renewing it is failing. The log is in /var/log/plone-https-ip.log on the server; try again with: sudo plone-https-ip" >/dev/null 2>&1 </dev/null
    fi
    (( left > 0 )) || exit 1
  fi
fi

# HTTPS on: the site on port 443, and HTTP redirecting to it (Let's Encrypt's
# checks still get through on port 80).
cat > "$HTTPS_SITE" <<EOF
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name _;
  ssl_certificate $LIVE/fullchain.pem;
  ssl_certificate_key $LIVE/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  include snippets/plone-headers.conf;
  include snippets/plone-site.conf;
}
EOF
ln -sf "$HTTPS_SITE" /etc/nginx/sites-enabled/plone-https
# (nginx's own variables, not the shell's.)
# shellcheck disable=SC2016
printf 'location / {\n  return 301 https://$host$request_uri;\n}\n' > "$HTTP_SNIPPET"
if reload; then
  echo "https://$IP" > "$STATE_DIR/site-url"
  systemctl enable --now plone-https-ip.timer 2>/dev/null
  say "HTTPS is on: https://$IP"
else
  say "nginx didn't accept the HTTPS settings; staying on HTTP"
  printf 'include snippets/plone-site.conf;\n' > "$HTTP_SNIPPET"
  rm -f /etc/nginx/sites-enabled/plone-https
  reload
  exit 1
fi
PLONE_HTTPS_IP_EOF
chmod 755 /usr/local/bin/plone-https-ip
cat > /etc/systemd/system/plone-https-ip.service <<'EOF'
[Unit]
Description=Plone in a Box: renew the HTTPS certificate for the server's IP address
After=network-online.target docker.service nginx.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/plone-https-ip
EOF
cat > /etc/systemd/system/plone-https-ip.timer <<'EOF'
[Unit]
Description=Renew the HTTPS certificate for the server's IP address twice a day

[Timer]
OnCalendar=*-*-* 00,12:00:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF
cat > /etc/systemd/system/plone-backup.service <<'EOF'
[Unit]
Description=Plone in a Box: database backup, and a weekly pack
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/plone-backup
TimeoutStartSec=4h
EOF
cat > /etc/systemd/system/plone-backup.timer <<'EOF'
