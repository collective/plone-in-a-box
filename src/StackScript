// The actions that run in the background, as systemd services: the page
// follows them until they finish, then says how it went.
var BACKGROUND = {
  "backup": { running: "Backing up your site\u2026",
              done: function (s) { return "Backed up " + local(s.backups.newest_iso, s.backups.newest) + "."; },
              failed: "The backup failed. If notifications or email are set up, a notice is on its way." },
  "restore-test": { running: "Running the restore test\u2026 This takes a few minutes.",
                    done: function (s) { return "Restore test: " + restoreTest(s.backups, false); },
                    failed: "The restore test failed. If notifications or email are set up, a notice is on its way." }
};
function run(action, question, button) {
  if (question && !window.confirm(question)) return;
  var result = document.getElementById("result");
  button.disabled = true;
  result.textContent = "Working\u2026";
  api("do/" + action, true)
    .then(function (out) {
      if (BACKGROUND[action]) { follow(action, button); return; }
      button.disabled = false;
      result.textContent = out.message;
      check();
    })
    .catch(function (e) { button.disabled = false; result.textContent = e.message; });
}
// Every few seconds: is it still running?
function follow(action, button) {
  var job = BACKGROUND[action], result = document.getElementById("result");
  var cards = document.getElementById("cards");
  result.textContent = job.running;
  if (button) button.disabled = true;
  cards.classList.add("checking");
  function poll() {
    api("job/" + action)
      .then(function (j) {
        if (j.state === "activating" || j.state === "active" || j.state === "deactivating") {
          setTimeout(poll, 3000);
          return;
        }
        cards.classList.remove("checking");
        check(function (s) {
          if (button) button.disabled = false;
          result.textContent = j.result === "success" ? job.done(s) : job.failed;
        });
      })
      .catch(function () { cards.classList.remove("checking"); if (button) button.disabled = false; result.textContent = ""; });
  }
  setTimeout(poll, 1500);
}
// Checking takes a second or two: the button says so, and the cards fade
// until the new ones are in.
function check(then) {
  var again = document.getElementById("again"), cards = document.getElementById("cards");
  var started = Date.now();
  again.disabled = true;
  again.textContent = "Checking\u2026";
  cards.classList.add("checking");
  document.getElementById("when").textContent = "";
  function done() {
    again.disabled = false;
    again.textContent = "Check again";
    cards.classList.remove("checking");
  }
  api("status")
    .then(function (s) {
      // At least half a second, so the change can be seen.
      setTimeout(function () {
        show(s);
        done();
        if (then) then(s);
      }, Math.max(0, 500 - (Date.now() - started)));
    })
    .catch(function (e) { done(); document.getElementById("lead").textContent = "Couldn't check: " + e.message; });
}
document.getElementById("again").addEventListener("click", function () { check(); });
// A backup or restore test already running (from another tab, or the nightly
// one) is followed too.
check(function () {
  Object.keys(BACKGROUND).forEach(function (action) {
    api("job/" + action).then(function (j) { if (j.state === "activating") follow(action, null); });
  });
});
