Description=Nightly Plone in a Box database backup

[Timer]
# Shortly after midnight (server time, usually UTC), at a random time within
# an hour, before the weekly update early on Sunday.
OnCalendar=*-*-* 00:15:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
EOF

cat > /etc/systemd/system/plone-backup-check.service <<'EOF'
[Unit]
Description=Plone in a Box: check that a backup can be restored
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/plone-backup-check
TimeoutStartSec=4h
EOF
cat > /etc/systemd/system/plone-backup-check.timer <<'EOF'
[Unit]
Description=Monthly Plone in a Box restore test

[Timer]
# The first Wednesday of the month (server time, usually UTC), after the
# nightly backup and restart, at a random time within an hour.
OnCalendar=Wed *-*-01..07 04:30:00
RandomizedDelaySec=1h
Persistent=true

[Install]
