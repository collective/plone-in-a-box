// Plain words from plone-status --json, which /api/status passes on.
function card(title, text, level) {
  var div = document.createElement("div");
  div.className = "card " + (level || "");
  var h = document.createElement("h2");
  h.textContent = title;
  var p = document.createElement("p");
  p.textContent = text;
  div.appendChild(h);
  div.appendChild(p);
  return div;
}
function onoff(v) { return v ? "on" : "off"; }
// A time from the server, in the viewer's own time zone, which it names.
function local(isoTime, fallback) {
  var d = isoTime ? new Date(isoTime) : null;
  if (!d || isNaN(d)) return fallback;
  var today = new Date(), yesterday = new Date(Date.now() - 864e5);
  var day = d.toDateString() === today.toDateString() ? "today"
    : d.toDateString() === yesterday.toDateString() ? "yesterday"
    : d.toLocaleDateString([], { weekday: "short", month: "short", day: "numeric" });
  return day + " at " + d.toLocaleTimeString([], { hour: "numeric", minute: "2-digit", timeZoneName: "short" });
}
// The restore test, with its times in the viewer's time zone.
function restoreTest(b, withWhen) {
  if (!b.restore_test_summary) return b.restore_test;
  var text = b.restore_test_summary;
  if (b.restore_test_backup && b.restore_test_backup_iso)
    text = text.replace(b.restore_test_backup, "from " + local(b.restore_test_backup_iso, b.restore_test_backup));
  return withWhen ? local(b.restore_test_iso, b.restore_test_date) + ": " + text : text;
}
function show(s) {
  var cards = document.getElementById("cards");
  cards.textContent = "";
  var parts = Object.keys(s.parts || {}).sort();
  var down = parts.filter(function (n) { var p = s.parts[n]; return p.state !== "running" || (p.health && p.health !== "healthy"); });
  var b = s.backups || {}, u = s.updates || {}, f = s.features || {}, d = s.disk || {}, m = s.memory || {}, v = s.versions || {};
  var problems = [];
  if (!s.site.ok) problems.push("the site isn't answering");
  if (down.length) problems.push(down.join(", ") + " not running well");
  if (d.used_percent >= 90) problems.push("the disk is nearly full");
  if (b.newest_age_hours > 48 || !b.count) problems.push("no recent backup");
  if (/FAILED/.test(b.restore_test || "")) problems.push("the last restore test failed");
  document.getElementById("lead").textContent = problems.length
    ? "Needs a look: " + problems.join("; ") + "."
    : "All good: your site is working and backed up.";
  cards.appendChild(card("Your site", s.site.url + (s.site.ok ? ", working" : ", not answering (" + s.site.http_status + ")"), s.site.ok ? "ok" : "bad"));
  cards.appendChild(card("Parts", parts.length ? parts.map(function (n) {
    var p = s.parts[n]; return n + ": " + p.state + (p.health ? " (" + p.health + ")" : "");
  }).join(", ") : "unknown", parts.length && !down.length ? "ok" : "bad"));
  cards.appendChild(card("Versions", "Plone " + v.plone + ", Volto " + v.volto + ", PostgreSQL " + v.postgresql));
  cards.appendChild(card("Disk", d.used_percent + "% used, " + d.free_gb + " GB free", d.used_percent >= 90 ? "bad" : d.used_percent >= 80 ? "warn" : "ok"));
  cards.appendChild(card("Memory", m.used_mb + " MB of " + m.total_mb + " MB in use"));
  cards.appendChild(card("Last backup", (b.count ? local(b.newest_iso, b.newest) + " (" + b.newest_mb + " MB)" : "none yet") +
    "; nightly backups " + onoff(b.nightly) + ", offsite copies " + onoff(b.offsite),
    !b.count || b.newest_age_hours > 48 ? "bad" : b.offsite ? "ok" : "warn"));
  cards.appendChild(card("Restore test", restoreTest(b, true), /FAILED/.test(b.restore_test || "") ? "bad" : b.restore_test_ok ? "ok" : ""));
  cards.appendChild(card("Updates", (u.last_iso ? local(u.last_iso, u.last) + ": " + u.last_summary : u.last) + "; automatic updates " + onoff(u.automatic), u.automatic ? "ok" : "warn"));
  cards.appendChild(card("Notifications", f.notifications ? "sent to " + f.notifications : "off", f.notifications ? "ok" : "warn"));
  cards.appendChild(card("Email", f.email ? "from " + f.email : "not set up when the server was created (see Site Setup > Mail)"));
  cards.appendChild(card("Logs", f.logs ? "sent to " + f.logs : "on the server only"));
  cards.appendChild(card("Graphs", f.graphs ? "sent to " + f.graphs : "off"));
  cards.appendChild(card("Cloudflare", f.cloudflare ? "on: only Cloudflare reaches your site" : "off"));
  if (s.security_notice) cards.appendChild(card("Security", s.security_notice, "warn"));
  document.getElementById("when").textContent = "Checked " + local(new Date().toISOString(), "just now");
  actions(s);
}
// The buttons: each runs one fixed command (plone-panel do ...).
function actions(s) {
  var f = s.features || {}, list = [
    ["backup", "Back up now", true],
    ["restore-test", "Run the restore test", true],
    ["test-notification", "Send a test notification", !!f.notifications],
    ["test-email", "Send a test email", !!f.email],
    ["logs-off", "Stop sending logs", !!f.logs, "Stop sending the logs to " + f.logs + "? They'll stay on the server only."],
    ["graphs-off", "Stop sending graphs", !!f.graphs, "Stop sending numbers to " + f.graphs + "?"],
    ["demo-password", "New demo password", !!f.demo_user, "Make a new password for the demo login " + f.demo_user + "? The old one stops working."]
  ];
  var box = document.getElementById("actions");
  box.textContent = "";
  list.forEach(function (a) {
    if (!a[2]) return;
    var b = document.createElement("button");
    b.type = "button";
    b.textContent = a[1];
    b.addEventListener("click", function () { run(a[0], a[3], b); });
    box.appendChild(b);
  });
}
function api(path, post) {
  return fetch("api/" + path, post ? { method: "POST", headers: { "X-Plone-Panel": "1" } } : {})
    .then(function (r) {
      return r.json().catch(function () { return {}; }).then(function (body) {
        if (!r.ok) throw new Error(body.message || body.error || "The server answered " + r.status);
        return body;
      });
    });
