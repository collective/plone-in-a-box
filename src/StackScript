systemctl daemon-reload
# <<< update tools

cd "$APP_DIR"
compose() { docker compose --project-directory "$APP_DIR" "$@"; }

progress 4
# A backend image that can't be pulled, or doesn't run like the official one
# (checked once PostgreSQL is up), is left out, so the site still starts with
# the official backend. Its label org.plone-in-a-box.site-env can add SITE_*
# settings for creating the site, such as SITE_SETUP_CONTENT=false.
SITE_ENV=()
backend_fallback() {  # backend_fallback <what happened>
  log "$1; using the official Plone backend"
  BACKEND_NOTE="$1, so the site uses the official Plone backend. The reason is in /var/log/plone-in-a-box.log."
  BACKEND_IMAGE=""
  SITE_ENV=()
  sed -i "s/^BACKEND_IMAGE=.*/BACKEND_IMAGE=''/" "$APP_DIR/.env"
}
# Log in to the registries of private images, with the one login given.
REGISTRY_LINE=""
if [[ -n "$REGISTRY_USER" && -n "$REGISTRY_TOKEN" ]]; then
  registries=""
  for image in "$FRONTEND_IMAGE" "$BACKEND_IMAGE"; do
    [[ -n "$image" ]] || continue
    host=${image%%/*}
    # Docker Hub images (owner/name:tag) don't name their registry.
    if [[ "$image" != */* || ( "$host" != *.* && "$host" != *:* && "$host" != localhost ) ]]; then
      host=docker.io
    fi
    [[ " $registries " == *" $host "* ]] || registries+="${registries:+ }$host"
  done
  for host in $registries; do
    if printf '%s' "$REGISTRY_TOKEN" | docker login "$host" --username "$REGISTRY_USER" --password-stdin >/dev/null 2>&1; then
      log "Logged in to ${host} as ${REGISTRY_USER}"
      REGISTRY_LINE+="${REGISTRY_LINE:+$'\n'}Registry:  logged in to ${host} as ${REGISTRY_USER}, for pulling the images (the login is in /root/.docker/config.json)"
    else
      log "Logging in to ${host} as ${REGISTRY_USER} failed: check the username and token"
      REGISTRY_LINE+="${REGISTRY_LINE:+$'\n'}Registry:  logging in to ${host} as ${REGISTRY_USER} failed, so its private images couldn't be pulled: check the username and token"
    fi
  done
  [[ -n "$registries" ]] || log "Not logging in to a registry: there's no frontend or backend image"
elif [[ -n "$REGISTRY_USER$REGISTRY_TOKEN" ]]; then
  log "Not logging in to a registry: it needs both the registry username and the token"
  REGISTRY_LINE="Registry:  not logged in: it needs both the username and the token"
fi
export -n REGISTRY_TOKEN

if [[ -n "$BACKEND_IMAGE" ]]; then
  log "Pulling the backend image ${BACKEND_IMAGE}"
  if docker pull --quiet "$BACKEND_IMAGE"; then
    for pair in $(docker image inspect -f '{{index .Config.Labels "org.plone-in-a-box.site-env"}}' "$BACKEND_IMAGE" 2>/dev/null); do
      [[ "$pair" =~ ^SITE_[A-Z0-9_-]+=[A-Za-z0-9.,:/_@-]*$ ]] && SITE_ENV+=(-e "$pair")
    done
  else
    backend_fallback "The backend image ${BACKEND_IMAGE} couldn't be pulled"
  fi
fi

# A frontend image that can't be pulled (misspelled, private, gone) is left
# out, so the site still starts with the standard Volto image. A ready-made
# image's labels name the backend add-ons and site behaviors it needs.
IMAGE_ADDONS="" IMAGE_BEHAVIORS="" IMAGE_DEMO_ROLES="" IMAGE_ACTIVATED=0
if [[ -n "$FRONTEND_IMAGE" ]]; then
  log "Pulling the frontend image ${FRONTEND_IMAGE}"
  if docker pull --quiet "$FRONTEND_IMAGE"; then
    label() { docker image inspect -f "{{index .Config.Labels \"org.plone-in-a-box.$1\"}}" "$FRONTEND_IMAGE" 2>/dev/null || true; }
    for addon in $(label backend-addons); do
      if valid_addon "$addon"; then
        IMAGE_ADDONS+="${IMAGE_ADDONS:+ }$addon"
      fi
    done
    # Not again if setup runs a second time with the same .env.
    missing=""
    for addon in $IMAGE_ADDONS; do
      [[ " $ADDONS " == *" $addon "* ]] || missing+="${missing:+ }$addon"
    done
    # The roles a demo login needs to try the image's add-ons, separated by
    # commas (used when DEMO_ROLES is empty).
    IMAGE_DEMO_ROLES="$(label demo-roles | tr -cd 'A-Za-z0-9 ,._-')"
    for behavior in $(label site-behaviors); do
      if [[ "$behavior" =~ ^[A-Za-z0-9._-]+$ ]]; then
        IMAGE_BEHAVIORS+="${IMAGE_BEHAVIORS:+ }$behavior"
      fi
    done
    if [[ -n "$IMAGE_ADDONS" ]]; then
      log "The frontend image needs the backend add-ons ${IMAGE_ADDONS}"
      if [[ -n "$missing" ]]; then
        ADDONS="${ADDONS:+$ADDONS }${missing}"
        sed -i "s/^ADDONS=.*/ADDONS='${ADDONS}'/" "$APP_DIR/.env"
      fi
    fi
  else
    log "The frontend image ${FRONTEND_IMAGE} couldn't be pulled; using the standard Volto image"
    FRONTEND_NOTE="The frontend image ${FRONTEND_IMAGE} couldn't be pulled, so the site uses the standard Volto image. The reason is in /var/log/plone-in-a-box.log."
    FRONTEND_IMAGE=""
    sed -i "s/^FRONTEND_IMAGE=.*/FRONTEND_IMAGE=''/" "$APP_DIR/.env"
  fi
fi
log "Pulling images (${BACKEND_IMAGE:-Plone ${PLONE_VERSION}}, ${FRONTEND_IMAGE:-Volto ${VOLTO_VERSION}}, PostgreSQL ${POSTGRES_VERSION})"
compose pull --quiet

# A misspelled or incompatible add-on would stop the backend from starting,
# so try installing the add-ons in a throwaway container first, and leave
# them out if that fails.
if [[ -n "$ADDONS" ]]; then
  log "Checking that the backend add-ons install: ${ADDONS}"
  if ! compose run --rm --no-deps backend true; then
    log "The backend add-ons couldn't be installed (see the pip messages above); continuing without them"
    ADDONS_NOTE="The add-ons ($ADDONS) couldn't be installed, so the site runs without them. The reason is in /var/log/plone-in-a-box.log."
    ADDONS=""
    sed -i "s/^ADDONS=.*/ADDONS=''/" "$APP_DIR/.env"
    # The frontend image needs its backend half; without it, use the standard one.
    if [[ -n "$IMAGE_ADDONS" ]]; then
      log "The frontend image ${FRONTEND_IMAGE} needs those add-ons; using the standard Volto image"
      FRONTEND_NOTE="The frontend image ${FRONTEND_IMAGE} needs backend add-ons that couldn't be installed, so the site uses the standard Volto image."
      FRONTEND_IMAGE="" IMAGE_ADDONS="" IMAGE_BEHAVIORS="" IMAGE_DEMO_ROLES=""
      sed -i "s/^FRONTEND_IMAGE=.*/FRONTEND_IMAGE=''/" "$APP_DIR/.env"
    fi
  fi
fi

progress 5
log "Starting PostgreSQL"
compose up -d --wait db

# The backend image runs Plone with this stack's settings: start it once with
# an empty script, which also connects to the database.
if [[ -n "$BACKEND_IMAGE" ]]; then
  log "Checking that the backend image ${BACKEND_IMAGE} runs Plone here"
  if ! compose run --rm --no-deps -T -e ADDONS= -v /dev/null:/tmp/empty.py:ro backend run /tmp/empty.py </dev/null; then
    backend_fallback "The backend image ${BACKEND_IMAGE} didn't run Plone with this server's settings"
    compose pull --quiet backend
  fi
fi

set_admin_password() {
  log "Setting the Zope admin password"
  NEW_ADMIN_PASSWORD="$ADMIN_PASSWORD" compose run --rm --no-deps \
    -e NEW_ADMIN_PASSWORD -e ADDONS= \
    -v "$APP_DIR/set_admin_password.py:/app/scripts/set_admin_password.py:ro" \
    backend run /app/scripts/set_admin_password.py
}
if [[ "$NEW_ADMIN_PASSWORD_SET" == 0 ]]; then
  set_admin_password
fi

log "Creating the Plone site (skipped if it already exists)"
# The same settings for any backend image, under the names the official
# image's create-site and plone.distribution sites read; an image ignores the
# ones it doesn't know. There's no Solr in the box.
content=true CONTENT_NOTE=""
if [[ "$STARTER_CONTENT" == no ]]; then
  content=false CONTENT_NOTE=", created without starter content"
fi
# A distribution's image (kitconcept's, cookieplone projects) reads its
# answers from /app/scripts/default.json, and its SITE_* variables only change
# answers that file has; kitconcept's can't take SITE_SETUP_CONTENT at all. So
# it gets a copy of its own file with the starter content and no Solr.
ANSWERS_MOUNT=()
if [[ -n "$BACKEND_IMAGE" ]] \
  && docker run --rm --entrypoint cat "$BACKEND_IMAGE" /app/scripts/default.json > "$APP_DIR/site-answers.json" 2>/dev/null \
  && python3 - "$APP_DIR/site-answers.json" "$content" <<'EOF'
import json, sys
path, content = sys.argv[1], sys.argv[2] == "true"
answers = json.load(open(path))
answers["setup_content"] = content
if "setup_solr" in answers:
    answers["setup_solr"] = False
json.dump(answers, open(path, "w"), indent=2)
EOF
then
  ANSWERS_MOUNT=(-v "$APP_DIR/site-answers.json:/app/scripts/default.json:ro")
else
  rm -f "$APP_DIR/site-answers.json"
fi
create_site() {
  compose run --rm --no-deps -e ADDONS= \
    -e SITE_ID=Plone \
    -e TIMEZONE="$SITE_TIMEZONE" -e SITE_PORTAL_TIMEZONE="$SITE_TIMEZONE" \
    -e SITE_DEFAULT_LANGUAGE="$SITE_LANGUAGE" -e SITE_AVAILABLE_LANGUAGES="$SITE_LANGUAGE" \
    -e SETUP_CONTENT="$content" -e SITE_SETUP_SOLR=false \
    "${ANSWERS_MOUNT[@]}" "${SITE_ENV[@]}" \
    backend create-site
}
# A backend image whose create-site fails (it reads its settings differently,
# or has a bug) is replaced by the official backend, on a fresh database.
# Only on a new server: when setup runs again, the database may hold a site.
if ! create_site; then
  if [[ -z "$BACKEND_IMAGE" || "$NEW_ADMIN_PASSWORD_SET" != 0 ]]; then
    log "Creating the site failed (see above)"
    false
  fi
  backend_fallback "The backend image ${BACKEND_IMAGE} couldn't create the site"
  ANSWERS_MOUNT=()
  rm -f "$APP_DIR/site-answers.json"
  compose pull --quiet backend
  log "Emptying the database, to start again with the official backend"
  compose exec -T db psql -q -U plone -d postgres -c 'DROP DATABASE plone' -c 'CREATE DATABASE plone OWNER plone'
  set_admin_password
  create_site
fi

if [[ "$NEW_ADMIN_PASSWORD_SET" == 0 && ( -n "$IMAGE_ADDONS" || -n "$IMAGE_BEHAVIORS" ) ]]; then
  log "Activating what the frontend image needs: ${IMAGE_ADDONS} ${IMAGE_BEHAVIORS}"
  site_addons=""
  for addon in $IMAGE_ADDONS; do site_addons+=" ${addon%%[[~=!<>]*}"; done
  if compose run --rm --no-deps -e SITE_ADDONS="$site_addons" -e SITE_BEHAVIORS="$IMAGE_BEHAVIORS" \
      -v "$APP_DIR/activate_frontend_addons.py:/app/scripts/activate_frontend_addons.py:ro" \
      backend run /app/scripts/activate_frontend_addons.py; then
    IMAGE_ACTIVATED=1
  else
    log "Activating them failed (see above); activate them in Site Setup > Add-ons and enable the behaviors in Site Setup > Content Types > Plone Site"
    FRONTEND_NOTE="Activating the add-ons the frontend image needs failed: activate ${IMAGE_ADDONS} in Site Setup > Add-ons, and enable ${IMAGE_BEHAVIORS} in Site Setup > Content Types > Plone Site > Behaviors."
  fi
fi

# The demo login, once: a username of lowercase letters, digits, dots,
# hyphens and underscores, not admin. Its roles: DEMO_ROLES, or the frontend
# image's suggestion, or Site Administrator.
DEMO_LINE=""
if [[ "$NEW_ADMIN_PASSWORD_SET" == 0 && -n "$DEMO_USER" ]]; then
  if [[ ! "$DEMO_USER" =~ ^[a-z][a-z0-9._-]{1,31}$ || "$DEMO_USER" == admin ]]; then
    log "Not creating the demo login: \"$DEMO_USER\" isn't a username (lowercase letters, digits, . _ -), or is admin"
    DEMO_LINE="Demo login: not created; \"${DEMO_USER}\" isn't a username (lowercase letters, digits, . _ -)."
  else
    roles="${DEMO_ROLES}"
    [[ -n "${roles// /}" ]] || roles="${IMAGE_DEMO_ROLES}"
    [[ -n "${roles// /}" ]] || roles="Site Administrator"
    # With email set up, a Site Administrator could point Site Setup > Mail
    # at another server and have Plone send it the email service's password,
    # so the demo login is an Editor instead.
    DEMO_ROLES_NOTE=""
    if [[ -n "$SMTP_HOST" ]] && grep -qiE '(^|,)[[:space:]]*site administrator[[:space:]]*(,|$)' <<<"$roles"; then
      roles=$(sed -E 's/(^|,)[[:space:]]*[Ss]ite [Aa]dministrator[[:space:]]*(,|$)/\1Editor\2/g' <<<"$roles")
      log "The demo login gets Editor instead of Site Administrator, since email is set up"
      DEMO_ROLES_NOTE=" Editor instead of Site Administrator, since a Site Administrator could get the email service's password from Site Setup > Mail."
    fi
    log "Creating the demo login ${DEMO_USER} (${roles})"
    # Its password: the one entered when deploying, if it has at least 12
    # characters, or a generated one.
    DEMO_PASSWORD_SHOWN="" DEMO_PASSWORD_NOTE=""
    if [[ -n "$DEMO_PASSWORD" ]] && (( ${#DEMO_PASSWORD} < 12 )); then
      log "The demo login password given is shorter than 12 characters; generating one instead"
      DEMO_PASSWORD_NOTE=" The password entered was shorter than 12 characters, so this one was generated instead."
      DEMO_PASSWORD=""
    fi
    if [[ -n "$DEMO_PASSWORD" ]]; then
      DEMO_PASSWORD_SHOWN="(the password you entered when deploying)"
    else
      DEMO_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=')
      DEMO_PASSWORD_SHOWN="$DEMO_PASSWORD"
    fi
    if demo_out=$(DEMO_USER="$DEMO_USER" DEMO_PASSWORD="$DEMO_PASSWORD" DEMO_ROLES="$roles" \
        compose run --rm --no-deps -T -e DEMO_USER -e DEMO_PASSWORD -e DEMO_ROLES -e ADDONS= \
        -v "$APP_DIR/create_demo_user.py:/app/scripts/create_demo_user.py:ro" \
        backend run /app/scripts/create_demo_user.py 2>&1); then
      printf '%s\n' "$demo_out" | grep -v '^DEMO_ROLES_GIVEN='
      given=$(printf '%s\n' "$demo_out" | sed -n 's/^DEMO_ROLES_GIVEN=//p' | tail -n 1)
      DEMO_LINE="Demo login: ${DEMO_USER} / ${DEMO_PASSWORD_SHOWN} (${given:-$roles})${DEMO_ROLES_NOTE}${DEMO_PASSWORD_NOTE}"
    else
      printf '%s\n' "$demo_out"
      log "Creating the demo login failed (see above); add it in Site Setup > Users"
      DEMO_LINE="Demo login: creating ${DEMO_USER} failed; add it in Site Setup > Users. The reason is in /var/log/plone-in-a-box.log."
    fi
  fi
fi

# Add-ons left for the admin to activate: not those setup activated for the
# frontend image.
ADDONS_TODO="$ADDONS"
if [[ "$IMAGE_ACTIVATED" == 1 ]]; then
  ADDONS_TODO=""
  for addon in $ADDONS; do
    [[ " $IMAGE_ADDONS " == *" $addon "* ]] || ADDONS_TODO+="${ADDONS_TODO:+ }$addon"
  done
fi
if [[ -z "$ADDONS" ]]; then
  ADDONS_LINE=""
elif [[ -z "$ADDONS_TODO" ]]; then
  ADDONS_LINE="Backend add-ons: ${ADDONS} (activated for the frontend image)"
elif [[ "$ADDONS_TODO" == "$ADDONS" ]]; then
  ADDONS_LINE="Backend add-ons: ${ADDONS} (activate them in Site Setup > Add-ons)"
else
  ADDONS_LINE="Backend add-ons: ${ADDONS} (activate ${ADDONS_TODO} in Site Setup > Add-ons; the others are activated for the frontend image)"
fi

progress 6
log "Starting Plone"
compose up -d
wait_for "Plone backend" 300 curl -fsS http://127.0.0.1:8080/ok
# A frontend image that doesn't start (built for another Volto, say) is
# replaced by the standard Volto image, so the site still works.
if ! wait_for "Volto frontend" 300 curl -fsS -o /dev/null http://127.0.0.1:3000/; then
  [[ -n "$FRONTEND_IMAGE" ]] || false
  log "The frontend image ${FRONTEND_IMAGE} didn't start; its last messages:"
  compose logs --no-color --tail 15 frontend 2>&1 | sed 's/^/    /' || true
  log "Using the standard Volto image instead"
  FRONTEND_NOTE="The frontend image ${FRONTEND_IMAGE} didn't start, so the site uses the standard Volto image. Its messages are in /var/log/plone-in-a-box.log."
  FRONTEND_IMAGE=""
  sed -i "s/^FRONTEND_IMAGE=.*/FRONTEND_IMAGE=''/" "$APP_DIR/.env"
  compose pull --quiet frontend
  compose up -d frontend
  wait_for "Volto frontend" 300 curl -fsS -o /dev/null http://127.0.0.1:3000/
fi

# --- nginx -------------------------------------------------------------------

progress 7
log "Configuring nginx"
SERVER_NAME="${DOMAIN:-_}"
rm -f /etc/nginx/sites-enabled/default /etc/nginx/sites-enabled/plone-in-a-box-setup
# For the site's server block: no nginx version in responses, compressed CSS,
# JavaScript and JSON (overriding Ubuntu's nginx.conf here, as it sets some of
# these itself), and security headers. A location with an add_header of its
# own would drop the headers, so none has one. Browsers' default
# Referrer-Policy, strict-origin-when-cross-origin, is already the right one.
cat > /etc/nginx/snippets/plone-headers.conf <<'EOF'
server_tokens off;
gzip on;
gzip_proxied any;
gzip_types text/css application/javascript application/json image/svg+xml;
add_header X-Frame-Options SAMEORIGIN always;
add_header X-Content-Type-Options nosniff always;
EOF
# The site itself, included by the HTTP server block below, and by the HTTPS
# one when there is one.
cat > /etc/nginx/snippets/plone-site.conf <<'EOF'
client_max_body_size 100m;

proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

# REST API calls go straight to the Plone backend.
location ~ /\+\+api\+\+($|/.*) {
  rewrite ^/\+\+api\+\+($|/.*) /VirtualHostBase/$scheme/$host:$server_port/Plone/++api++/VirtualHostRoot/$1 break;
  proxy_pass http://backend;
}

# Downloads and image scales are served by the backend too.
location ~ /(@@download|@@images|@@ical_view) {
  rewrite ^(.*) /VirtualHostBase/$scheme/$host:$server_port/Plone/VirtualHostRoot$1 break;
  proxy_pass http://backend;
}

# Long-lived caching for Volto's static build assets.
location ~* \.(js|css|eot|ttf|otf|woff|woff2)$ {
  # Sends Cache-Control: max-age too.
  expires 1y;
  proxy_pass http://frontend;
}

location / {
  proxy_pass http://frontend;
}
EOF
# Let's Encrypt's checks, on port 80 whatever else it does (^~: before the
# site's regular expression locations).
install -d -m 755 /var/www/letsencrypt
cat > /etc/nginx/snippets/plone-acme.conf <<'EOF'
location ^~ /.well-known/acme-challenge/ {
  root /var/www/letsencrypt;
  default_type text/plain;
}
EOF
# Port 80: the site, or a redirect to HTTPS once plone-https-ip turns it on.
[[ -s /etc/nginx/snippets/plone-http.conf ]] || printf 'include snippets/plone-site.conf;\n' > /etc/nginx/snippets/plone-http.conf
cat > /etc/nginx/sites-available/plone <<EOF
upstream backend {
  server 127.0.0.1:8080;
}
upstream frontend {
  server 127.0.0.1:3000;
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name ${SERVER_NAME};

  include snippets/plone-headers.conf;
  include snippets/plone-acme.conf;
  include snippets/plone-http.conf;
}
EOF
ln -sf /etc/nginx/sites-available/plone /etc/nginx/sites-enabled/plone
nginx -t
systemctl reload nginx

SITE_URL="http://$(curl -fsS -4 https://ifconfig.me 2>/dev/null || hostname -I | awk '{print $1}')"

# --- HTTPS (optional) --------------------------------------------------------

if [[ -z "$DOMAIN" ]]; then
  # No domain name: a certificate for the server's IP address (Let's Encrypt,
  # renewed every few days by plone-https-ip.timer).
  # (LETSENCRYPT_STAGING=yes: Let's Encrypt's test service, for automated tests.)
  install -d -m 755 /var/lib/plone-in-a-box
  if [[ "${LETSENCRYPT_STAGING:-}" == yes ]]; then touch /var/lib/plone-in-a-box/https-ip-staging; fi
  log "Requesting an HTTPS certificate for the server's IP address"
  if /usr/local/bin/plone-https-ip; then
    SITE_URL="https://${SITE_URL#http://}"
  else
    log "No HTTPS certificate for the IP address yet; the site is on HTTP, and the server tries again twice a day (sudo plone-https-ip to try now)"
    systemctl enable --now plone-https-ip.timer
  fi
else
  SITE_URL="http://${DOMAIN}"
  if [[ -z "$LETSENCRYPT_EMAIL" ]]; then
    log "DOMAIN is set but LETSENCRYPT_EMAIL is empty; skipping HTTPS"
  else
    log "Requesting a Let's Encrypt certificate for ${DOMAIN}"
    apt-get install -y certbot python3-certbot-nginx
    if certbot --nginx --non-interactive --agree-tos --redirect \
         -m "$LETSENCRYPT_EMAIL" -d "$DOMAIN"; then
      SITE_URL="https://${DOMAIN}"
      # Browsers then use HTTPS only, for a year.
      echo 'add_header Strict-Transport-Security max-age=31536000 always;' >> /etc/nginx/snippets/plone-headers.conf
      systemctl reload nginx
    else
      log "certbot failed (is DNS for ${DOMAIN} pointing at this server?). The site is still available over HTTP; re-run: certbot --nginx -d ${DOMAIN}"
    fi
  fi
fi

# --- Updates -------------------------------------------------------------------

install -d -m 755 /var/lib/plone-in-a-box
printf '%s\n' "$SITE_URL" > /var/lib/plone-in-a-box/site-url
# Nightly database backups and a weekly pack, whatever AUTO_UPDATE says.
systemctl enable --now plone-backup.timer
# Daily security notices; the first check only notes the newest post.
/usr/local/bin/plone-security-notices >/dev/null 2>&1 || true
systemctl enable --now plone-security-notices.timer
# Nightly restarts when Ubuntu's security updates need one.
systemctl enable --now plone-reboot.timer
RESTARTS_LINE="Restarts:  the server restarts at night when security updates need it (sudo systemctl disable --now plone-reboot.timer to stop)"
if [[ "$AUTO_UPDATE" == yes ]]; then
  systemctl enable --now plone-update.timer
  UPDATES_LINE="Updates:   Plone, Volto and PostgreSQL patch releases install automatically every week (sudo plone-update to run it now)"
else
  systemctl disable --now plone-update.timer 2>/dev/null || true
  UPDATES_LINE="Updates:   automatic updates are off; run sudo plone-update to install patch releases"
fi

# --- Email (optional) ----------------------------------------------------------
# Site Setup > Mail gets the relay service's settings, and a test email goes
# to the address for reports, which plone-update uses too.

MAIL_LINE=""
if [[ -n "$SMTP_HOST" && "$NEW_ADMIN_PASSWORD_SET" == 0 ]]; then
  REPORT_EMAIL="${REPORT_EMAIL:-$EMAIL_FROM}"
  if [[ ! "$SMTP_HOST" =~ ^[A-Za-z0-9.-]+$ || ! "$SMTP_PORT" =~ ^[0-9]{1,5}$ ]] \
      || ! valid_email "$EMAIL_FROM" || ! valid_email "$REPORT_EMAIL"; then
    MAIL_LINE="Email:     not set up: the SMTP server, port, From address or address for reports isn't valid. Set them in Site Setup > Mail."
  else
    log "Setting up email through ${SMTP_HOST}:${SMTP_PORT}, from ${EMAIL_FROM}"
    # Passed by name, so the password isn't on a command line.
    export SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD EMAIL_FROM
    mail_out=$(compose run --rm --no-deps -T -e ADDONS= -e SMTP_HOST -e SMTP_PORT -e SMTP_USER -e SMTP_PASSWORD -e EMAIL_FROM \
      -v "$APP_DIR/configure_mail.py:/app/scripts/configure_mail.py:ro" \
      backend run /app/scripts/configure_mail.py 2>&1 || true)
    export -n SMTP_PASSWORD
    if [[ "$mail_out" == *MAIL_CONFIGURED* ]]; then
      printf '%s\n' "$REPORT_EMAIL" > /var/lib/plone-in-a-box/report-email
      mail_body=$(printf '%s\n\n%s\n%s' "This test email shows that ${SITE_URL} can send email through ${SMTP_HOST}." \
        "Password resets and forms use these settings (Site Setup > Mail), and update reports are sent to this address." \
        "To send them somewhere else, edit /var/lib/plone-in-a-box/report-email on the server.")
      mail_out=$(compose run --rm --no-deps -T -e ADDONS= -e MAIL_TO="$REPORT_EMAIL" \
        -e MAIL_SUBJECT="Plone in a Box: your site can send email (${SITE_URL})" -e MAIL_BODY="$mail_body" \
        -v "$APP_DIR/send_mail.py:/app/scripts/send_mail.py:ro" \
        backend run /app/scripts/send_mail.py 2>&1 || true)
      if [[ "$mail_out" == *MAIL_SENT* ]]; then
        log "Sent a test email to ${REPORT_EMAIL}"
        MAIL_LINE="Email:     sent through ${SMTP_HOST} from ${EMAIL_FROM}; a test email went to ${REPORT_EMAIL}"
      else
        reason=$(grep -o 'MAIL_FAILED.*' <<<"$mail_out" | head -1 | cut -c13-200 || true)
        log "Sending a test email failed: ${reason:-see above}"
        MAIL_LINE="Email:     set up, but the test email to ${REPORT_EMAIL} failed: ${reason:-see /var/log/plone-in-a-box.log}. Check the settings in Site Setup > Mail and with your email service."
      fi
    else
      printf '%s\n' "$mail_out" | tail -5
      log "Writing the email settings failed (see above)"
      MAIL_LINE="Email:     setting it up failed; set it in Site Setup > Mail. The reason is in /var/log/plone-in-a-box.log."
    fi
  fi
  if [[ "$MAIL_LINE" == *"not set up"* ]]; then
    log "${MAIL_LINE#Email:     }"
  fi
fi

# --- Blocklists -----------------------------------------------------------------
# Mail receivers look up the site's domain and its From address's domain in
# public blocklists, and a cloud server's IP address can be on one from
# whoever had it before. Say so in the credentials file if they are.
BLOCKLIST_LINES=""
email_domain=""
if valid_email "$EMAIL_FROM"; then
  email_domain=${EMAIL_FROM#*@}
  printf '%s\n' "$email_domain" > /var/lib/plone-in-a-box/email-domain
fi
server_ip=$(curl -fsS -4 -m 20 https://ifconfig.me 2>/dev/null || true)
# shellcheck disable=SC2086 # no domain is no argument
bl_out=$(/usr/local/lib/plone-in-a-box/blocklists --ip "$server_ip" $DOMAIN $email_domain || true)
while read -r kind name list url; do
  case "$kind" in
    LISTED)
      if [[ "$name" == "$server_ip" ]]; then
        line="This server's IP address ${name} is on the blocklist ${list} (${url}). Email sent through an email service isn't affected, but the address has a bad history: you may prefer a new server."
      else
        line="${name} is on the blocklist ${list} (${url}): email from it, or with links to it, may land in spam. That page explains how to have it removed."
      fi
      log "$line"
      BLOCKLIST_LINES+="Blocklist: ${line}"$'\n'
      ;;
    UNCHECKED) log "Couldn't ask the blocklist ${name} from this server" ;;
  esac
done <<<"$bl_out"
[[ "$bl_out" == *LISTED* ]] || log "Not on the blocklists checked: ${server_ip:-?}${DOMAIN:+, ${DOMAIN}}${email_domain:+, ${email_domain}}"

NL=$'\n'
# The notification URL works like a password, so only root can read it, and
# it isn't logged. A first notice says the site is ready, and shows it works.
NOTIFY_LINE=""
if [[ -n "$NOTIFY_URL" ]]; then
  if [[ ! "$NOTIFY_URL" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/[^[:space:]\'\"]*)?$ ]]; then
    log "Not using the notification URL: it has to start with https:// and can't contain spaces or quotes"
    NOTIFY_LINE="Notices:   the notification URL wasn't used: it has to start with https://"
  elif [[ "$NEW_ADMIN_PASSWORD_SET" == 0 ]]; then
    (umask 077; printf '%s\n' "$NOTIFY_URL" > /var/lib/plone-in-a-box/notify-url)
    if /usr/local/lib/plone-in-a-box/notify "Plone in a Box is ready (${SITE_URL})" \
        "Your Plone site is ready: ${SITE_URL}"$'\n'"Log in as admin. Update reports will be sent here.${MAIL_LINE:+${NL}${MAIL_LINE#Email:     }}"; then
      log "Sent a notice to the notification URL"
      NOTIFY_LINE="Notices:   update reports go to the notification URL (a first notice was sent)"
    else
      log "Sending a notice to the notification URL failed; check the URL in /var/lib/plone-in-a-box/notify-url"
      NOTIFY_LINE="Notices:   sending to the notification URL failed; check it in /var/lib/plone-in-a-box/notify-url"
    fi
  fi
fi

# --- Done ----------------------------------------------------------------------

if [[ "$NEW_ADMIN_PASSWORD_SET" == 0 ]]; then
  if [[ "$ADMIN_PASSWORD_CHOSEN" == 1 ]]; then
    PASSWORD_LINE="(the password you entered when deploying)"
  else
    PASSWORD_LINE="${ADMIN_PASSWORD}"
  fi
  umask 077
  cat > "$CREDENTIALS_FILE" <<EOF
Plone in a Box(TM)

Site:      ${SITE_URL}
Username:  admin
Password:  ${PASSWORD_LINE}
${PASSWORD_NOTE}
${ADDONS_LINE}${ADDONS_NOTE}
${FRONTEND_IMAGE:+Frontend image: ${FRONTEND_IMAGE}}${FRONTEND_NOTE}
${BACKEND_IMAGE:+Backend image: ${BACKEND_IMAGE}}${BACKEND_NOTE}
${REGISTRY_LINE}
Language:  ${SITE_LANGUAGE}${CONTENT_NOTE}${LANGUAGE_NOTE:+ ($LANGUAGE_NOTE)}
${DEMO_LINE}
${UPDATES_LINE}
${RESTARTS_LINE}
Security:  Plone security announcements are passed on every day, in the login message${NOTIFY_URL:+, at the notification URL}${SMTP_HOST:+ and by email}
${NOTIFY_LINE}
${MAIL_LINE}
${BLOCKLIST_LINES}Store the password in a password manager, then delete this file.
Stack files: ${APP_DIR} (docker compose --project-directory ${APP_DIR} ps)
EOF
  umask 022
fi

# Show the site address on the server's console login screen (Linode LISH,
# DigitalOcean Recovery Console, AWS serial console), for anyone who never uses SSH.
cat >> /etc/issue <<EOF

  Plone in a Box(TM) is ready: ${SITE_URL}
  Log in to the site as "admin".

EOF

rm -rf "$RESUME_DIR"
rm -f "$RESUME_UNIT"
if [[ -f /var/run/reboot-required ]]; then
  log "Some updates need a restart to take effect; the server restarts tonight by itself (or now: sudo reboot). Plone starts again by itself."
fi

if [[ -n "$ADDONS_LINE" ]]; then
  log "$ADDONS_LINE"
fi
if [[ -n "$ADDONS_NOTE" ]]; then
  log "$ADDONS_NOTE"
fi
if [[ -n "$FRONTEND_IMAGE" ]]; then
  log "Frontend image: ${FRONTEND_IMAGE}"
fi
if [[ -n "$BACKEND_IMAGE" ]]; then
  log "Backend image: ${BACKEND_IMAGE}"
fi
if [[ -n "$BACKEND_NOTE" ]]; then
  log "$BACKEND_NOTE"
fi
if [[ -n "$FRONTEND_NOTE" ]]; then
  log "$FRONTEND_NOTE"
fi
log "${UPDATES_LINE#Updates:   }"
if [[ "$ADMIN_PASSWORD_CHOSEN" == 1 ]]; then
  log "Finished. Site: ${SITE_URL} -- log in as admin with the password you chose"
else
  log "Finished. Site: ${SITE_URL} -- admin credentials are in ${CREDENTIALS_FILE}"
fi
