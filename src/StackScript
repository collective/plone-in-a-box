#!/bin/bash
# Restarts the server if installed updates need it (a new kernel, say), once
# no backup or update is running. Plone starts again by itself.
# Usage: sudo plone-reboot   (also run every night by plone-reboot.timer)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-reboot" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
[[ -f /var/run/reboot-required ]] || { echo "No restart needed"; exit 0; }
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
flock -w 10800 9 || { echo "A backup or update is still running; no restart this time" >&2; exit 1; }
pkgs=$(sort -u /var/run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ')
printf '[%s] Restarting for updates to: %s\n' "$(date '+%F %T')" "${pkgs:-(not listed)}" | tee -a /var/log/plone-reboot.log
systemctl reboot
