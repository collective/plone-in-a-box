# HTTPS for a site without a domain name: a Let's Encrypt certificate for the
# server's IP address. Setup runs it; plone-https-ip.timer renews it.
cat > /usr/local/bin/plone-https-ip <<'PLONE_HTTPS_IP_EOF'
#!/bin/bash
# HTTPS for a site without a domain name: a Let's Encrypt certificate for the
# server's IPv4 address. These last about 6 days, so plone-https-ip.timer runs
# this twice a day and renews when 3 days are left; a notice goes out if
# renewing keeps failing. A site with a domain name has its own certificate.
# Usage: sudo plone-https-ip        (get or renew the certificate, and turn HTTPS on)
#        sudo plone-https-ip off    (back to HTTP only)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-https-ip" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
WEBROOT=/var/www/letsencrypt
# Certbot from its official image: Ubuntu 26.04's (4.0) is too old for IP
# addresses. plone-update pulls newer builds every week.
IMAGE=certbot/certbot:latest
NAME=plone-ip
LIVE=/etc/letsencrypt/live/$NAME
HTTP_SNIPPET=/etc/nginx/snippets/plone-http.conf
HTTPS_SITE=/etc/nginx/sites-available/plone-https
mkdir -p "$STATE_DIR"
exec > >(tee -a /var/log/plone-https-ip.log) 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
reload() { nginx -t -q && systemctl reload nginx; }

if [[ "$(awk '$1 == "server_name" { print $2; exit }' /etc/nginx/sites-available/plone)" != "_;" ]]; then
  say "This server has a domain name, so it doesn't need an IP address certificate"
  exit 0
fi
IP=$(curl -fsS -4 -m 20 https://ifconfig.me 2>/dev/null || true)
[[ "$IP" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || { say "Couldn't find this server's public IPv4 address; trying again later"; exit 1; }

if [[ "${1:-}" == off ]]; then
  systemctl disable --now plone-https-ip.timer 2>/dev/null
  printf 'include snippets/plone-site.conf;\n' > "$HTTP_SNIPPET"
  rm -f /etc/nginx/sites-enabled/plone-https
  reload
  # The certificate too, so a domain's certificate (Ubuntu's certbot, which
  # renews every certificate it finds and can't do IP addresses) starts clean.
  if [[ -d "$LIVE" ]]; then
    docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt \
      "$IMAGE" delete --cert-name "$NAME" --non-interactive </dev/null >/dev/null 2>&1 \
      && say "Deleted the certificate for the IP address"
  fi
  echo "http://$IP" > "$STATE_DIR/site-url"
  say "HTTPS is off; the site is at http://$IP. Turn it back on with: sudo plone-https-ip"
  exit 0
fi

# Hours the current certificate has left, if it's for this address.
left=0
if [[ -s "$LIVE/fullchain.pem" ]] && openssl x509 -in "$LIVE/fullchain.pem" -noout -ext subjectAltName 2>/dev/null | grep -q "IP Address:$IP\b"; then
  end=$(openssl x509 -in "$LIVE/fullchain.pem" -noout -enddate | cut -d= -f2)
  left=$(( ($(date -d "$end" +%s) - $(date +%s)) / 3600 ))
fi
# (PLONE_HTTPS_RENEW_HOURS: for tests, to renew sooner.)
if (( left < ${PLONE_HTTPS_RENEW_HOURS:-72} )); then
  say "Requesting a certificate for $IP (the current one has ${left}h left)"
  install -d -m 755 "$WEBROOT"
  staging=()
  [[ -e "$STATE_DIR/https-ip-staging" ]] && staging=(--staging)
  if docker run --rm -v /etc/letsencrypt:/etc/letsencrypt -v /var/lib/letsencrypt:/var/lib/letsencrypt \
       -v "$WEBROOT:$WEBROOT" "$IMAGE" certonly --webroot -w "$WEBROOT" --ip-address "$IP" \
       --preferred-profile shortlived --cert-name "$NAME" --non-interactive --agree-tos \
       --register-unsafely-without-email --force-renewal "${staging[@]}" </dev/null; then
    say "Got a certificate for $IP"
    left=999
  else
    say "Getting a certificate for $IP failed (the reason is above)"
    if (( left > 0 && left < 24 )); then
      /usr/local/lib/plone-in-a-box/notify "Plone in a Box: HTTPS certificate expiring (https://$IP)" \
        "The HTTPS certificate for https://$IP expires within a day, and renewing it is failing. The log is in /var/log/plone-https-ip.log on the server; try again with: sudo plone-https-ip" >/dev/null 2>&1 </dev/null
    fi
    (( left > 0 )) || exit 1
  fi
fi

# HTTPS on: the site on port 443, and HTTP redirecting to it (Let's Encrypt's
# checks still get through on port 80).
cat > "$HTTPS_SITE" <<EOF
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name _;
  ssl_certificate $LIVE/fullchain.pem;
  ssl_certificate_key $LIVE/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  include snippets/plone-headers.conf;
  include snippets/plone-site.conf;
}
EOF
ln -sf "$HTTPS_SITE" /etc/nginx/sites-enabled/plone-https
# (nginx's own variables, not the shell's.)
# shellcheck disable=SC2016
printf 'location / {\n  return 301 https://$host$request_uri;\n}\n' > "$HTTP_SNIPPET"
if reload; then
  echo "https://$IP" > "$STATE_DIR/site-url"
  systemctl enable --now plone-https-ip.timer 2>/dev/null
  say "HTTPS is on: https://$IP"
else
  say "nginx didn't accept the HTTPS settings; staying on HTTP"
  printf 'include snippets/plone-site.conf;\n' > "$HTTP_SNIPPET"
  rm -f /etc/nginx/sites-enabled/plone-https
  reload
  exit 1
fi
