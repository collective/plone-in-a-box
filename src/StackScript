# Looks up the server's IP address and the site's domain names in public
# blocklists that mail receivers use. Each list is only asked after its test
# entry answers: some refuse queries through big shared DNS resolvers, and
# then the answer means nothing.
cat > /usr/local/lib/plone-in-a-box/blocklists <<'EOF'
#!/bin/bash
# Usage: blocklists [--ip ADDRESS] [DOMAIN ...]
# Prints "LISTED <name> <list> <url>" for each listing and "UNCHECKED <list>"
# for each list that couldn't be asked. Exit 0: not listed; 1: listed.
lookup() { getent ahostsv4 "$1" 2>/dev/null | awk 'NR == 1 { print $1 }'; }
# check <list> <its test entry> <what a listing answers, as a regular
# expression> <where to read more> <the name to report> <the name to ask>
check() {
  local list=$1 test=$2 hit=$3 url=$4 name=$5 query=$6
  [[ "$(lookup "$test.$list")" =~ $hit ]] || { echo "UNCHECKED $list"; return; }
  [[ "$(lookup "$query.$list")" =~ $hit ]] && echo "LISTED $name $list $url"
}
all() {
  local ip="" d rev
  if [[ "${1:-}" == --ip ]]; then ip=$2; shift 2; fi
  if [[ "$ip" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
    rev="${BASH_REMATCH[4]}.${BASH_REMATCH[3]}.${BASH_REMATCH[2]}.${BASH_REMATCH[1]}"
    # Spamhaus ZEN without its Policy Block List (127.0.0.10 and .11), which
    # only says an address isn't a mail server's.
    check zen.spamhaus.org 2.0.0.127 '^127\.0\.0\.[2-9]$' https://check.spamhaus.org/ "$ip" "$rev"
    check bl.spamcop.net 2.0.0.127 '^127\.0\.0\.2$' "https://www.spamcop.net/bl.shtml?$ip" "$ip" "$rev"
  fi
  for d in "$@"; do
    d=${d,,}; d=${d%.}
    [[ "$d" =~ ^[a-z0-9-]+(\.[a-z0-9-]+)+$ ]] || continue
    # The registered domain too (example.org for www.example.org): the lists
    # name domains more often than single hosts.
    for name in "$d" $([[ "$d" =~ \.([a-z0-9-]+\.[a-z0-9-]+)$ ]] && echo "${BASH_REMATCH[1]}"); do
      check dbl.spamhaus.org dbltest.com '^127\.0\.1\.([2-9]|[1-9][0-9]|1[0-9][0-9])$' https://check.spamhaus.org/ "$name" "$name"
      check multi.surbl.org test.surbl.org '^127\.0\.0\.([2-9]|[1-9][0-9]|1[0-9][0-9]|2[0-5][0-9])$' https://surbl.org/surbl-analysis "$name" "$name"
    done
  done
}
out=$(all "$@" | awk '!seen[$0]++')
[[ -n "$out" ]] && printf '%s\n' "$out"
! grep -q '^LISTED' <<<"$out"
EOF
chmod 755 /usr/local/lib/plone-in-a-box/blocklists

# Updates: sudo plone-update, and weekly through plone-update.timer when
# automatic updates are on. It installs newer images of the same Plone, Volto
# and PostgreSQL versions (the tags in .env stay as they are), after a
# database dump, and goes back to the previous images if the site doesn't
# come back. The result goes to the login message, and by email to the site's
# address when Site Setup > Mail has one.
cat > /usr/local/bin/plone-update <<'PLONE_UPDATE_EOF'
#!/bin/bash
# Install newer images of the same Plone, Volto and PostgreSQL versions: patch
# releases and security fixes. Takes a database dump first, and goes back to the
# previous images if the site doesn't come back.
# Usage: sudo plone-update   (also run every week by plone-update.timer, if on)
set -uo pipefail
if [[ $EUID -ne 0 ]]; then
  echo "Please run this with sudo: sudo plone-update" >&2
  exit 1
fi
APP_DIR=/opt/plone
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
LOG_FILE=/var/log/plone-update.log
# Seconds to wait for the site after updating; add-ons are installed first.
HEALTH_TIMEOUT=${PLONE_UPDATE_HEALTH_TIMEOUT:-600}
# And after going back to the previous images.
ROLLBACK_TIMEOUT=600
SERVICES=(db backend frontend)
GUIDE=https://github.com/collective/plone-in-a-box/blob/main/docs/setup-guide.md#updates

mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
# Shared with plone-backup: wait for a backup or pack to finish.
if ! flock -n 9; then
  echo "Waiting for plone-update or plone-backup, which is running" >&2
  if ! flock -w 7200 9; then
    echo "plone-update or plone-backup is still running; try again later" >&2
    exit 1
  fi
fi
exec > >(tee -a "$LOG_FILE") 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT

say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
compose() { docker compose --project-directory "$APP_DIR" "$@"; }
SITE_URL=$(cat "$STATE_DIR/site-url" 2>/dev/null || hostname)
cd "$APP_DIR" || exit 1

versions() {
  local plone volto pg
  plone=$(compose exec -T backend /app/bin/python -c \
    'from importlib.metadata import version; print(version("Products.CMFPlone"))' 2>/dev/null) || plone="?"
  volto=$(compose exec -T frontend node -p 'require("@plone/volto/package.json").version' 2>/dev/null) && volto="Volto ${volto:-?}" \
    || { volto=$(compose exec -T frontend node -p 'require("@plone/aurora/package.json").version' 2>/dev/null) && volto="Aurora ${volto:-?}"; } \
    || volto="Volto ?"
  pg=$(compose exec -T db postgres --version 2>/dev/null | awk '{print $3}') || pg="?"
  echo "Plone ${plone:-?}, ${volto}, PostgreSQL ${pg:-?}"
}

site_ok() {
  curl -fsS -m 10 -o /dev/null http://127.0.0.1:8080/ok && curl -fsS -m 30 -o /dev/null http://127.0.0.1:3000/
}

# A newer Plone release than the one in .env: a manual upgrade, so only say so.
NOTICE=""
check_releases() {
  local current next
  # A custom backend image moves to a new Plone version when its maker
  # publishes one; PLONE_VERSION doesn't apply to it.
  grep -q "^BACKEND_IMAGE='[^']" "$APP_DIR/.env" && return 0
  current=$(sed -n 's/^PLONE_VERSION=//p' "$APP_DIR/.env")
  [[ "$current" =~ ^([0-9]+)\.([0-9]+)$ ]] || return 0
  for next in "${BASH_REMATCH[1]}.$((BASH_REMATCH[2] + 1))" "$((BASH_REMATCH[1] + 1)).0"; do
    if curl -fs -m 20 -o /dev/null "https://hub.docker.com/v2/repositories/plone/plone-backend/tags/${next}"; then
      NOTICE="Plone ${next} is available. This server stays on Plone ${current}: moving to ${next} is a manual upgrade, see ${GUIDE}"
      return 0
    fi
  done
}

send_report() {  # send_report <subject> <body>
  local out to
  # The address for reports chosen at setup, or else the site's From address.
  to=$(cat "$STATE_DIR/report-email" 2>/dev/null || true)
  out=$(compose run --rm --no-deps -T -e MAIL_SUBJECT="$1" -e MAIL_BODY="$2" -e MAIL_TO="$to" \
    -v "$APP_DIR/send_mail.py:/app/scripts/send_mail.py:ro" \
    backend run /app/scripts/send_mail.py 2>&1)
  case "$out" in
    *MAIL_SENT*) say "Emailed this report to ${to:-the site address in Site Setup > Mail}" ;;
    *NO_MAIL_SETTINGS*) say "Not emailed: the site has no email address in Site Setup > Mail" ;;
    *) say "Emailing this report failed:"; tail -3 <<<"$out" ;;
  esac
}

# finish <exit code> <summary> [details]: record the result for the login
# message, and email it unless nothing happened or it was already reported.
finish() {
  local code=$1 summary=$2 details=${3:-} report
  say "$summary"
  [[ -n "$details" ]] && printf '%s\n' "$details"
  printf '%s  %s\n' "$(date '+%F %H:%M')" "$summary" > "$STATE_DIR/update-status"
  printf '%s\n' "$NOTICE" > "$STATE_DIR/update-notice"
  report=$(printf '%s\n\n%s\n\n%s' "$summary" "$details" "$NOTICE")
  if [[ "$summary" != "Up to date"* || -n "$NOTICE" ]] \
     && [[ "$report" != "$(cat "$STATE_DIR/last-report" 2>/dev/null)" ]]; then
    local subject body
    subject="Plone in a Box: ${summary%%:*} (${SITE_URL})"
    body=$(printf '%s\n\n%s\n\nThe log is in %s on the server. Turn automatic updates off: sudo systemctl disable --now plone-update.timer\nUpdates and backups: %s' \
      "$SITE_URL" "$report" "$LOG_FILE" "$GUIDE")
    send_report "$subject" "$body"
    /usr/local/lib/plone-in-a-box/notify "$subject" "$body"
    case $? in
      0) say "Sent this report to the notification URL" ;;
      3) ;;
      *) say "Sending this report to the notification URL failed" ;;
    esac
    printf '%s' "$report" > "$STATE_DIR/last-report"
  fi
  exit "$code"
}

declare -A REF OLD NEW
CHANGED=() NOTES=()
for s in "${SERVICES[@]}"; do
  cid=$(compose ps -q "$s")
  if [[ -z "$cid" ]]; then
    finish 1 "Not updated: the $s container isn't running" "Start the site first: sudo docker compose --project-directory $APP_DIR up -d"
  fi
  REF[$s]=$(docker inspect -f '{{.Config.Image}}' "$cid")
  OLD[$s]=$(docker inspect -f '{{.Image}}' "$cid")
done
BEFORE=$(versions)
say "Checking for newer images (now ${BEFORE})"
check_releases
# Nightly backups that stopped (a stopped timer, a full disk) without a failure
# notice: say so in the report.
if systemctl is-enabled --quiet plone-backup.timer 2>/dev/null; then
  # shellcheck disable=SC2012
  newest=$(ls -1t "$BACKUP_DIR"/plone-*.sql.gz 2>/dev/null | head -n 1)
  if [[ -z "$newest" ]]; then
    NOTICE+="${NOTICE:+ }There's no database backup on this server: check sudo systemctl status plone-backup.timer and /var/log/plone-backup.log."
  elif (( $(date +%s) - $(stat -c %Y "$newest") > 2 * 86400 )); then
    NOTICE+="${NOTICE:+ }The newest database backup is from $(date -r "$newest" '+%F'), more than two days ago: check sudo systemctl status plone-backup.timer and /var/log/plone-backup.log."
  fi
fi
# Ubuntu's security updates waiting for a restart (plone-reboot.timer off,
# or a backup or update that kept it from running), and a nearly full disk.
if [[ -f /var/run/reboot-required ]] && (( $(date +%s) - $(stat -c %Y /var/run/reboot-required) > 2 * 86400 )); then
  NOTICE+="${NOTICE:+ }Security updates have been waiting for a restart since $(date -r /var/run/reboot-required '+%F'): run sudo reboot (Plone starts again by itself), or turn the nightly restarts back on with sudo systemctl enable --now plone-reboot.timer."
fi
used=$(df --output=pcent / | tail -n 1 | tr -dc '0-9')
if (( used > 85 )); then
  NOTICE+="${NOTICE:+ }The server's disk is ${used}% full: free some space (sudo docker image prune -a removes images the site doesn't use) before backups and updates stop working."
fi
# The site's domain and the From address's domain on a mail blocklist: email
# from them, or with links to them, may land in spam.
site_host=${SITE_URL#*://}; site_host=${site_host%%[:/]*}
[[ "$site_host" =~ ^[0-9.]+$ ]] && site_host=""
# shellcheck disable=SC2046,SC2086 # no domain is no argument
while read -r kind name list url; do
  [[ "$kind" == LISTED ]] && NOTICE+="${NOTICE:+ }${name} is on the blocklist ${list} (${url}): email from it, or with links to it, may land in spam. That page explains how to have it removed."
done < <(/usr/local/lib/plone-in-a-box/blocklists $site_host $(cat "$STATE_DIR/email-domain" 2>/dev/null) || true)
# rclone for copies off the server (plone-offsite), if they're set up, and
# Certbot for the IP address certificate (plone-https-ip), if it's in use.
[[ -s "$STATE_DIR/offsite.conf" ]] && docker pull -q rclone/rclone:1 >/dev/null 2>&1
systemctl is-enabled --quiet plone-https-ip.timer 2>/dev/null && docker pull -q certbot/certbot:latest >/dev/null 2>&1
if ! compose pull --quiet; then
  finish 1 "Not updated: downloading the images failed" "Nothing was changed. The reason is in $LOG_FILE."
fi

label() { docker image inspect -f '{{index .Config.Labels "org.plone-in-a-box.backend-addons"}}' "$1" 2>/dev/null; }
for s in "${SERVICES[@]}"; do
  NEW[$s]=$(docker image inspect -f '{{.Id}}' "${REF[$s]}")
  [[ "${NEW[$s]}" == "${OLD[$s]}" ]] && continue
  if grep -qxF "${NEW[$s]}" "$STATE_DIR/failed-images" 2>/dev/null; then
    docker tag "${OLD[$s]}" "${REF[$s]}"
    NOTES+=("Skipped the new ${s} image (${REF[$s]}): the site didn't come back with it last time.")
    continue
  fi
  if [[ "$s" == frontend && "$(label "${OLD[$s]}")" != "$(label "${NEW[$s]}")" ]]; then
    docker tag "${OLD[$s]}" "${REF[$s]}"
    NOTES+=("Skipped the new frontend image: it needs other backend add-ons ($(label "${NEW[$s]}")), so update it by hand; see ${GUIDE}")
    continue
  fi
  CHANGED+=("$s")
done
put_back() { for s in "${CHANGED[@]}"; do docker tag "${OLD[$s]}" "${REF[$s]}"; done; }

if (( ${#CHANGED[@]} == 0 )); then
  if (( ${#NOTES[@]} )); then
    finish 0 "Not updated: ${BEFORE}" "$(printf '%s\n' "${NOTES[@]}")"
  fi
  finish 0 "Up to date: ${BEFORE}"
fi

install -d -m 700 "$BACKUP_DIR"
DUMP="$BACKUP_DIR/plone-$(date +%F-%H%M).sql.gz"
say "Backing up the database to ${DUMP}"
compose exec -T db pg_dump -U plone plone | gzip > "${DUMP}.part"
status=("${PIPESTATUS[@]}")
if [[ "${status[0]}" != 0 || "${status[1]}" != 0 ]]; then
  rm -f "${DUMP}.part"
  put_back
  finish 1 "Not updated: backing up the database failed" "Nothing was changed. The reason is in $LOG_FILE."
fi
mv "${DUMP}.part" "$DUMP"
# Keep the three newest dumps (named by this script, so ls is safe).
# shellcheck disable=SC2012
ls -1t "$BACKUP_DIR"/plone-*.sql.gz | tail -n +4 | xargs -r rm -f

say "Updating ${CHANGED[*]}"
if compose up -d --wait --wait-timeout "$HEALTH_TIMEOUT" && site_ok; then
  docker image prune -f >/dev/null
  AFTER=$(versions)
  if [[ "$AFTER" == "$BEFORE" ]]; then
    summary="Updated: new builds of ${AFTER} (${CHANGED[*]})"
  else
    summary="Updated: ${BEFORE} -> ${AFTER}"
  fi
  finish 0 "$summary" "$(printf '%s\n' "Database backup from before the update: ${DUMP}" "${NOTES[@]}")"
fi

say "The site didn't come back; going back to the previous images"
for s in "${CHANGED[@]}"; do echo "${NEW[$s]}" >> "$STATE_DIR/failed-images"; done
put_back
if (( ${#CHANGED[@]} == 1 )); then
  undone="the new ${CHANGED[0]} image, so it runs the previous one again; that build is skipped"
else
  undone="the new ${CHANGED[*]} images, so it runs the previous ones again; those builds are skipped"
fi
if compose up -d --wait --wait-timeout "$ROLLBACK_TIMEOUT" && site_ok; then
  finish 1 "Update failed and was undone: back on ${BEFORE}" \
    "$(printf '%s\n' "The site didn't come back with ${undone} from now on. The reason is in ${LOG_FILE}." "Database backup from before the update: ${DUMP}")"
fi
finish 2 "Update failed, and going back failed too: the site may be down" \
  "$(printf '%s\n' "Check: sudo docker compose --project-directory ${APP_DIR} ps" "Database backup from before the update: ${DUMP}" "The log is in ${LOG_FILE}.")"
PLONE_UPDATE_EOF
chmod 755 /usr/local/bin/plone-update

# Run inside the backend by plone-update and setup: emails a message to MAIL_TO
# (or else the site's own address) with the site's mail settings (Site Setup >
# Mail), if it has them.
cat > "$APP_DIR/send_mail.py" <<'EOF'
import os
import smtplib
from email.message import EmailMessage
from plone.registry.interfaces import IRegistry
from zope.component import getUtility
from zope.component.hooks import setSite

app = globals()["app"]
setSite(app["Plone"])
registry = getUtility(IRegistry)
address = registry.get("plone.email_from_address")
host = registry.get("plone.smtp_host")
if not address or not host:
    print("NO_MAIL_SETTINGS")
else:
    msg = EmailMessage()
    msg["Subject"] = os.environ["MAIL_SUBJECT"]
    msg["From"] = f'{registry.get("plone.email_from_name") or "Plone"} <{address}>'
    msg["To"] = os.environ.get("MAIL_TO") or address
    msg.set_content(os.environ["MAIL_BODY"])
    port = registry.get("plone.smtp_port") or 25
    user = registry.get("plone.smtp_userid")
    try:
        smtp_class = smtplib.SMTP_SSL if port == 465 else smtplib.SMTP
        with smtp_class(host, port, timeout=60) as smtp:
            smtp.ehlo()
            if port != 465 and smtp.has_extn("starttls"):
                smtp.starttls()
                smtp.ehlo()
            if user:
                smtp.login(user, registry.get("plone.smtp_pass") or "")
            smtp.send_message(msg)
        print("MAIL_SENT")
    except Exception as e:
        print(f"MAIL_FAILED {e!r}")
EOF

# Nightly database backup, and a weekly pack: sudo plone-backup, and every
# night through plone-backup.timer.
cat > /usr/local/bin/plone-backup <<'PLONE_BACKUP_EOF'
#!/bin/bash
# A database backup in /var/backups/plone (the three newest are kept, counting
# those plone-update takes), and once a week a pack: it removes the history of
# changes older than 7 days, which otherwise makes the database grow forever.
# PostgreSQL then reuses the space. It waits while plone-update runs.
# Usage: sudo plone-backup        (also run every night by plone-backup.timer)
#        sudo plone-backup pack   (pack now, after the backup)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-backup" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
flock -w 10800 9 || { echo "plone-update is still running; no backup this time" >&2; exit 1; }
exec >>/var/log/plone-backup.log 2>&1
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
compose() { docker compose --project-directory /opt/plone "$@"; }
problem() {
  say "$1"
  /usr/local/lib/plone-in-a-box/alert "Plone in a Box: backup problem ($(cat "$STATE_DIR/site-url" 2>/dev/null || hostname))" \
    "$1. The log is in /var/log/plone-backup.log on the server." >/dev/null 2>&1
}
fail() {
  problem "$1"
  exit 1
}

install -d -m 700 "$BACKUP_DIR"
# A full disk stops backups, updates and the site, so say so once it's over
# 85% full, and again at every 5 points more.
used=$(df --output=pcent / | tail -n 1 | tr -dc '0-9')
warned=$(cat "$STATE_DIR/disk-warned" 2>/dev/null || echo 0)
if (( used > 85 && used >= warned + 5 )); then
  problem "The server's disk is ${used}% full: $(df -h --output=used,size,avail / | tail -n 1 | awk '{print $1 " of " $2 " used, " $3 " free"}'). Free some space (sudo docker image prune -a removes images the site doesn't use), or move to a bigger server"
  echo "$used" > "$STATE_DIR/disk-warned"
elif (( used <= 80 )); then
  rm -f "$STATE_DIR/disk-warned"
fi
# Room for twice the last backup, at least 200 MB, so the disk doesn't fill up.
# shellcheck disable=SC2012
last=$(ls -1t "$BACKUP_DIR"/plone-*.sql.gz 2>/dev/null | head -n 1)
need=$(( ${last:+$(stat -c %s "$last") * 2 +} 0 ))
(( need > 200000000 )) || need=200000000
(( $(df --output=avail -B1 "$BACKUP_DIR" | tail -n 1) > need )) || fail "No backup: the disk is nearly full"
DUMP="$BACKUP_DIR/plone-$(date +%F-%H%M).sql.gz"
compose exec -T db pg_dump -U plone plone | gzip > "$DUMP.part"
[[ "${PIPESTATUS[*]}" == "0 0" ]] || { rm -f "$DUMP.part"; fail "The database backup failed"; }
mv "$DUMP.part" "$DUMP"
say "Backed up the database to $DUMP"
# The server's own settings next to it: setup's .env (versions, images,
# add-ons) and compose file, and the nginx site. The content is all in the
# database; these save redoing settings by hand on a new server.
CONFIG="${DUMP%.sql.gz}.config.tar.gz"
tar -czf "$CONFIG" -C / --ignore-failed-read opt/plone/.env opt/plone/docker-compose.yml \
  etc/nginx/sites-available/plone 2>/dev/null && chmod 600 "$CONFIG" && say "Saved the server's settings to $CONFIG"
# shellcheck disable=SC2012
ls -1t "$BACKUP_DIR"/plone-*.sql.gz | tail -n +4 | xargs -r rm -f
# shellcheck disable=SC2012
ls -1t "$BACKUP_DIR"/plone-*.config.tar.gz 2>/dev/null | tail -n +4 | xargs -r rm -f
# A copy off the server, encrypted, if sudo plone-offsite setup was run.
if [[ -s "$STATE_DIR/offsite.conf" ]]; then
  /usr/local/bin/plone-offsite upload "$DUMP" || problem "Copying the backup off the server failed"
  if [[ -s "$CONFIG" ]]; then
    /usr/local/bin/plone-offsite upload "$CONFIG" || problem "Copying the server's settings off the server failed"
  fi
fi

if [[ "${1:-}" == pack ]] || (( $(date +%s) - $(cat "$STATE_DIR/last-pack" 2>/dev/null || echo 0) > 597600 )); then
  say "Packing the database"
  compose run --rm --no-deps -T -e ADDONS= backend pack -d 7 || fail "Packing the database failed"
  date +%s > "$STATE_DIR/last-pack"
  say "Packed"
fi
PLONE_BACKUP_EOF
chmod 755 /usr/local/bin/plone-backup

# Restore a database backup: sudo plone-restore [FILE]. Also for moving a site
# to a new server: copy a backup there and restore it.
cat > /usr/local/bin/plone-restore <<'PLONE_RESTORE_EOF'
#!/bin/bash
# Put a database backup back: the site's pages, files, users and settings
# become what they were when the backup was taken. Takes a backup of the site
# as it is now first, and goes back to it if the restore fails.
# Usage: sudo plone-restore               (list the backups)
#        sudo plone-restore FILE [--yes]  (restore FILE, a plone-*.sql.gz backup)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-restore" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
compose() { docker compose --project-directory /opt/plone "$@"; }
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
if [[ $# -eq 0 ]]; then
  echo "Backups on this server, newest first:"
  # shellcheck disable=SC2012
  ls -1t "$BACKUP_DIR"/*.sql.gz 2>/dev/null | while read -r f; do
    printf '  %s  (%s, %s)\n' "$f" "$(du -h "$f" | cut -f1)" "$(date -r "$f" '+%F %H:%M')"
  done
  echo "Restore one with: sudo plone-restore FILE"
  exit 0
fi
FILE=$1
[[ -s "$FILE" ]] || { echo "No backup at $FILE" >&2; exit 1; }
gzip -t "$FILE" 2>/dev/null || { echo "$FILE isn't a complete .sql.gz backup" >&2; exit 1; }
# (Reading through <(...): with pipefail, zcat stopped early by head would
# count as a failure.)
grep -q 'PostgreSQL database dump' <(zcat "$FILE" 2>/dev/null | head -c 4000) \
  || { echo "$FILE isn't a database backup made by plone-backup or pg_dump" >&2; exit 1; }
if [[ "${2:-}" != --yes ]]; then
  echo "This replaces everything on the site (pages, files, users, settings) with the backup"
  echo "$FILE, from $(date -r "$FILE" '+%F %H:%M'). A backup of the site as it is now is taken first."
  read -r -p "Type yes to continue: " answer
  [[ "$answer" == yes ]] || { echo "Nothing was changed."; exit 1; }
fi
mkdir -p "$STATE_DIR"
exec 9>"$STATE_DIR/update.lock"
flock -w 3600 9 || { echo "plone-update or plone-backup is still running; try again later" >&2; exit 1; }
exec > >(tee -a /var/log/plone-restore.log) 2>&1
LOG_TEE_PID=$!
trap 'exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true' EXIT

load() {  # load FILE: replace the database with FILE, with the site stopped
  compose stop backend frontend >/dev/null 2>&1
  compose exec -T db psql -q -U plone -d postgres -v ON_ERROR_STOP=1 \
    -c 'DROP DATABASE IF EXISTS plone WITH (FORCE)' -c 'CREATE DATABASE plone OWNER plone' || return 1
  zcat "$1" | compose exec -T db psql -q -U plone -d plone -v ON_ERROR_STOP=1 >/dev/null || return 1
}
start() {  # start the site and wait for it
  compose up -d >/dev/null 2>&1
  for _ in $(seq 1 60); do
    curl -fs -m 10 -o /dev/null http://127.0.0.1:8080/ok && curl -fs -m 30 -o /dev/null http://127.0.0.1:3000/ && return 0
    sleep 10
  done
  return 1
}

# The site as it is now, named so plone-backup's rotation keeps it.
BEFORE="$BACKUP_DIR/before-restore-$(date +%F-%H%M%S).sql.gz"
install -d -m 700 "$BACKUP_DIR"
say "Backing up the site as it is now to $BEFORE"
compose exec -T db pg_dump -U plone plone | gzip > "$BEFORE.part"
[[ "${PIPESTATUS[*]}" == "0 0" ]] || { rm -f "$BEFORE.part"; say "That backup failed, so nothing was changed"; exit 1; }
mv "$BEFORE.part" "$BEFORE"
say "Restoring $FILE"
if load "$FILE" && start; then
  say "Restored $FILE. Log in with the passwords from the time of that backup."
  exit 0
fi
say "Restoring $FILE failed; putting back the site as it was"
if load "$BEFORE" && start; then
  say "The site is back as it was before. Nothing was restored."
else
  say "Putting the site back failed too. The backup of the site as it was is $BEFORE"
fi
exit 1
PLONE_RESTORE_EOF
chmod 755 /usr/local/bin/plone-restore

# Encrypted copies of the nightly backups in S3-compatible storage (Cloudflare
# R2, AWS S3, Backblaze B2, DigitalOcean Spaces, Hetzner and others), once
# the owner runs sudo plone-offsite setup.
cat > /usr/local/bin/plone-offsite <<'PLONE_OFFSITE_EOF'
#!/bin/bash
# Copies of the nightly backups off the server, encrypted with a passphrase,
# in S3-compatible storage.
# Usage: sudo plone-offsite setup        (storage settings and passphrase; a test upload)
#        sudo plone-offsite list         (the copies in the bucket, from every server using it)
#        sudo plone-offsite fetch NAME   (download and decrypt one into /var/backups/plone)
#        sudo plone-offsite upload FILE  (done by plone-backup every night)
#        sudo plone-offsite off          (stop making copies; the bucket is left as it is)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Please run this with sudo: sudo plone-offsite ${1:-}" >&2; exit 1; }
STATE_DIR=/var/lib/plone-in-a-box
BACKUP_DIR=/var/backups/plone
CONF=$STATE_DIR/offsite.conf
RCLONE_CONF=$STATE_DIR/offsite-rclone.conf
say() { printf '[%s] %s\n' "$(date '+%F %T')" "$*"; }
die() { echo "$*" >&2; exit 1; }
# rclone from its official image (Ubuntu's is from 2022); plone-update pulls
# newer builds of the same major version every week.
RCLONE_IMAGE=rclone/rclone:1
# (-i only where rclone reads standard input: elsewhere, inside a while-read
# loop, docker would swallow the rest of the loop's input.)
rc() { docker run --rm ${RC_STDIN:+-i} --network host -v "$RCLONE_CONF:/config/rclone/rclone.conf:ro" \
  -v "$BACKUP_DIR:$BACKUP_DIR" "$RCLONE_IMAGE" --retries 3 --low-level-retries 5 "$@"; }
# gpg with a throwaway home, so root's keyring isn't touched.
crypt() { local home; home=$(mktemp -d); gpg --homedir "$home" --batch --yes --quiet --pinentry-mode loopback \
  --passphrase-file "$STATE_DIR/offsite-passphrase" "$@"; local status=$?; rm -rf "$home"; return $status; }
load() {
  [[ -s "$CONF" ]] || die "Copies off the server aren't set up. Run: sudo plone-offsite setup"
  # shellcheck disable=SC1090
  source "$CONF"
}

case "${1:-}" in
setup)
  echo "Downloading rclone ($RCLONE_IMAGE)"
  docker pull -q "$RCLONE_IMAGE" >/dev/null || die "Downloading $RCLONE_IMAGE failed"
  install -d -m 700 "$BACKUP_DIR"
  command -v gpg >/dev/null || { apt-get install -y -qq gnupg >/dev/null || die "Installing gnupg failed"; }
  ask() {  # ask VAR "question" [default] [secret]: from the environment (OFFSITE_VAR) or the keyboard
    local var=$1 q=$2 def=${3:-} env="OFFSITE_$1" v
    v=${!env:-}
    if [[ -z "$v" ]]; then
      if [[ -n "${4:-}" ]]; then read -r -s -p "$q: " v; echo; else read -r -p "$q${def:+ [$def]}: " v; fi
    fi
    printf -v "$var" '%s' "${v:-$def}"
  }
  echo "Copies of the nightly backups go to S3-compatible storage, encrypted. Make a private bucket and an"
  echo "access key that can read and write it at your storage service first. Endpoints, for example:"
  echo "  Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com (region: auto)"
  echo "  AWS S3: https://s3.us-east-1.amazonaws.com (region: us-east-1)"
  echo "  Backblaze B2: https://s3.us-west-004.backblazeb2.com   DigitalOcean Spaces: https://nyc3.digitaloceanspaces.com"
  echo "  Hetzner: https://fsn1.your-objectstorage.com"
  ask ENDPOINT "Endpoint"
  default_region=""
  [[ "$ENDPOINT" == *.r2.cloudflarestorage.com* ]] && default_region=auto
  [[ "$ENDPOINT" =~ s3[.-]([a-z0-9-]+)\.amazonaws\.com ]] && default_region=${BASH_REMATCH[1]}
  ask REGION "Region (Enter if the service doesn't use one)" "$default_region"
  ask BUCKET "Bucket"
  ask ACCESS_KEY "Access key ID"
  ask SECRET_KEY "Secret access key" "" secret
  ask KEEP "How many copies to keep" 14
  site=$(sed -E 's#^https?://##; s#/.*##' "$STATE_DIR/site-url" 2>/dev/null || hostname)
  ask FOLDER "Folder in the bucket for this server's copies" "plone-in-a-box/$site"
  # (http only for storage on the server itself, such as a test.)
  [[ "$ENDPOINT" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/?$ || "$ENDPOINT" =~ ^http://(localhost|127\.0\.0\.1)(:[0-9]+)?/?$ ]] \
    || die "The endpoint has to look like https://host"
  [[ "$BUCKET" =~ ^[A-Za-z0-9._-]+$ ]] || die "That bucket name isn't valid"
  [[ "$KEEP" =~ ^[1-9][0-9]*$ ]] || die "How many to keep has to be a number"
  [[ "$FOLDER" =~ ^[A-Za-z0-9._/-]+$ ]] || die "Use letters, digits, dots, dashes and slashes for the folder"
  [[ -n "$ACCESS_KEY" && -n "$SECRET_KEY" ]] || die "The access key and secret are both needed"
  echo "Passphrase: press Enter to make a new one, or paste the one another server uses, so this server can"
  echo "read that server's copies (for moving a site)."
  ask PASSPHRASE "Passphrase" "" secret
  new_passphrase=0
  [[ -n "$PASSPHRASE" ]] || { PASSPHRASE=$(openssl rand -base64 30 | tr -d '/+=' | cut -c1-32); new_passphrase=1; }
  # rclone's provider: AWS and R2 have their own, the rest are "Other".
  provider=Other
  [[ "$ENDPOINT" == *.amazonaws.com* ]] && provider=AWS
  [[ "$ENDPOINT" == *.r2.cloudflarestorage.com* ]] && provider=Cloudflare
  umask 077
  cat > "$RCLONE_CONF" <<CONF
[offsite]
type = s3
provider = $provider
access_key_id = $ACCESS_KEY
secret_access_key = $SECRET_KEY
endpoint = ${ENDPOINT%/}
region = ${REGION:-us-east-1}
no_check_bucket = true
CONF
  printf '%s' "$PASSPHRASE" > "$STATE_DIR/offsite-passphrase"
  printf 'BUCKET=%q\nFOLDER=%q\nKEEP=%q\n' "$BUCKET" "${FOLDER%/}" "$KEEP" > "$CONF.new"
  test_name="setup-test-$(date +%s).txt"
  if ! echo "Plone in a Box test file" | RC_STDIN=1 rc rcat "offsite:$BUCKET/${FOLDER%/}/$test_name" \
     || ! rc lsf "offsite:$BUCKET/${FOLDER%/}/" | grep -qx "$test_name" \
     || ! rc deletefile "offsite:$BUCKET/${FOLDER%/}/$test_name"; then
    rm -f "$CONF.new" "$RCLONE_CONF" "$STATE_DIR/offsite-passphrase"
    die "Uploading, listing or deleting a test file failed (see the message above). Check the endpoint, bucket and key, and that the key can read, write and delete in the bucket."
  fi
  mv "$CONF.new" "$CONF"
  echo
  echo "Copies off the server are set up: every night's backup goes to $BUCKET/${FOLDER%/}/, encrypted, and the"
  echo "$KEEP newest are kept."
  if (( new_passphrase )); then
    echo
    echo "The passphrase for the copies is:  $PASSPHRASE"
    echo "Keep it in your password manager. Without it, the copies can't be read, also if this server is lost."
  fi
  echo "Make the first copy now with: sudo plone-backup"
  ;;
upload)
  load; FILE=${2:-}
  [[ -s "$FILE" ]] || die "No backup at $FILE"
  name="$(basename "$FILE").gpg"
  tmp=$(mktemp "$BACKUP_DIR/.offsite-XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  crypt --symmetric --cipher-algo AES256 -o "$tmp" "$FILE" || die "Encrypting $FILE failed"
  rc copyto "$tmp" "offsite:$BUCKET/$FOLDER/$name" || die "Uploading to $BUCKET/$FOLDER failed"
  say "Copied $name to $BUCKET/$FOLDER"
  # Keep the newest KEEP copies of this kind (database or settings; the names
  # sort by date).
  kind='\.sql\.gz\.gpg$'
  [[ "$name" == *.config.tar.gz.gpg ]] && kind='\.config\.tar\.gz\.gpg$'
  rc lsf --files-only "offsite:$BUCKET/$FOLDER/" | grep -E "^plone-.*$kind" | sort -r | tail -n +"$((KEEP + 1))" \
    | while read -r old; do rc deletefile "offsite:$BUCKET/$FOLDER/$old" && say "Removed the old copy $old"; done
  ;;
list)
  load
  echo "Copies in $BUCKET, by folder (this server uses $FOLDER):"
  rc lsf -R --files-only --format "tsp" "offsite:$BUCKET/" | grep -E '\.(sql|config\.tar)\.gz\.gpg' | sort -t ';' -k1,1r \
    | awk -F';' '{printf "  %s  %s  %.1f MB\n", substr($1, 1, 16), $3, $2 / 1048576}'
  echo "Download one with: sudo plone-offsite fetch FOLDER/NAME, then restore it with sudo plone-restore."
  ;;
fetch)
  load; NAME=${2:-}
  [[ "$NAME" =~ ^[A-Za-z0-9._/-]+\.(sql|config\.tar)\.gz\.gpg$ ]] || die "Give the name as plone-offsite list shows it"
  [[ "$NAME" == */* ]] || NAME="$FOLDER/$NAME"
  install -d -m 700 "$BACKUP_DIR"
  out="$BACKUP_DIR/offsite-$(basename "$NAME" .gpg)"
  tmp=$(mktemp "$BACKUP_DIR/.offsite-XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  rc copyto "offsite:$BUCKET/$NAME" "$tmp" || die "Downloading $NAME failed"
  crypt -d -o "$out" "$tmp" || { rm -f "$out"; die "Decrypting $NAME failed: is this the passphrase it was made with?"; }
  echo "Downloaded and decrypted to $out"
  if [[ "$out" == *.sql.gz ]]; then
    echo "Restore it with: sudo plone-restore $out"
  else
    echo "It holds the server's settings: see them with: tar -tzvf $out"
  fi
  ;;
off)
  rm -f "$CONF" "$RCLONE_CONF" "$STATE_DIR/offsite-passphrase"
  echo "Copies off the server are off. The copies already in the bucket are left as they are."
  ;;
*)
  sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
  ;;
esac
