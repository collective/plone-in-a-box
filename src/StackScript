#!/bin/bash
#
# Plone in a Box(TM) -- provision a single Ubuntu server running Plone 6
# (backend + Volto frontend + PostgreSQL) behind nginx.
#
# Used as:
#   - a Linode StackScript (the UDF lines below become form fields),
#   - EC2 user data via src/aws/main.tf, and
#   - DigitalOcean Droplet user data via src/digitalocean/main.tf
#     (both export the same variables first).
#
# Tested target: Ubuntu 26.04 or 24.04 LTS (amd64 or arm64). Run as root.
#
# <UDF name="ADMIN_PASSWORD" label="Plone admin password, at least 12 characters. Leave empty to have one generated and saved on the server" default="" />
# <UDF name="DOMAIN" label="Domain name for the site, optional. DNS must already point here to get HTTPS" default="" />
# <UDF name="LETSENCRYPT_EMAIL" label="Email for Lets Encrypt certificate notices, required if a domain is set" default="" />
# <UDF name="SITE_TIMEZONE" label="Site time zone" default="UTC" example="America/Chicago" />
# <UDF name="SITE_LANGUAGE" label="Site language: a language code such as en, de, fr, es or pt-br" default="en" example="de" />
# <UDF name="STARTER_CONTENT" label="Starter content: yes creates the sample pages a new site or Plone distribution comes with; no starts with an empty site" oneOf="yes,no" default="yes" />
# <UDF name="PLONE_VERSION" label="Plone backend image tag" default="6.2" />
# <UDF name="VOLTO_VERSION" label="Volto frontend image tag" default="19" />
# <UDF name="ADDONS" label="Backend add-ons, optional: Python package names separated by spaces, for example collective.easyform. Activate them afterwards in Site Setup, Add-ons" default="" />
# <UDF name="FRONTEND_IMAGE" label="Frontend image, optional: a ready-made Plone in a Box image such as ghcr.io/collective/plone-in-a-box-frontend:19-vlt (Volto Light Theme), or your own. Empty: the standard Volto image" default="" />
# <UDF name="BACKEND_IMAGE" label="Backend image, optional: replaces the official Plone backend, for example a Plone distribution such as ghcr.io/kitconcept/kitconcept-intranet-backend:3.11 (with its frontend image above), or your own project's. Empty: the official Plone backend" default="" />
# <UDF name="REGISTRY_USER" label="Registry login for private images, optional: the username for the registry of the frontend and backend images above, for example your GitHub username for ghcr.io" default="" />
# <UDF name="REGISTRY_TOKEN" label="Registry token: a read-only access token for that registry, such as a GitHub token with only read:packages" default="" />
# <UDF name="DEMO_USER" label="Demo login, optional: a username such as demo, for people you let try the site. Setup creates it with a generated password, saved next to the admin password" default="" />
# <UDF name="DEMO_PASSWORD" label="Demo login password, optional, at least 12 characters. Leave empty to have one generated and saved next to the admin password" default="" />
# <UDF name="DEMO_ROLES" label="Roles of the demo login, optional, separated by commas, for example Editor or Site Administrator. Empty: what the frontend image suggests, or Site Administrator" default="" />
# <UDF name="AUTO_UPDATE" label="Automatic updates: install Plone, Volto and PostgreSQL patch releases every week, after a database backup, and undo them if the site doesn't come back" oneOf="yes,no" default="yes" />
# <UDF name="NOTIFY_URL" label="Notification URL, optional: update reports go here, for example https://ntfy.sh/your-own-topic, or a Slack, Discord, Google Chat, Mattermost or Microsoft Teams webhook" default="" />
# <UDF name="SMTP_HOST" label="Email: SMTP server of an email relay service, optional, for example mail.smtp2go.com. Empty: the site doesn't send email" default="" />
# <UDF name="SMTP_PORT" label="Email: SMTP port" default="587" />
# <UDF name="SMTP_USER" label="Email: SMTP username" default="" />
# <UDF name="SMTP_PASSWORD" label="Email: SMTP password" default="" />
# <UDF name="EMAIL_FROM" label="Email: the site's From address, at a domain the email service has verified, for example plone@example.org" default="" />
# <UDF name="REPORT_EMAIL" label="Email: your address for a test email and the update reports. Empty: the From address" default="" />
#
# After provisioning finishes, open the site and log in as "admin" with the
# password you chose. If you left it empty, a password is generated: log in over
# SSH as root and read /root/plone-credentials.txt.

set -Eeuo pipefail
export DEBIAN_FRONTEND=noninteractive

# Keep a copy of all output in one place on every provider.
LOG_FILE=/var/log/plone-in-a-box.log
exec > >(tee -a "$LOG_FILE") 2>&1
LOG_TEE_PID=$!
# On exit, wait for tee to write the last lines: when setup resumes after a
# restart, systemd stops everything in the service as soon as this script ends.
flush_log() { exec >/dev/null 2>&1; wait "$LOG_TEE_PID" 2>/dev/null || true; }
trap flush_log EXIT

ADMIN_PASSWORD="${ADMIN_PASSWORD:-}"
DOMAIN="${DOMAIN:-}"
LETSENCRYPT_EMAIL="${LETSENCRYPT_EMAIL:-}"
# For automated tests only: yes uses Let's Encrypt's test service for the IP
# address certificate (its certificates aren't trusted by browsers).
LETSENCRYPT_STAGING="${LETSENCRYPT_STAGING:-}"
SITE_TIMEZONE="${SITE_TIMEZONE:-UTC}"
# Site language, as a Plone language code (en, de, pt-br); a code setup doesn't
# recognize as one falls back to English, with a note.
SITE_LANGUAGE="$(printf '%s' "${SITE_LANGUAGE:-en}" | tr -d ' \t\r\n' | tr 'A-Z_' 'a-z-')"
LANGUAGE_NOTE=""
if [[ ! "$SITE_LANGUAGE" =~ ^[a-z]{2,3}(-[a-z]{2,4})?$ ]]; then
  LANGUAGE_NOTE="The site language \"$SITE_LANGUAGE\" isn't a language code such as en or pt-br, so the site is in English."
  SITE_LANGUAGE=en
fi
# Starter content: the sample pages a new site (or a Plone distribution) comes
# with; no for an empty site.
case "${STARTER_CONTENT:-yes}" in
  [Nn]|[Nn][Oo]|[Ff]alse|0|[Oo]ff) STARTER_CONTENT=no ;;
  *) STARTER_CONTENT=yes ;;
esac
PLONE_VERSION="${PLONE_VERSION:-6.2}"
VOLTO_VERSION="${VOLTO_VERSION:-19}"
POSTGRES_VERSION="${POSTGRES_VERSION:-17}"
# Backend add-ons: Python packages that the plone/plone-backend image installs
# with pip each time the backend container starts (its ADDONS variable).
# Split on any whitespace, without expanding wildcards such as "==1.*".
read -ra ADDON_LIST <<< "$(printf '%s' "${ADDONS:-}" | tr '\n\r\t' '   ')"
ADDONS="${ADDON_LIST[*]}"
# Frontend image: replaces plone/plone-frontend:${VOLTO_VERSION}. Ready-made
# Plone in a Box images say in their labels which backend add-ons and site
# behaviors they need; setup installs and activates those too.
FRONTEND_IMAGE="$(printf '%s' "${FRONTEND_IMAGE:-}" | tr -d ' \t\r\n')"
# Backend image: replaces plone/plone-backend:${PLONE_VERSION}, for example a
# Plone distribution or a project made with cookieplone. It has to start like
# the official image (create-site, run, pack); setup checks that it does.
BACKEND_IMAGE="$(printf '%s' "${BACKEND_IMAGE:-}" | tr -d ' \t\r\n')"
# Registry login for private frontend or backend images: one username and
# token for the registries those images are on. The token is never logged;
# Docker keeps the login in /root/.docker/config.json, so updates can pull the
# images too.
REGISTRY_USER="$(printf '%s' "${REGISTRY_USER:-}" | tr -d ' \t\r\n')"
REGISTRY_TOKEN="$(printf '%s' "${REGISTRY_TOKEN:-}" | tr -d ' \t\r\n')"
# Demo login: an extra Plone user, created once at setup, for letting other
# people try the site (DEMO_USER, with the roles DEMO_ROLES, separated by
# commas). Empty: the roles the frontend image's label suggests, or Site
# Administrator. DEMO_ROLE is the one-role setting of 2.13; its old default,
# Site Administrator, counts as no choice.
DEMO_USER="$(printf '%s' "${DEMO_USER:-}" | tr -d ' \t\r\n')"
DEMO_PASSWORD="${DEMO_PASSWORD:-}"
DEMO_ROLES="$(printf '%s' "${DEMO_ROLES:-}" | tr '\t\r\n' '   ')"
if [[ -z "${DEMO_ROLES// /}" && -n "${DEMO_ROLE:-}" && "$DEMO_ROLE" != "Site Administrator" ]]; then
  DEMO_ROLES="$DEMO_ROLE"
fi
# Notification URL: reports from setup and plone-update are posted here.
NOTIFY_URL="$(printf '%s' "${NOTIFY_URL:-}" | tr -d ' \t\r\n')"
# Email through a relay service (Site Setup > Mail). The password is never
# logged; Plone keeps it in its settings, like Site Setup > Mail does.
SMTP_HOST="$(printf '%s' "${SMTP_HOST:-}" | tr -d ' \t\r\n')"
SMTP_PORT="$(printf '%s' "${SMTP_PORT:-587}" | tr -d ' \t\r\n')"
SMTP_PORT="${SMTP_PORT:-587}"
SMTP_USER="$(printf '%s' "${SMTP_USER:-}" | tr -d '\r\n')"
SMTP_PASSWORD="$(printf '%s' "${SMTP_PASSWORD:-}" | tr -d '\r\n')"
EMAIL_FROM="$(printf '%s' "${EMAIL_FROM:-}" | tr -d ' \t\r\n')"
REPORT_EMAIL="$(printf '%s' "${REPORT_EMAIL:-}" | tr -d ' \t\r\n')"
# Automatic updates (plone-update.timer): on unless set to no.
case "${AUTO_UPDATE:-yes}" in
  [Nn]|[Nn][Oo]|[Ff]alse|0|[Oo]ff) AUTO_UPDATE=no ;;
  *) AUTO_UPDATE=yes ;;
esac

APP_DIR=/opt/plone
CREDENTIALS_FILE=/root/plone-credentials.txt

# Used when setup restarts the server once to finish installing updates and
# then continues after the restart (see "Restart once" below).
RESUME_DIR=/root/.plone-in-a-box-resume
RESUME_UNIT=/etc/systemd/system/plone-in-a-box-resume.service

log() { echo "[plone-in-a-box] $*"; }

# A Python package name with optional extras and version specifiers, such as
# collective.easyform or collective.easyform==4.2.0: nothing pip would read as
# an option, a URL or a file.
valid_addon() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(\[[A-Za-z0-9._,-]+\])?([~=!<>]=?=?[A-Za-z0-9.*+!_-]+)?(,[~=!<>]=?=?[A-Za-z0-9.*+!_-]+)*$ ]]
}
valid_email() { [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$ ]]; }
# A container image reference: [registry[:port]/]path[:tag][@sha256:digest].
valid_image() {
  [[ "$1" =~ ^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-]+[a-z0-9]+)*)*(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?(@sha256:[a-f0-9]{64})?$ ]]
}

# If this run is the continuation after that restart, make sure it only
# happens once, and remove the saved settings (they include the password).
# The unit file itself stays until the end of setup: removing it and
# reloading systemd while this run is going would make systemd forget the
# service's settings.
if [[ -e "$RESUME_UNIT" ]]; then
  log "Continuing setup after the restart"
  systemctl disable plone-in-a-box-resume.service || true
  rm -f "$RESUME_DIR/settings"
fi

# --- Setup progress page -----------------------------------------------------
# While provisioning runs, nginx serves a page at the server's address that
# shows the current step and refreshes itself; when Plone is ready, the next
# refresh shows the site. If provisioning fails, the page says so.

PROGRESS_DIR=/var/www/plone-in-a-box-setup
PROGRESS_STEPS=(
  "Preparing the server"
  "Installing Docker"
  "Securing the server"
  "Downloading Plone (the longest step)"
  "Creating your Plone site"
  "Starting Plone"
  "Finishing up"
)
CURRENT_STEP=0
STARTED_AT="${STARTED_AT:-$(date -u +"%H:%M UTC")}"

write_progress_page() {
  # write_progress_page <title> <message html> <body html> <refresh seconds, 0 for none>
  [[ -d "$PROGRESS_DIR" ]] || return 0
  local refresh=""
  if (( $4 > 0 )); then
    refresh="<meta http-equiv=\"refresh\" content=\"$4\">"
  fi
  cat > "$PROGRESS_DIR/index.html.tmp" <<EOF
<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">${refresh}
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>$1 - Plone in a Box</title>
<style>
body{font-family:system-ui,-apple-system,sans-serif;max-width:36rem;margin:3rem auto;padding:0 1rem;color:#1a1a1a;line-height:1.5}
h1{font-size:1.5rem;margin-bottom:.5rem}
ol{list-style:none;padding:0;margin:1.5rem 0}
li{margin:.5rem 0;padding-left:1.75rem;position:relative}
li span{position:absolute;left:0;width:1.25rem;text-align:center}
.done{color:#2e7d32}.now{font-weight:600}.todo{color:#888}.failed{color:#c62828;font-weight:600}
.small{color:#666;font-size:.875rem;margin-top:2rem}
code{background:#f2f2f2;padding:.1rem .3rem;border-radius:3px}
</style></head><body>
<h1>$1</h1>
<p>$2</p>
$3
<p class="small">Plone in a Box&trade; &middot; started ${STARTED_AT}</p>
</body></html>
EOF
  mv "$PROGRESS_DIR/index.html.tmp" "$PROGRESS_DIR/index.html"
}

step_list() {
  # step_list <state of the current step: now|failed>
  local i html="" cls mark
  for i in "${!PROGRESS_STEPS[@]}"; do
    if (( i + 1 < CURRENT_STEP )); then
      cls="done"; mark="&#10003;"
    elif (( i + 1 == CURRENT_STEP )); then
      cls=$1
      if [[ "$1" == failed ]]; then mark="&#10007;"; else mark="&rarr;"; fi
    else
      cls="todo"; mark=""
    fi
    html+="<li class=\"${cls}\"><span>${mark}</span>${PROGRESS_STEPS[i]}</li>"
  done
  echo "<ol>${html}</ol>"
}

progress() {
  # progress <step number, starting at 1>
  CURRENT_STEP=$1
  log "Step ${CURRENT_STEP}/${#PROGRESS_STEPS[@]}: ${PROGRESS_STEPS[CURRENT_STEP-1]}"
  write_progress_page "Your Plone site is being set up" \
    "This usually takes about 10 minutes. This page refreshes every 15 seconds and turns into your site when it's ready." \
    "$(step_list now)" 15
}

on_error() {
  log "Setup failed at line $1 (step ${CURRENT_STEP})"
  write_progress_page "Setup didn't finish" \
    "Something went wrong while setting up Plone. It's often a temporary download problem: deploying a new server usually fixes it. To see what happened, log in to the server as root and read <code>${LOG_FILE}</code>." \
    "$(step_list failed)" 0
}
trap 'on_error $LINENO' ERR

wait_for() {
  # wait_for <description> <timeout-seconds> <command...>
  local what=$1 timeout=$2 waited=0
  shift 2
  until "$@" >/dev/null 2>&1; do
    if (( waited >= timeout )); then
      log "Timed out after ${timeout}s waiting for ${what}"
      return 1
    fi
    sleep 5
    waited=$(( waited + 5 ))
  done
  log "${what} is ready"
}

# --- System packages ---------------------------------------------------------

# Install nginx first, so the progress page is up within a minute or two.
apt-get update -y
apt-get install -y nginx
mkdir -p "$PROGRESS_DIR"
cat > /etc/nginx/sites-available/plone-in-a-box-setup <<EOF
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  root ${PROGRESS_DIR};
  add_header Cache-Control "no-store" always;
  location / {
    try_files /index.html =404;
  }
}
EOF
rm -f /etc/nginx/sites-enabled/default
ln -sf /etc/nginx/sites-available/plone-in-a-box-setup /etc/nginx/sites-enabled/plone-in-a-box-setup
progress 1
nginx -t
systemctl reload nginx || systemctl restart nginx

log "Updating system packages"
# full-upgrade, unlike upgrade, also installs updates that need new packages
# (such as a new kernel).
apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
apt-get install -y ca-certificates curl gnupg ufw openssl

# --- Swap (Plone + Volto + PostgreSQL do not fit comfortably in 1 GB) -------
# Add a 2 GB swap file when memory plus existing swap is under about 3 GB.
# Some providers include a small swap disk (Linode: 512 MB), which isn't
# enough on its own for a 1 GB server.

mem_kb=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
swap_kb=$(awk '/SwapTotal/ {print $2}' /proc/meminfo)
if (( mem_kb + swap_kb < 3000000 )) && [[ ! -e /swapfile ]]; then
  log "Adding a 2 GB swap file"
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile ' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# --- Restart once if the updates need it -------------------------------------
# A new kernel (and some other updates) only takes effect after a restart.
# Restart now, before Plone is installed, and continue this script
# automatically afterwards, so the finished site never goes down for it.
# nginx keeps showing the progress page across the restart.

if [[ -f /var/run/reboot-required && ! -e "$RESUME_DIR/restarted" ]]; then
  if [[ -f "$0" ]]; then
    log "Restarting the server to finish installing updates; setup continues automatically afterwards"
    install -d -m 700 "$RESUME_DIR"
    cp "$0" "$RESUME_DIR/setup.sh"
    (
      umask 077
      for var in ADMIN_PASSWORD DOMAIN LETSENCRYPT_EMAIL SITE_TIMEZONE SITE_LANGUAGE STARTER_CONTENT PLONE_VERSION VOLTO_VERSION POSTGRES_VERSION ADDONS FRONTEND_IMAGE BACKEND_IMAGE REGISTRY_USER REGISTRY_TOKEN DEMO_USER DEMO_PASSWORD DEMO_ROLES AUTO_UPDATE NOTIFY_URL SMTP_HOST SMTP_PORT SMTP_USER SMTP_PASSWORD EMAIL_FROM REPORT_EMAIL LETSENCRYPT_STAGING STARTED_AT; do
        printf 'export %s=%q\n' "$var" "${!var}"
      done > "$RESUME_DIR/settings"
    )
    touch "$RESUME_DIR/restarted"
    cat > "$RESUME_UNIT" <<EOF
[Unit]
Description=Continue Plone in a Box setup after the restart
Wants=network-online.target
After=network-online.target

[Service]
# simple, not oneshot: setup takes several minutes, and systemd puts a time
# limit on starting a oneshot service.
Type=simple
ExecStart=/bin/bash -c '. ${RESUME_DIR}/settings && exec /bin/bash ${RESUME_DIR}/setup.sh'

[Install]
WantedBy=multi-user.target
EOF
    systemctl daemon-reload
    systemctl enable plone-in-a-box-resume.service
    write_progress_page "Restarting the server" \
      "The server is restarting to finish installing updates, and setup then continues by itself. This page refreshes every 15 seconds; if your browser shows an error while the server restarts, reload the page in a minute." \
      "$(step_list now)" 15
    trap - ERR
    systemctl reboot
    exit 0
  else
    log "Updates need a restart, but this script can't be saved to continue afterwards; restart the server after setup"
  fi
fi

# --- Docker Engine + Compose plugin (official repository) -------------------

progress 2
log "Installing Docker"
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
# shellcheck disable=SC1091
. /etc/os-release
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu ${VERSION_CODENAME} stable" \
  > /etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
systemctl enable --now docker

# --- Firewall ----------------------------------------------------------------
# Only SSH and HTTP(S) are reachable from outside. The containers publish
# their ports on 127.0.0.1 only, so Docker's iptables rules don't bypass this.

progress 3
log "Configuring firewall"
ufw allow OpenSSH
ufw allow 'Nginx Full'
ufw --force enable

# --- Secrets -----------------------------------------------------------------

mkdir -p "$APP_DIR"
chmod 700 "$APP_DIR"

if [[ ! -f "$APP_DIR/.env" ]]; then
  log "Generating passwords"
  POSTGRES_PASSWORD=$(openssl rand -hex 24)
  ADMIN_PASSWORD_CHOSEN=0
  PASSWORD_NOTE=""
  if [[ -n "$ADMIN_PASSWORD" ]]; then
    if (( ${#ADMIN_PASSWORD} >= 12 )); then
      ADMIN_PASSWORD_CHOSEN=1
    else
      log "The admin password given is shorter than 12 characters; generating one instead"
      PASSWORD_NOTE="The password entered at deploy time was shorter than 12 characters, so this one was generated instead."
      ADMIN_PASSWORD=""
    fi
  fi
  if [[ -z "$ADMIN_PASSWORD" ]]; then
    ADMIN_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=')
  fi
  ADDONS_NOTE=""
  for addon in "${ADDON_LIST[@]}"; do
    if ! valid_addon "$addon"; then
      log "Not installing the backend add-ons: \"$addon\" isn't a Python package name"
      ADDONS_NOTE="The add-ons ($ADDONS) were not installed: \"$addon\" isn't a Python package name."
      ADDONS=""
      break
    fi
  done
  FRONTEND_NOTE=""
  if [[ -n "$FRONTEND_IMAGE" ]] && ! valid_image "$FRONTEND_IMAGE"; then
    log "Not using the frontend image \"$FRONTEND_IMAGE\": it isn't an image name; using the standard Volto image"
    FRONTEND_NOTE="The frontend image \"$FRONTEND_IMAGE\" isn't an image name, so the site uses the standard Volto image."
    FRONTEND_IMAGE=""
  fi
  BACKEND_NOTE=""
  if [[ -n "$BACKEND_IMAGE" ]] && ! valid_image "$BACKEND_IMAGE"; then
    log "Not using the backend image \"$BACKEND_IMAGE\": it isn't an image name; using the official Plone backend"
    BACKEND_NOTE="The backend image \"$BACKEND_IMAGE\" isn't an image name, so the site uses the official Plone backend."
    BACKEND_IMAGE=""
  fi
  umask 077
  cat > "$APP_DIR/.env" <<EOF
PLONE_VERSION=${PLONE_VERSION}
VOLTO_VERSION=${VOLTO_VERSION}
POSTGRES_VERSION=${POSTGRES_VERSION}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
ADDONS='${ADDONS}'
FRONTEND_IMAGE='${FRONTEND_IMAGE}'
BACKEND_IMAGE='${BACKEND_IMAGE}'
EOF
  umask 022
  NEW_ADMIN_PASSWORD_SET=0
else
  log "Re-using existing $APP_DIR/.env"
  ADMIN_PASSWORD=""
  ADMIN_PASSWORD_CHOSEN=0
  PASSWORD_NOTE=""
  NEW_ADMIN_PASSWORD_SET=1
  ADDONS_NOTE=""
  ADDONS=$(sed -n "s/^ADDONS='\(.*\)'\$/\1/p" "$APP_DIR/.env")
  FRONTEND_NOTE=""
  FRONTEND_IMAGE=$(sed -n "s/^FRONTEND_IMAGE='\(.*\)'\$/\1/p" "$APP_DIR/.env")
  BACKEND_NOTE=""
  BACKEND_IMAGE=$(sed -n "s/^BACKEND_IMAGE='\(.*\)'\$/\1/p" "$APP_DIR/.env")
fi
# Docker Compose prefers an exported variable over the .env file; .env is what
# the site keeps using after setup, so let Compose read it from there.
export -n ADDONS FRONTEND_IMAGE BACKEND_IMAGE

# --- Docker Compose stack ----------------------------------------------------

cat > "$APP_DIR/docker-compose.yml" <<'EOF'
name: plone

# Each container keeps at most 30 MB of logs (Docker's default keeps them all,
# which can fill a small server's disk).
x-logging: &logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  frontend:
    # FRONTEND_IMAGE in .env replaces the standard Volto image.
    image: ${FRONTEND_IMAGE:-plone/plone-frontend:${VOLTO_VERSION}}
    environment:
      RAZZLE_INTERNAL_API_PATH: http://backend:8080/Plone
      # The same, for a Plone Aurora frontend image.
      PLONE_API_PATH: http://backend:8080/Plone
    logging: *logging
    restart: unless-stopped
    ports:
      - "127.0.0.1:3000:3000"
    depends_on:
      backend:
        condition: service_healthy

  backend:
    # BACKEND_IMAGE in .env replaces the official Plone backend.
    image: ${BACKEND_IMAGE:-plone/plone-backend:${PLONE_VERSION}}
    environment:
      RELSTORAGE_DSN: "dbname='plone' user='plone' host='db' password='${POSTGRES_PASSWORD}'"
      # Add-ons are installed with pip each time the container starts, held to
      # the versions this Plone release was tested with.
      ADDONS: ${ADDONS:-}
      PIP_PARAMS: "-c /app/constraints.txt --no-cache-dir"
    # The image's own health check, but with time for installing add-ons
    # before Plone starts: failed checks only count after five minutes.
    healthcheck:
      start_period: 5m
    logging: *logging
    restart: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      # The image ships an "inituser" file containing admin:admin, and Zope
      # re-applies it on every start while there is only one Zope user, which
      # would silently reset the admin password whenever the container is
      # recreated. An empty file disables that.
      - ./inituser:/app/inituser:ro
    depends_on:
      db:
        condition: service_healthy

  db:
    image: postgres:${POSTGRES_VERSION}
    environment:
      POSTGRES_USER: plone
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: plone
    logging: *logging
    restart: unless-stopped
    volumes:
      - data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U plone -d plone"]
      interval: 5s
      timeout: 5s
      retries: 20
    # No published ports: PostgreSQL is only reachable from the other containers.

volumes:
  data: {}
EOF

: > "$APP_DIR/inituser"

# Creates the Zope "admin" user or resets its password. Before the Plone site
# exists, the root user folder is a plain Zope User Folder; creating the site
# replaces it with a PluggableAuthService (PAS), whose generic user-folder API
# doesn't list or update users reliably, so PAS is handled through its user
# manager plugin. The new password is verified before committing.
cat > "$APP_DIR/set_admin_password.py" <<'EOF'
import os
import sys
import transaction

app = globals()["app"]
uf = app.acl_users
password = os.environ["NEW_ADMIN_PASSWORD"]

if hasattr(uf, "plugins"):
    # PluggableAuthService
    managers = [
        p for p in uf.objectValues()
        if hasattr(p, "updateUserPassword") and hasattr(p, "listUserIds")
    ]
    if not managers:
        sys.exit("No user manager plugin found in the root acl_users")
    manager = managers[0]
    if "admin" in manager.listUserIds():
        manager.updateUserPassword("admin", password)
    else:
        manager.addUser("admin", "admin", password)
        for roles in uf.objectValues():
            if hasattr(roles, "assignRoleToPrincipal"):
                roles.assignRoleToPrincipal("Manager", "admin")
    ok = manager.authenticateCredentials({"login": "admin", "password": password})
else:
    # Plain Zope User Folder
    if "admin" in uf.getUserNames():
        uf._doChangeUser("admin", password, ["Manager"], [])
    else:
        uf._doAddUser("admin", password, ["Manager"], [])
    ok = uf.authenticate("admin", password, None) is not None

if not ok:
    transaction.abort()
    sys.exit("The new admin password could not be verified; nothing was changed")
transaction.commit()
print("Zope admin user is set up")
EOF

# Activates the add-ons a frontend image needs and enables its behaviors on the
# Plone Site type, so its settings (logo, colours, footer) appear on the site.
cat > "$APP_DIR/activate_frontend_addons.py" <<'EOF'
import os
import sys
import transaction
from AccessControl.SecurityManagement import newSecurityManager
from plone.base.utils import get_installer
from zope.component.hooks import setSite

app = globals()["app"]
site = app["Plone"]
setSite(site)
admin = app.acl_users.getUser("admin") or site.acl_users.getUser("admin")
newSecurityManager(None, admin.__of__(app.acl_users))

installer = get_installer(site)
for name in os.environ.get("SITE_ADDONS", "").split():
    if not installer.is_product_installed(name):
        if not installer.install_product(name):
            transaction.abort()
            sys.exit(f"Couldn't activate {name}")
    print(f"Activated {name}")

fti = site.portal_types["Plone Site"]
behaviors = list(fti.behaviors)
for name in os.environ.get("SITE_BEHAVIORS", "").split():
    if name not in behaviors:
        behaviors.append(name)
fti.behaviors = tuple(behaviors)
transaction.commit()
print("Frontend add-ons are set up")
EOF

# Writes the email settings into Site Setup > Mail. Run once by setup.
cat > "$APP_DIR/configure_mail.py" <<'EOF'
import os
import transaction
from plone.registry.interfaces import IRegistry
from zope.component import getUtility
from zope.component.hooks import setSite

app = globals()["app"]
setSite(app["Plone"])
registry = getUtility(IRegistry)
registry["plone.smtp_host"] = os.environ["SMTP_HOST"]
registry["plone.smtp_port"] = int(os.environ["SMTP_PORT"])
registry["plone.smtp_userid"] = os.environ.get("SMTP_USER") or None
registry["plone.smtp_pass"] = os.environ.get("SMTP_PASSWORD") or None
registry["plone.email_from_address"] = os.environ["EMAIL_FROM"]
# A new site's title is its default front page heading, so not that.
if not registry.get("plone.email_from_name"):
    registry["plone.email_from_name"] = "Plone"
transaction.commit()
print("MAIL_CONFIGURED")
EOF

# Creates the demo login (DEMO_USER) with the roles DEMO_ROLES (separated by
# commas), or resets its password and adds the roles if it exists. Roles the
# site doesn't have, such as an add-on's that wasn't installed, are skipped,
# and Manager is never given. The new password is verified before
# committing. The last line says which roles it got.
cat > "$APP_DIR/create_demo_user.py" <<'EOF'
import os
import sys
import transaction
from AccessControl.SecurityManagement import newSecurityManager
from plone import api
from zope.component.hooks import setSite

app = globals()["app"]
site = app["Plone"]
setSite(site)
admin = app.acl_users.getUser("admin") or site.acl_users.getUser("admin")
newSecurityManager(None, admin.__of__(app.acl_users))

name = os.environ["DEMO_USER"]
password = os.environ["DEMO_PASSWORD"]
roles = []
for role in (r.strip() for r in os.environ["DEMO_ROLES"].split(",")):
    if not role or role in roles or role == "Member":
        continue
    if role in ("Manager", "Owner", "Authenticated", "Anonymous"):
        print(f"The demo login can't have the role {role}; skipped")
    elif role not in site.validRoles():
        print(f"This site has no role {role}; skipped")
    else:
        roles.append(role)
if api.user.get(username=name) is None:
    api.user.create(
        username=name,
        email=f"{name}@example.invalid",
        password=password,
        roles=["Member"] + roles,
        properties={"fullname": "Demo"},
    )
else:
    site.acl_users.userSetPassword(name, password)
    api.user.grant_roles(username=name, roles=["Member"] + roles)
if site.acl_users.authenticate(name, password, None) is None:
    transaction.abort()
    sys.exit(f"The demo login {name} could not be verified; nothing was changed")
transaction.commit()
print(f"Demo login {name} is set up")
print("DEMO_ROLES_GIVEN=" + ", ".join(roles or ["Member"]))
EOF

# Command for resetting the admin password later: sudo plone-reset-admin-password
cat > /usr/local/bin/plone-reset-admin-password <<'EOF'
#!/bin/bash
# Reset the password of the Plone (Zope) "admin" user.
# Usage: sudo plone-reset-admin-password
#        (asks for the new password; press Enter to have one generated)
set -euo pipefail
if [[ $EUID -ne 0 ]]; then
  echo "Please run this with sudo: sudo plone-reset-admin-password" >&2
  exit 1
fi
if [[ ! -t 0 ]]; then
  echo "This command asks for the new password, so it needs a terminal." >&2
  echo "Over SSH, add -t:  ssh -t root@<server> plone-reset-admin-password" >&2
  exit 1
fi
read -rsp "New admin password (at least 12 characters, or press Enter to generate one): " NEW_PASSWORD
echo
if [[ -z "$NEW_PASSWORD" ]]; then
  NEW_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=')
  GENERATED=1
else
  if (( ${#NEW_PASSWORD} < 12 )); then
    echo "That password is shorter than 12 characters; nothing was changed." >&2
    exit 1
  fi
  read -rsp "Type it again: " AGAIN
  echo
  if [[ "$NEW_PASSWORD" != "$AGAIN" ]]; then
    echo "The passwords don't match; nothing was changed." >&2
    exit 1
  fi
  GENERATED=0
fi
if ! OUTPUT=$(NEW_ADMIN_PASSWORD="$NEW_PASSWORD" docker compose --project-directory /opt/plone \
    run --rm --no-deps -e NEW_ADMIN_PASSWORD \
    -v /opt/plone/set_admin_password.py:/app/scripts/set_admin_password.py:ro \
    backend run /app/scripts/set_admin_password.py 2>&1) \
  || ! grep -q "Zope admin user is set up" <<<"$OUTPUT"; then
  echo "Changing the password failed; nothing was changed. Last lines of output:" >&2
  tail -5 <<<"$OUTPUT" >&2
  exit 1
fi
if [[ "$GENERATED" == 1 ]]; then
  echo "The admin password is now: $NEW_PASSWORD"
  echo "Store it in a password manager."
else
  echo "The admin password has been changed."
fi
EOF
chmod 755 /usr/local/bin/plone-reset-admin-password

# >>> update tools
# From here to "<<< update tools", src/add-updates.sh installs the same files on
# servers set up before 2.12. Only APP_DIR may be used here.
# Posts a notice to the notification URL, if one was set: JSON for Slack,
# Google Chat, Mattermost and Discord webhooks, an Adaptive Card for Microsoft
# Teams workflows, plain text with a title for anything else (such as ntfy).
# Exit 0: sent; 1: failed; 3: no URL set.
install -d -m 755 /usr/local/lib/plone-in-a-box
cat > /usr/local/lib/plone-in-a-box/notify <<'EOF'
#!/bin/bash
# Usage: notify <title> <message>
set -uo pipefail
url=$(cat /var/lib/plone-in-a-box/notify-url 2>/dev/null) || exit 3
[[ -n "$url" ]] || exit 3
title=$1 message=$2
# json <key> <value> [flags]: a JSON object; Discord's flags 4 turns off link previews.
json() { python3 -c 'import json, sys; d = {sys.argv[1]: sys.argv[2]}; d.update({"flags": int(sys.argv[3])} if len(sys.argv) > 3 else {}); print(json.dumps(d))' "$@"; }
# Teams workflows ("Send webhook alerts to a channel") take
# an Adaptive Card: the title in bold, then a text block per line.
card() {
  python3 - "$1" "$2" <<'PY'
import json, sys
title, message = sys.argv[1:3]
body = [{"type": "TextBlock", "text": title, "weight": "Bolder", "size": "Medium", "wrap": True}]
gap = True
for line in message.split("\n"):
    if not line.strip():
        gap = True
        continue
    body.append({"type": "TextBlock", "text": line, "wrap": True, "spacing": "Medium" if gap else "None"})
    gap = False
print(json.dumps({"type": "message", "attachments": [{
    "contentType": "application/vnd.microsoft.card.adaptive", "contentUrl": None,
    "content": {"$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard", "version": "1.4", "msteams": {"width": "Full"}, "body": body}}]}))
PY
}
case "$url" in
  https://*.logic.azure.com[:/]*|https://*.powerplatform.com[:/]*|https://*.webhook.office.com[:/]*)
    body=$(card "$title" "$message") type=application/json ;;
  https://discord.com/api/webhooks/*|https://discordapp.com/api/webhooks/*)
    body=$(json content "**${title}**"$'\n'"${message:0:1800}" 4) type=application/json ;;
  https://hooks.slack.com/*|https://chat.googleapis.com/*)
    body=$(json text "*${title}*"$'\n'"${message}") type=application/json ;;
  https://*/hooks/*)  # Mattermost
    body=$(json text "**${title}**"$'\n'"${message}") type=application/json ;;
  *)
    body=$message type="text/plain; charset=utf-8" ;;
esac
curl -fsS -m 30 --retry 3 -o /dev/null -X POST -H "Content-Type: ${type}" -H "Title: ${title}" \
  --data-binary "$body" "$url"
EOF
chmod 755 /usr/local/lib/plone-in-a-box/notify

# Problems a person should hear about: posted to the notification URL and
# emailed (to the address for reports, else the site's From address) with the
# site's mail settings, whichever are set up. Exit 0: at least one got it.
cat > /usr/local/lib/plone-in-a-box/alert <<'EOF'
#!/bin/bash
# Usage: alert <title> <message>
set -uo pipefail
APP_DIR=/opt/plone
sent=1
/usr/local/lib/plone-in-a-box/notify "$1" "$2" </dev/null >/dev/null 2>&1 && sent=0
if [[ -f "$APP_DIR/send_mail.py" ]]; then
